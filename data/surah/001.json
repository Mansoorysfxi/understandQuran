{"id":1,"verses":[{"key":"1:1","n":1,"uthmani":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","indopak":"بِسۡمِ اللهِ الرَّحۡمٰنِ الرَّحِيۡمِ","words":[{"uthmani":"بِسْمِ","indopak":"بِسۡمِ","ur":"ساتھ نام","en":"In (the) name"},{"uthmani":"ٱللَّهِ","indopak":"اللهِ","ur":"اللہ کے","en":"(of) Allah"},{"uthmani":"ٱلرَّحْمَـٰنِ","indopak":"الرَّحۡمٰنِ","ur":"جو بے حد مہربان ہے","en":"the Most Gracious"},{"uthmani":"ٱلرَّحِيمِ","indopak":"الرَّحِيۡمِ","ur":"بار بار رحم فرمانے والا ہے","en":"the Most Merciful"}],"tr":{"20":"In the name of Allāh, the Entirely Merciful, the Especially Merciful.","97":"اللہ کےنام سے جو رحمان و رحیم ہے","234":"شروع الله کا نام لے کر جو بڑا مہربان نہایت رحم والا ہے"}},{"key":"1:2","n":2,"uthmani":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","indopak":"اَلۡحَمۡدُ لِلّٰهِ رَبِّ الۡعٰلَمِيۡنَۙ‏","words":[{"uthmani":"ٱلْحَمْدُ","indopak":"اَلۡحَمۡدُ","ur":"سب تعریف","en":"All praises and thanks"},{"uthmani":"لِلَّهِ","indopak":"لِلّٰهِ","ur":"اللہ کے لیے ہے","en":"(be) to Allah"},{"uthmani":"رَبِّ","indopak":"رَبِّ","ur":"جو رب ہے","en":"the Lord"},{"uthmani":"ٱلْعَـٰلَمِينَ","indopak":"الۡعٰلَمِيۡنَۙ‏","ur":"تمام جہانوں کا","en":"of the universe"}],"tr":{"20":"[All] praise is [due] to Allāh, Lord of the worlds -","97":"تعریف اللہ ہی کے لیے ہے  جو تمام کائنات کا رب  ہے","234":"سب طرح کی تعریف خدا ہی کو (سزاوار) ہے جو تمام مخلوقات کا پروردگار ہے"}},{"key":"1:3","n":3,"uthmani":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","indopak":"الرَّحۡمٰنِ الرَّحِيۡمِۙ‏","words":[{"uthmani":"ٱلرَّحْمَـٰنِ","indopak":"الرَّحۡمٰنِ","ur":"جو بہت مہربان","en":"The Most Gracious"},{"uthmani":"ٱلرَّحِيمِ","indopak":"الرَّحِيۡمِۙ‏","ur":"بار بار رحم فرمانے والا ہے","en":"the Most Merciful"}],"tr":{"20":"The Entirely Merciful, the Especially Merciful,","97":"رحمان اور رحیم ہے","234":"بڑا مہربان نہایت رحم والا"}},{"key":"1:4","n":4,"uthmani":"مَـٰلِكِ يَوْمِ ٱلدِّينِ","indopak":"مٰلِكِ يَوۡمِ الدِّيۡنِؕ‏","words":[{"uthmani":"مَـٰلِكِ","indopak":"مٰلِكِ","ur":"مالک ہے","en":"(The) Master"},{"uthmani":"يَوْمِ","indopak":"يَوۡمِ","ur":"دن کا","en":"(of the) Day"},{"uthmani":"ٱلدِّينِ","indopak":"الدِّيۡنِؕ‏","ur":"بدلے کے","en":"(of the) Judgment"}],"tr":{"20":"Sovereign of the Day of Recompense.","97":"روزِ جزا کا مالک ہے","234":"انصاف کے دن کا حاکم"}},{"key":"1:5","n":5,"uthmani":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","indopak":"اِيَّاكَ نَعۡبُدُ وَاِيَّاكَ نَسۡتَعِيۡنُؕ‏","words":[{"uthmani":"إِيَّاكَ","indopak":"اِيَّاكَ","ur":"صرف تیری","en":"You Alone"},{"uthmani":"نَعْبُدُ","indopak":"نَعۡبُدُ","ur":"ہم عبادت کرتے ہیں","en":"we worship"},{"uthmani":"وَإِيَّاكَ","indopak":"وَاِيَّاكَ","ur":"اور صرف تجھ سے","en":"and You Alone"},{"uthmani":"نَسْتَعِينُ","indopak":"نَسۡتَعِيۡنُؕ‏","ur":"ہم مدد چاہتے ہیں","en":"we ask for help"}],"tr":{"20":"It is You we worship and You we ask for help.","97":"ہم تیری ہی عبادت کرتے ہیں اور تجھی سے مدد مانگتے ہیں","234":"(اے پروردگار) ہم تیری ہی عبادت کرتے ہیں اور تجھ ہی سے مدد مانگتے ہیں"}},{"key":"1:6","n":6,"uthmani":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","indopak":"اِهۡدِنَا الصِّرَاطَ الۡمُسۡتَقِيۡمَۙ‏","words":[{"uthmani":"ٱهْدِنَا","indopak":"اِهۡدِنَا","ur":"دکھا ہم کو","en":"Guide us"},{"uthmani":"ٱلصِّرَٰطَ","indopak":"الصِّرَاطَ","ur":"راستہ","en":"(to) the path"},{"uthmani":"ٱلْمُسْتَقِيمَ","indopak":"الۡمُسۡتَقِيۡمَۙ‏","ur":"سیدھا","en":"the straight"}],"tr":{"20":"Guide us to the straight path -","97":"ہمیں سیدھا راستہ دکھا","234":"ہم کو سیدھے رستے چلا"}},{"key":"1:7","n":7,"uthmani":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","indopak":"صِرَاطَ الَّذِيۡنَ اَنۡعَمۡتَ عَلَيۡهِمۡ ۙ‏ غَيۡرِ الۡمَغۡضُوۡبِ عَلَيۡهِمۡ وَلَا الضَّآلِّيۡنَ‏","words":[{"uthmani":"صِرَٰطَ","indopak":"صِرَاطَ","ur":"راستہ","en":"(The) path"},{"uthmani":"ٱلَّذِينَ","indopak":"الَّذِيۡنَ","ur":"ان لوگوں کا","en":"(of) those"},{"uthmani":"أَنْعَمْتَ","indopak":"اَنۡعَمۡتَ","ur":"انعام کیا تو نے","en":"You have bestowed (Your) Favors"},{"uthmani":"عَلَيْهِمْ","indopak":"عَلَيۡهِمۡ ۙ‏","ur":"اوپر ان کے","en":"on them"},{"uthmani":"غَيْرِ","indopak":"غَيۡرِ","ur":"نہ ان (لوگوں) کا","en":"not (of)"},{"uthmani":"ٱلْمَغْضُوبِ","indopak":"الۡمَغۡضُوۡبِ","ur":"غضب کیا گیا","en":"those who earned (Your) wrath"},{"uthmani":"عَلَيْهِمْ","indopak":"عَلَيۡهِمۡ","ur":"اوپر ان کے","en":"on themselves"},{"uthmani":"وَلَا","indopak":"وَلَا","ur":"اور نہ","en":"and not"},{"uthmani":"ٱلضَّآلِّينَ","indopak":"الضَّآلِّيۡنَ‏","ur":"ان (لوگوں) کا جو گمراہ ہیں / گم کردہ راہ ہیں","en":"(of) those who go astray"}],"tr":{"20":"The path of those upon whom You have bestowed favor, not of those who have earned [Your] anger or of those who are astray.","97":"ان لوگوں کاراستہ جن پر تو نے انعام فرمایا  ، جو معتوب نہیں ہوئے، جو بھٹکے ہوئے نہیں ہیں","234":"ان لوگوں کے رستے جن پر تو اپنا فضل وکرم کرتا رہا نہ ان کے جن پر غصے ہوتا رہا اور نہ گمراہوں کے"}}]}