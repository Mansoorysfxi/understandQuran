وْجَيْنِ","indopak":"الزَّوۡجَيۡنِ","ur":"دو قسمیں","en":"two kinds"},{"uthmani":"ٱلذَّكَرَ","indopak":"الذَّكَرَ","ur":"مرد","en":"(the) male"},{"uthmani":"وَٱلْأُنثَىٰٓ","indopak":"وَالۡاُنۡثٰىؕ‏","ur":"اورعورت","en":"and the female"}],"tr":{"20":"And made of him two mates, the male and the female.","97":"پھر اس سے مرد اور عورت کی دو قسمیں بنائیں","234":"پھر اس کی دو قسمیں بنائیں (ایک) مرد اور (ایک) عورت"}},{"key":"75:40","n":40,"uthmani":"أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ","indopak":"اَلَيۡسَ ذٰلِكَ بِقٰدِرٍ عَلٰٓى اَنۡ يُّحۡـىِۦَ الۡمَوۡتٰى‏","words":[{"uthmani":"أَلَيْسَ","indopak":"اَلَيۡسَ","ur":"کیا نہیں","en":"Is not"},{"uthmani":"ذَٰلِكَ","indopak":"ذٰلِكَ","ur":"ہے","en":"[that]"},{"uthmani":"بِقَـٰدِرٍ","indopak":"بِقٰدِرٍ","ur":"وہ  قادر","en":"(He) Able"},{"uthmani":"عَلَىٰٓ","indopak":"عَلٰٓى","ur":"اس بات پر","en":"[over]"},{"uthmani":"أَن","indopak":"اَنۡ","ur":"کہ","en":"to"},{"uthmani":"يُحْـِۧىَ","indopak":"يُّحۡـىِۦَ","ur":"وہ زندہ کردے","en":"give life"},{"uthmani":"ٱلْمَوْتَىٰ","indopak":"الۡمَوۡتٰى‏","ur":"مردوں کو","en":"(to) the dead"}],"tr":{"20":"Is not that [Creator] Able to give life to the dead?","97":"کیا وہ اِس پر قادر نہیں ہے کہ مرنے والوں کو پھر سے زندہ کردے؟","234":"کیا اس خالق کو اس بات پر قدرت نہیں کہ مردوں کو جلا اُٹھائے؟"}}]}