{"id":75,"verses":[{"key":"75:1","n":1,"uthmani":" لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ","indopak":"لَاۤ اُقۡسِمُ بِيَوۡمِ الۡقِيٰمَةِۙ‏","words":[{"uthmani":"لَآ","indopak":"لَاۤ","ur":"نہیں","en":"Nay"},{"uthmani":"أُقْسِمُ","indopak":"اُقۡسِمُ","ur":"میں قسم کھاتا ہوں","en":"I swear"},{"uthmani":"بِيَوْمِ","indopak":"بِيَوۡمِ","ur":"دن کی","en":"by (the) Day"},{"uthmani":"ٱلْقِيَـٰمَةِ","indopak":"الۡقِيٰمَةِۙ‏","ur":"قیامت کے","en":"(of) the Resurrection"}],"tr":{"20":"I swear by the Day of Resurrection","97":"نہیں،  میں قسم کھاتا ہوں قیامت کے دن کی","234":"ہم کو روز قیامت کی قسم"}},{"key":"75:2","n":2,"uthmani":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","indopak":"وَلَاۤ اُقۡسِمُ بِالنَّفۡسِ اللَّوَّامَةِؕ‏","words":[{"uthmani":"وَلَآ","indopak":"وَلَاۤ","ur":"اور نہیں","en":"And nay"},{"uthmani":"أُقْسِمُ","indopak":"اُقۡسِمُ","ur":"میں قسم کھاتا ہوں","en":"I swear"},{"uthmani":"بِٱلنَّفْسِ","indopak":"بِالنَّفۡسِ","ur":"نفس کی","en":"by the soul"},{"uthmani":"ٱللَّوَّامَةِ","indopak":"اللَّوَّامَةِؕ‏","ur":"جو ملامت کرنے والا ہے","en":"self-accusing"}],"tr":{"20":"And I swear by the reproaching soul [to the certainty of resurrection].","97":"اور نہیں ، میں قسم کھاتا ہوں ملامت کرنے والے نفس کی،","234":"اور نفس لوامہ کی (کہ سب لوگ اٹھا کر) کھڑے کئے جائیں گے"}},{"key":"75:3","n":3,"uthmani":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","indopak":"اَيَحۡسَبُ الۡاِنۡسَانُ اَلَّنۡ نَّجۡمَعَ عِظَامَهٗؕ‏","words":[{"uthmani":"أَيَحْسَبُ","indopak":"اَيَحۡسَبُ","ur":"کیا سمجھتا ہے","en":"Does think"},{"uthmani":"ٱلْإِنسَـٰنُ","indopak":"الۡاِنۡسَانُ","ur":"انسان","en":"[the] man"},{"uthmani":"أَلَّن","indopak":"اَلَّنۡ","ur":"کہ ہرگز نہیں","en":"that not"},{"uthmani":"نَّجْمَعَ","indopak":"نَّجۡمَعَ","ur":"ہم جمع کریں گے","en":"We will assemble"},{"uthmani":"عِظَامَهُۥ","indopak":"عِظَامَهٗؕ‏","ur":"اس کی ہڈیوں کو","en":"his bones"}],"tr":{"20":"Does man think that We will not assemble his bones?","97":"کیا انسان یہ سمجھ رہا ہے کہ ہم اُس کی ہڈیوں کو جمع نہ کر سکیں گے؟","234":"کیا انسان یہ خیال کرتا ہے کہ ہم اس کی (بکھری ہوئی) ہڈیاں اکٹھی نہیں کریں گے؟"}},{"key":"75:4","n":4,"uthmani":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","indopak":"بَلٰى قٰدِرِيۡنَ عَلٰٓى اَنۡ نُّسَوِّىَ بَنَانَهٗ‏","words":[{"uthmani":"بَلَىٰ","indopak":"بَلٰى","ur":"کیوں نہیں","en":"Nay"},{"uthmani":"قَـٰدِرِينَ","indopak":"قٰدِرِيۡنَ","ur":"قادر ہیں","en":"(We are) Able"},{"uthmani":"عَلَىٰٓ","indopak":"عَلٰٓى","ur":"اس بات پر","en":"on"},{"uthmani":"أَن","indopak":"اَنۡ","ur":"کہ","en":"that"},{"uthmani":"نُّسَوِّىَ","indopak":"نُّسَوِّىَ","ur":"ہم درست کردیں","en":"We can restore"},{"uthmani":"بَنَانَهُۥ","indopak":"بَنَانَهٗ‏","ur":"اس کے پور پور کو","en":"his fingertips"}],"tr":{"20":"Yes. [We are] Able [even] to proportion his fingertips.","97":"کیوں نہیں؟ ہم تو اس کی انگلیوں کی پور پور تک ٹھیک بنادینے پر قادر ہیں۔","234":"ضرور کریں گے (اور) ہم اس بات پر قادر ہیں کہ اس کی پور پور درست کردیں"}},{"key":"75:5","n":5,"uthmani":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ","indopak":"بَلۡ يُرِيۡدُ الۡاِنۡسَانُ لِيَفۡجُرَ اَمَامَهٗ​ۚ‏","words":[{"uthmani":"بَلْ","indopak":"بَلۡ","ur":"بلکہ","en":"Nay"},{"uthmani":"يُرِيدُ","indopak":"يُرِيۡدُ","ur":"چاہتا ہے","en":"Desires"},{"uthmani":"ٱلْإِنسَـٰنُ","indopak":"الۡاِنۡسَانُ","ur":"انسان","en":"[the] man"},{"uthmani":"لِيَفْجُرَ","indopak":"لِيَفۡجُرَ","ur":"کہ گناہ کرتا ہے","en":"to give (the) lie"},{"uthmani":"أَمَامَهُۥ","indopak":"اَمَامَهٗ​ۚ‏","ur":"اپنے آگے","en":"(to) what is before him"}],"tr":{"20":"But man desires to continue in sin.","97":"مگر انسان چاہتا یہ ہے کہ آگے بھی بداعمالیاں کرتا رہے۔","234":"مگر انسان چاہتا ہے کہ آگے کو خود سری کرتا جائے"}},{"key":"75:6","n":6,"uthmani":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ","indopak":"يَسۡـَٔـلُ اَيَّانَ يَوۡمُ الۡقِيٰمَةِؕ‏","words":[{"uthmani":"يَسْـَٔلُ","indopak":"يَسۡـَٔـلُ","ur":"پوچھتا ہے وہ","en":"He asks"},{"uthmani":"أَيَّانَ","indopak":"اَيَّانَ","ur":"کب ہے","en":"When"},{"uthmani":"يَوْمُ","indopak":"يَوۡمُ","ur":"دن","en":"(is the) Day"},{"uthmani":"ٱلْقِيَـٰمَةِ","indopak":"الۡقِيٰمَةِؕ‏","ur":"قیامت کے","en":"(of) the Resurrection"}],"tr":{"20":"He asks, \"When is the Day of Resurrection?\"","97":"پوچھتا ہے”آخر کب آنا ہے وہ قیامت کا دن؟“","234":"پوچھتا ہے کہ قیامت کا دن کب ہوگا؟"}},{"key":"75:7","n":7,"uthmani":"فَإِذَا بَرِقَ ٱلْبَصَرُ","indopak":"فَاِذَا بَرِقَ الۡبَصَرُۙ‏","words":[{"uthmani":"فَإِذَا","indopak":"فَاِذَا","ur":"پھر جب","en":"So when"},{"uthmani":"بَرِقَ","indopak":"بَرِقَ","ur":"چندھیا جائیں گی","en":"is dazzled"},{"uthmani":"ٱلْبَصَرُ","indopak":"الۡبَصَرُۙ‏","ur":"نگاہیں۔ آنکھیں","en":"the vision"}],"tr":{"20":"So when vision is dazzled.","97":"پھر جب دِیدے پتھرا جائیں گے","234":"جب آنکھیں چندھیا جائیں"}},{"key":"75:8","n":8,"uthmani":"وَخَسَفَ ٱلْقَمَرُ","indopak":"وَخَسَفَ الۡقَمَرُۙ‏","words":[{"uthmani":"وَخَسَفَ","indopak":"وَخَسَفَ","ur":"اور بےنور ہوجائے گا","en":"And becomes dark"},{"uthmani":"ٱلْقَمَرُ","indopak":"الۡقَمَرُۙ‏","ur":"چاند","en":"the moon"}],"tr":{"20":"And the moon darkens.","97":"اور چاند بے نور ہو جائیگا","234":"اور چاند گہنا جائے"}},{"key":"75:9","n":9,"uthmani":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","indopak":"وَجُمِعَ الشَّمۡسُ وَالۡقَمَرُۙ‏","words":[{"uthmani":"وَجُمِعَ","indopak":"وَجُمِعَ","ur":"اور جمع کردئیے جائیں گے","en":"And are joined"},{"uthmani":"ٱلشَّمْسُ","indopak":"الشَّمۡسُ","ur":"سورج","en":"the sun"},{"uthmani":"وَٱلْقَمَرُ","indopak":"وَالۡقَمَرُۙ‏","ur":"اور چاند","en":"and the moon"}],"tr":{"20":"And the sun and the moon are joined,","97":"اور چاند سُورج ملا کر ایک کر دیے جائیں گے","234":"اور سورج اور چاند جمع کردیئے جائیں"}},{"key":"75:10","n":10,"uthmani":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","indopak":"يَقُوۡلُ الۡاِنۡسَانُ يَوۡمَٮِٕذٍ اَيۡنَ الۡمَفَرُّ​ ۚ‏","words":[{"uthmani":"يَقُولُ","indopak":"يَقُوۡلُ","ur":"کہے","en":"Will say"},{"uthmani":"ٱلْإِنسَـٰنُ","indopak":"الۡاِنۡسَانُ","ur":"انسان","en":"[the] man"},{"uthmani":"يَوْمَئِذٍ","indopak":"يَوۡمَٮِٕذٍ","ur":"اس دن","en":"that Day"},{"uthmani":"أَيْنَ","indopak":"اَيۡنَ","ur":"کہاں ہے","en":"Where"},{"uthmani":"ٱلْمَفَرُّ","indopak":"الۡمَفَرُّ​ ۚ‏","ur":"فرار کی جگہ","en":"(is) the escape"}],"tr":{"20":"Man will say on that Day, \"Where is the [place of] escape?\"","97":"اُس وقت یہی انسان کہے گا \"کہاں بھاگ کر جاؤں؟\"","234":"اس دن انسان کہے گا کہ (اب) کہاں بھاگ جاؤں؟"}},{"key":"75:11","n":11,"uthmani":"كَلَّا لَا وَزَرَ","indopak":"كَلَّا لَا وَزَرَؕ‏","words":[{"uthmani":"كَلَّا","indopak":"كَلَّا","ur":"ہرگز","en":"By no means"},{"uthmani":"لَا","indopak":"لَا","ur":"نہیں","en":"(There is) no"},{"uthmani":"وَزَرَ","indopak":"وَزَرَؕ‏","ur":"کوئی پناہ کی جگہ نہیں","en":"refuge"}],"tr":{"20":"No! There is no refuge.","97":"ہرگز نہیں، وہاں کوئی جائے پناہ نہ ہوگی","234":"بےشک کہیں پناہ نہیں"}},{"key":"75:12","n":12,"uthmani":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","indopak":"اِلٰى رَبِّكَ يَوۡمَٮِٕذِ اۨلۡمُسۡتَقَرُّ ؕ‏","words":[{"uthmani":"إِلَىٰ","indopak":"اِلٰى","ur":"طرف","en":"To"},{"uthmani":"رَبِّكَ","indopak":"رَبِّكَ","ur":"تیرے رب کی","en":"your Lord"},{"uthmani":"يَوْمَئِذٍ","indopak":"يَوۡمَٮِٕذِ","ur":"اس دن","en":"that Day"},{"uthmani":"ٱلْمُسْتَقَرُّ","indopak":"اۨلۡمُسۡتَقَرُّ ؕ‏","ur":"ٹھہرنا ہے","en":"(is) the place of rest"}],"tr":{"20":"To your Lord, that Day, is the [place of] permanence.","97":"اُس روز تیرے رب ہی کے سامنے جا کر ٹھیرنا ہوگا","234":"اس روز پروردگار ہی کے پاس ٹھکانا ہے"}},{"key":"75:13","n":13,"uthmani":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","indopak":"يُنَبَّؤُا الۡاِنۡسَانُ يَوۡمَٮِٕذٍۢ بِمَا قَدَّمَ وَاَخَّرَؕ‏","words":[{"uthmani":"يُنَبَّؤُا۟","indopak":"يُنَبَّؤُا","ur":"آگاہ کردیاجائے","en":"Will be informed"},{"uthmani":"ٱلْإِنسَـٰنُ","indopak":"الۡاِنۡسَانُ","ur":"انسان","en":"[the] man"},{"uthmani":"يَوْمَئِذٍۭ","indopak":"يَوۡمَٮِٕذٍۢ","ur":"اس دن","en":"that Day"},{"uthmani":"بِمَا","indopak":"بِمَا","ur":"ساتھ اس کے جو","en":"of what"},{"uthmani":"قَدَّمَ","indopak":"قَدَّمَ","ur":"اس نے آگے بھیجا","en":"he sent forth"},{"uthmani":"وَأَخَّرَ","indopak":"وَاَخَّرَؕ‏","ur":"اور پیچھے چھوڑا","en":"and kept back"}],"tr":{"20":"Man will be informed that Day of what he sent ahead and kept back.","97":"اُس روز انسان کو اس کا سب اگلا پچھلا کیا کرایا بتا دیا جائے گا۔","234":"اس دن انسان کو جو (عمل) اس نے آگے بھیجے اور پیچھے چھوڑے ہوں گے سب بتا دیئے جائیں گے"}},{"key":"75:14","n":14,"uthmani":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ","indopak":"بَلِ الۡاِنۡسَانُ عَلٰى نَفۡسِهٖ بَصِيۡرَةٌ ۙ‏","words":[{"uthmani":"بَلِ","indopak":"بَلِ","ur":"بلکہ","en":"Nay"},{"uthmani":"ٱلْإِنسَـٰنُ","indopak":"الۡاِنۡسَانُ","ur":"انسان","en":"[The] man"},{"uthmani":"عَلَىٰ","indopak":"عَلٰى","ur":"پر","en":"against"},{"uthmani":"نَفْسِهِۦ","indopak":"نَفۡسِهٖ","ur":"اپنی ذات","en":"himself"},{"uthmani":"بَصِيرَةٌۭ","indopak":"بَصِيۡرَةٌ ۙ‏","ur":"دیکھنے والا ہے۔ آگاہ ہے","en":"(will be) a witness"}],"tr":{"20":"Rather, man, against himself, will be a witness,","97":"بلکہ انسان خود ہی اپنے آپ کو خوب جانتا ہے","234":"بلکہ انسان آپ اپنا گواہ ہے"}},{"key":"75:15","n":15,"uthmani":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","indopak":"وَّلَوۡ اَلۡقٰى مَعَاذِيۡرَهٗؕ‏","words":[{"uthmani":"وَلَوْ","indopak":"وَّلَوۡ","ur":"اور اگرچہ","en":"Even if"},{"uthmani":"أَلْقَىٰ","indopak":"اَلۡقٰى","ur":"ڈالے","en":"he presents"},{"uthmani":"مَعَاذِيرَهُۥ","indopak":"مَعَاذِيۡرَهٗؕ‏","ur":"اپنی معذرتیں","en":"his excuses"}],"tr":{"20":"Even if he presents his excuses.","97":"چاہے وہ کتنی ہی معذرتیں پیش کرے","234":"اگرچہ عذر ومعذرت کرتا رہے"}},{"key":"75:16","n":16,"uthmani":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","indopak":"لَا تُحَرِّكۡ بِهٖ لِسَانَكَ لِتَعۡجَلَ بِهٖؕ‏","words":[{"uthmani":"لَا","indopak":"لَا","ur":"نہ","en":"Not"},{"uthmani":"تُحَرِّكْ","indopak":"تُحَرِّكۡ","ur":"آپ حرکت دیجئے","en":"move"},{"uthmani":"بِهِۦ","indopak":"بِهٖ","ur":"ساتھ اس کے","en":"with it"},{"uthmani":"لِسَانَكَ","indopak":"لِسَانَكَ","ur":"اپنی زبان کو","en":"your tongue"},{"uthmani":"لِتَعْجَلَ","indopak":"لِتَعۡجَلَ","ur":"تاکہ آپ جلدی کریں","en":"to hasten"},{"uthmani":"بِهِۦٓ","indopak":"بِهٖؕ‏","ur":"ساتھ اس کے","en":"with it"}],"tr":{"20":"Move not your tongue with it, [O Muḥammad], to hasten with it [i.e., recitation of the Qur’ān].","97":"اے نبیؐ ، اِس وحی کو جلدی جلدی یاد کرنے کے لیے اپنی زبان کو حرکت نہ دو","234":"اور (اے محمدﷺ) وحی کے پڑھنے کے لئے اپنی زبان نہ چلایا کرو کہ اس کو جلد یاد کرلو"}},{"key":"75:17","n":17,"uthmani":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","indopak":"اِنَّ عَلَيۡنَا جَمۡعَهٗ وَقُرۡاٰنَهٗۚ  ۖ‏","words":[{"uthmani":"إِنَّ","indopak":"اِنَّ","ur":"بیشک","en":"Indeed"},{"uthmani":"عَلَيْنَا","indopak":"عَلَيۡنَا","ur":"ہم پر","en":"upon Us"},{"uthmani":"جَمْعَهُۥ","indopak":"جَمۡعَهٗ","ur":"اس کا جمع کرنا ہے","en":"(is) its collection"},{"uthmani":"وَقُرْءَانَهُۥ","indopak":"وَقُرۡاٰنَهٗۚ  ۖ‏","ur":"اور اس کا پڑھوانا ہے","en":"and its recitation"}],"tr":{"20":"Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation.","97":"اِس کو یاد کرا دینا اور پڑھوا دینا ہمارے ذمہ ہے","234":"اس کا جمع کرنا اور پڑھانا ہمارے ذمے ہے"}},{"key":"75:18","n":18,"uthmani":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","indopak":"فَاِذَا قَرَاۡنٰهُ فَاتَّبِعۡ قُرۡاٰنَهٗ​ۚ‏","words":[{"uthmani":"فَإِذَا","indopak":"فَاِذَا","ur":"پھر جب","en":"And when"},{"uthmani":"قَرَأْنَـٰهُ","indopak":"قَرَاۡنٰهُ","ur":"پڑھیں ہم اس کو","en":"We have recited it"},{"uthmani":"فَٱتَّبِعْ","indopak":"فَاتَّبِعۡ","ur":"تو پیروی کریں","en":"then follow"},{"uthmani":"قُرْءَانَهُۥ","indopak":"قُرۡاٰنَهٗ​ۚ‏","ur":"آپ کے پڑھنے کی","en":"its recitation"}],"tr":{"20":"So when We have recited it [through Gabriel], then follow its recitation.","97":"لہٰذا جب ہم اِسے پڑھ رہے ہوں  اُس وقت تم اِس کی قراٴت کو غور سے سُنتے رہو","234":"جب ہم وحی پڑھا کریں تو تم (اس کو سنا کرو اور) پھر اسی طرح پڑھا کرو"}},{"key":"75:19","n":19,"uthmani":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","indopak":"ثُمَّ اِنَّ عَلَيۡنَا بَيَانَهٗؕ‏","words":[{"uthmani":"ثُمَّ","indopak":"ثُمَّ","ur":"پھر","en":"Then"},{"uthmani":"إِنَّ","indopak":"اِنَّ","ur":"بیشک","en":"indeed"},{"uthmani":"عَلَيْنَا","indopak":"عَلَيۡنَا","ur":"ہمارے ذمہ ہے","en":"upon Us"},{"uthmani":"بَيَانَهُۥ","indopak":"بَيَانَهٗؕ‏","ur":"اس کو بیان کرنا","en":"(is) its explanation"}],"tr":{"20":"Then upon Us is its clarification [to you].","97":"پھر اس کا مطلب سمجھا دینا بھی ہمارے ہی ذمّہ ہے","234":"پھر اس (کے معانی) کا بیان بھی ہمارے ذمے ہے"}},{"key":"75:20","n":20,"uthmani":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","indopak":"كَلَّا بَلۡ تُحِبُّوۡنَ الۡعَاجِلَةَ ۙ‏","words":[{"uthmani":"كَلَّا","indopak":"كَلَّا","ur":"ہرگز نہیں","en":"No"},{"uthmani":"بَلْ","indopak":"بَلۡ","ur":"بلکہ","en":"But"},{"uthmani":"تُحِبُّونَ","indopak":"تُحِبُّوۡنَ","ur":"تم پسند کرتے ہو","en":"you love"},{"uthmani":"ٱلْعَاجِلَةَ","indopak":"الۡعَاجِلَةَ ۙ‏","ur":"جلدی ملنے والی چیز کو","en":"the immediate"}],"tr":{"20":"No! But you [i.e., mankind] love the immediate","97":"ہر گز نہیں، اصل بات  یہ ہے کہ تم لوگ جلدی حاصل ہونے والی چیز (یعنی دنیا)سے محبت رکھتے ہو","234":"مگر (لوگو) تم دنیا کو دوست رکھتے ہو"}},{"key":"75:21","n":21,"uthmani":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ","indopak":"وَتَذَرُوۡنَ الۡاٰخِرَةَ ؕ‏","words":[{"uthmani":"وَتَذَرُونَ","indopak":"وَتَذَرُوۡنَ","ur":"اور تم چھوڑ دیتے ہو","en":"And leave"},{"uthmani":"ٱلْـَٔاخِرَةَ","indopak":"الۡاٰخِرَةَ ؕ‏","ur":"بعد میں ملنے والی کو۔ آخری کو۔ بعد میں آنے والی کو","en":"the Hereafter"}],"tr":{"20":"And leave [i.e., neglect] the Hereafter.","97":"اور آخرت کو چھوڑ دیتے ہو۔","234":"اور آخرت کو ترک کئے دیتے ہو"}},{"key":"75:22","n":22,"uthmani":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","indopak":"وُجُوۡهٌ يَّوۡمَٮِٕذٍ نَّاضِرَةٌ ۙ‏","words":[{"uthmani":"وُجُوهٌۭ","indopak":"وُجُوۡهٌ","ur":"کچھ چہرے","en":"Faces"},{"uthmani":"يَوْمَئِذٍۢ","indopak":"يَّوۡمَٮِٕذٍ","ur":"اس روز","en":"that Day"},{"uthmani":"نَّاضِرَةٌ","indopak":"نَّاضِرَةٌ ۙ‏","ur":"تروتازہ ہوں گے","en":"(will be) radiant"}],"tr":{"20":"[Some] faces, that Day, will be radiant,","97":"اُس روز کچھ چہرے ترو تازہ ہونگے،","234":"اس روز بہت سے منہ رونق دار ہوں گے"}},{"key":"75:23","n":23,"uthmani":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","indopak":"اِلٰى رَبِّهَا نَاظِرَةٌ​ ۚ‏","words":[{"uthmani":"إِلَىٰ","indopak":"اِلٰى","ur":"طرف","en":"Towards"},{"uthmani":"رَبِّهَا","indopak":"رَبِّهَا","ur":"اپنے رب کی","en":"their Lord"},{"uthmani":"نَاظِرَةٌۭ","indopak":"نَاظِرَةٌ​ ۚ‏","ur":"دیکھنے والے ہوں گے","en":"looking"}],"tr":{"20":"Looking at their Lord.","97":"اپنے ربّ کی طرف دیکھ رہے ہوں گے۔","234":"اور) اپنے پروردگار کے محو دیدار ہوں گے"}},{"key":"75:24","n":24,"uthmani":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ","indopak":"وَوُجُوۡهٌ يَّوۡمَٮِٕذٍۢ بَاسِرَةٌ ۙ‏","words":[{"uthmani":"وَوُجُوهٌۭ","indopak":"وَوُجُوۡهٌ","ur":"اور کچھ چہرے","en":"And faces"},{"uthmani":"يَوْمَئِذٍۭ","indopak":"يَّوۡمَٮِٕذٍۢ","ur":"اس روز","en":"that Day"},{"uthmani":"بَاسِرَةٌۭ","indopak":"بَاسِرَةٌ ۙ‏","ur":"بےرونق ہوں گے","en":"(will be) distorted"}],"tr":{"20":"And [some] faces, that Day, will be contorted,","97":"اور کچھ چہرے اداس ہوں گے","234":"اور بہت سے منہ اس دن اداس ہوں گے"}},{"key":"75:25","n":25,"uthmani":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","indopak":"تَظُنُّ اَنۡ يُّفۡعَلَ بِهَا فَاقِرَةٌ ؕ‏","words":[{"uthmani":"تَظُنُّ","indopak":"تَظُنُّ","ur":"سمجھ رہے ہوں گے","en":"Thinking"},{"uthmani":"أَن","indopak":"اَنۡ","ur":"کہ","en":"that"},{"uthmani":"يُفْعَلَ","indopak":"يُّفۡعَلَ","ur":"کیا جائے گا","en":"will be done"},{"uthmani":"بِهَا","indopak":"بِهَا","ur":"ساتھ ان کے","en":"to them"},{"uthmani":"فَاقِرَةٌۭ","indopak":"فَاقِرَةٌ ؕ‏","ur":"کمر توڑ برتاؤ","en":"backbreaking"}],"tr":{"20":"Expecting that there will be done to them [something] backbreaking.","97":"اور سمجھ رہے ہوں گے کہ اُن کے ساتھ کمر توڑ برتاؤ ہونے والا ہے","234":"خیال کریں گے کہ ان پر مصیبت واقع ہونے کو ہے"}},{"key":"75:26","n":26,"uthmani":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","indopak":"كَلَّاۤ اِذَا بَلَغَتِ التَّرَاقِىَۙ‏","words":[{"uthmani":"كَلَّآ","indopak":"كَلَّاۤ","ur":"ہرگز نہیں","en":"No"},{"uthmani":"إِذَا","indopak":"اِذَا","ur":"جب","en":"When"},{"uthmani":"بَلَغَتِ","indopak":"بَلَغَتِ","ur":"پہنچ جائے گی","en":"it reaches"},{"uthmani":"ٱلتَّرَاقِىَ","indopak":"التَّرَاقِىَۙ‏","ur":"حلق کو","en":"the collar bones"}],"tr":{"20":"No! When it [i.e., the soul] has reached the collar bones","97":"ہر گز نہیں،  جب جان حلق تک پہنچ جائے گی","234":"دیکھو جب جان گلے تک پہنچ جائے"}},{"key":"75:27","n":27,"uthmani":"وَقِيلَ مَنْ ۜ رَاقٍ","indopak":"وَقِيۡلَ مَنۡ رَاقٍۙ‏","words":[{"uthmani":"وَقِيلَ","indopak":"وَقِيۡلَ","ur":"اور کہہ دیاجائے گا","en":"And it is said"},{"uthmani":"مَنْ ۜ","indopak":"مَنۡ","ur":"کون ہے","en":"Who"},{"uthmani":"رَاقٍۢ","indopak":"رَاقٍۙ‏","ur":"جھاڑ پھونک کرنے والا","en":"(will) cure"}],"tr":{"20":"And it is said, \"Who will cure [him]?\"","97":"اور کہا جائے گا کہ ہے کوئی جھاڑ پھُونک کر نے والا،","234":"اور لوگ کہنے لگیں (اس وقت) کون جھاڑ پھونک کرنے والا ہے"}},{"key":"75:28","n":28,"uthmani":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","indopak":"وَّظَنَّ اَنَّهُ الۡفِرَاقُۙ‏","words":[{"uthmani":"وَظَنَّ","indopak":"وَّظَنَّ","ur":"اور وہ سمجھ لے گا","en":"And he is certain"},{"uthmani":"أَنَّهُ","indopak":"اَنَّهُ","ur":"کہ بیشک وہ","en":"that it"},{"uthmani":"ٱلْفِرَاقُ","indopak":"الۡفِرَاقُۙ‏","ur":"جدائی کا وقت ہے","en":"(is) the parting"}],"tr":{"20":"And he [i.e., the dying one] is certain that it is the [time of] separation","97":"اور آدمی سمجھ لے گا کہ یہ دنیا سے جدائی کا وقت ہے","234":"اور اس (جان بلب) نے سمجھا کہ اب سب سے جدائی ہے"}},{"key":"75:29","n":29,"uthmani":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","indopak":"وَالۡتَفَّتِ السَّاقُ بِالسَّاقِۙ‏","words":[{"uthmani":"وَٱلْتَفَّتِ","indopak":"وَالۡتَفَّتِ","ur":"اور جڑ جائے گی۔ لپٹ جائے گی","en":"And is wound"},{"uthmani":"ٱلسَّاقُ","indopak":"السَّاقُ","ur":"پنڈلی","en":"the leg"},{"uthmani":"بِٱلسَّاقِ","indopak":"بِالسَّاقِۙ‏","ur":"پنڈلی کے ساتھ","en":"about the leg"}],"tr":{"20":"And the leg is wound about the leg,","97":"اور پنڈلی سے پنڈلی جُڑ جائے گی،","234":"اور پنڈلی سے پنڈلی لپٹ جائے"}},{"key":"75:30","n":30,"uthmani":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","indopak":"اِلٰى رَبِّكَ يَوۡمَٮِٕذِ اۨلۡمَسَاقُؕ‏","words":[{"uthmani":"إِلَىٰ","indopak":"اِلٰى","ur":"طرف","en":"To"},{"uthmani":"رَبِّكَ","indopak":"رَبِّكَ","ur":"تیرے رب کی","en":"your Lord"},{"uthmani":"يَوْمَئِذٍ","indopak":"يَوۡمَٮِٕذِ","ur":"اس روز","en":"that Day"},{"uthmani":"ٱلْمَسَاقُ","indopak":"اۨلۡمَسَاقُؕ‏","ur":"روانگی ہے","en":"(will be) the driving"}],"tr":{"20":"To your Lord, that Day, will be the procession.","97":"وہ دن ہوگا تیرے رب کی طرف روانگی کا","234":"اس دن تجھ کو اپنے پروردگار کی طرف چلنا ہے"}},{"key":"75:31","n":31,"uthmani":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","indopak":"فَلَا صَدَّقَ وَلَا صَلّٰىۙ‏","words":[{"uthmani":"فَلَا","indopak":"فَلَا","ur":"پس نہیں","en":"And not"},{"uthmani":"صَدَّقَ","indopak":"صَدَّقَ","ur":"اس نے تصدیق کی","en":"he accepted (the) truth"},{"uthmani":"وَلَا","indopak":"وَلَا","ur":"اور نہ","en":"and not"},{"uthmani":"صَلَّىٰ","indopak":"صَلّٰىۙ‏","ur":"نماز پڑھی","en":"he prayed"}],"tr":{"20":"And he [i.e., the disbeliever] had not believed, nor had he prayed.","97":"مگر اُس نے نہ سچ مانا، اور نہ نماز پڑھی","234":"تو اس (ناعاقبت) اندیش نے نہ تو (کلام خدا) کی تصدیق کی نہ نماز پڑھی"}},{"key":"75:32","n":32,"uthmani":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ","indopak":"وَلٰڪِنۡ كَذَّبَ وَتَوَلّٰىۙ‏","words":[{"uthmani":"وَلَـٰكِن","indopak":"وَلٰڪِنۡ","ur":"لیکن","en":"But"},{"uthmani":"كَذَّبَ","indopak":"كَذَّبَ","ur":"اس نے جھٹلایا","en":"he denied"},{"uthmani":"وَتَوَلَّىٰ","indopak":"وَتَوَلّٰىۙ‏","ur":"اور منہ موڑ لیا","en":"and turned away"}],"tr":{"20":"But [instead], he denied and turned away.","97":"بلکہ جھٹلایا اور پلٹ گیا","234":"بلکہ جھٹلایا اور منہ پھیر لیا"}},{"key":"75:33","n":33,"uthmani":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","indopak":"ثُمَّ ذَهَبَ اِلٰٓى اَهۡلِهٖ يَتَمَطّٰىؕ‏","words":[{"uthmani":"ثُمَّ","indopak":"ثُمَّ","ur":"پھر","en":"Then"},{"uthmani":"ذَهَبَ","indopak":"ذَهَبَ","ur":"چلا گیا","en":"he went"},{"uthmani":"إِلَىٰٓ","indopak":"اِلٰٓى","ur":"طرف","en":"to"},{"uthmani":"أَهْلِهِۦ","indopak":"اَهۡلِهٖ","ur":"اپنے گھروالوں کی","en":"his family"},{"uthmani":"يَتَمَطَّىٰٓ","indopak":"يَتَمَطّٰىؕ‏","ur":"اکڑتا ہوا۔ اتراتا ہوا","en":"swaggering"}],"tr":{"20":"And then he went to his people, swaggering [in pride].","97":"پھر اکڑتا ہوا اپنے گھر والوں کی طرف چل دیا۔","234":"پھر اپنے گھر والوں کے پاس اکڑتا ہوا چل دیا"}},{"key":"75:34","n":34,"uthmani":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","indopak":"اَوۡلٰى لَكَ فَاَوۡلٰىۙ‏","words":[{"uthmani":"أَوْلَىٰ","indopak":"اَوۡلٰى","ur":"افسوس","en":"Woe"},{"uthmani":"لَكَ","indopak":"لَكَ","ur":"تجھ پر","en":"to you"},{"uthmani":"فَأَوْلَىٰ","indopak":"فَاَوۡلٰىۙ‏","ur":"پھر افسوس","en":"and woe"}],"tr":{"20":"Woe to you, and woe!","97":"یہ روش تیرے ہی لیے سزاوار ہے اور تجھی کو زیب دیتی ہے","234":"افسوس ہے تجھ پر پھر افسوس ہے"}},{"key":"75:35","n":35,"uthmani":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","indopak":"ثُمَّ اَوۡلٰى لَكَ فَاَوۡلٰىؕ‏","words":[{"uthmani":"ثُمَّ","indopak":"ثُمَّ","ur":"پھر","en":"Then"},{"uthmani":"أَوْلَىٰ","indopak":"اَوۡلٰى","ur":"افسوس","en":"woe"},{"uthmani":"لَكَ","indopak":"لَكَ","ur":"تجھ پر،","en":"to you"},{"uthmani":"فَأَوْلَىٰٓ","indopak":"فَاَوۡلٰىؕ‏","ur":"پھر افسوس","en":"and woe"}],"tr":{"20":"Then woe to you, and woe!","97":"ہاں یہ روش تیرے ہی لیے سزاوار ہے اور تجھی کو زیب دیتی ہے۔","234":"پھر افسوس ہے تجھ پر پھر افسوس ہے"}},{"key":"75:36","n":36,"uthmani":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى","indopak":"اَيَحۡسَبُ الۡاِنۡسَانُ اَنۡ يُّتۡرَكَ سُدًىؕ‏","words":[{"uthmani":"أَيَحْسَبُ","indopak":"اَيَحۡسَبُ","ur":"کیا سمجھتا ہے","en":"Does think"},{"uthmani":"ٱلْإِنسَـٰنُ","indopak":"الۡاِنۡسَانُ","ur":"انسان","en":"man"},{"uthmani":"أَن","indopak":"اَنۡ","ur":"کہ","en":"that"},{"uthmani":"يُتْرَكَ","indopak":"يُّتۡرَكَ","ur":"چھوڑ دیا جائے گا","en":"he will be left"},{"uthmani":"سُدًى","indopak":"سُدًىؕ‏","ur":"بےکار","en":"neglected"}],"tr":{"20":"Does man think that he will be left neglected?","97":"کیا انسان نے یہ