{"id":80,"verses":[{"key":"80:1","n":1,"uthmani":" عَبَسَ وَتَوَلَّىٰٓ","indopak":"عَبَسَ وَتَوَلّٰٓىۙ‏","words":[{"uthmani":"عَبَسَ","indopak":"عَبَسَ","ur":"ترش رو ہوا","en":"He frowned"},{"uthmani":"وَتَوَلَّىٰٓ","indopak":"وَتَوَلّٰٓىۙ‏","ur":"اور منہ موڑا","en":"and turned away"}],"tr":{"20":"He [i.e., the Prophet (ﷺ) ] frowned and turned away","97":"ترش رو ہوا، اور بے رخی برتی","234":"(محمد مصطفٰےﷺ) ترش رُو ہوئے اور منہ پھیر بیٹھے"}},{"key":"80:2","n":2,"uthmani":"أَن جَآءَهُ ٱلْأَعْمَىٰ","indopak":"اَنۡ جَآءَهُ الۡاَعۡمٰىؕ‏","words":[{"uthmani":"أَن","indopak":"اَنۡ","ur":"کہ","en":"Because"},{"uthmani":"جَآءَهُ","indopak":"جَآءَهُ","ur":"آیا اس کے پاس","en":"came to him"},{"uthmani":"ٱلْأَعْمَىٰ","indopak":"الۡاَعۡمٰىؕ‏","ur":"اندھا","en":"the blind man"}],"tr":{"20":"Because there came to him the blind man, [interrupting].","97":"اِس با ت پر کہ وہ اندھا اُس کے پاس آگیا۔","234":"کہ ان کے پاس ایک نابینا آیا"}},{"key":"80:3","n":3,"uthmani":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","indopak":"وَمَا يُدۡرِيۡكَ لَعَلَّهٗ يَزَّكّٰٓىۙ‏","words":[{"uthmani":"وَمَا","indopak":"وَمَا","ur":"اور کیا چیز","en":"But what"},{"uthmani":"يُدْرِيكَ","indopak":"يُدۡرِيۡكَ","ur":"بتائے تجھ کو","en":"would make you know"},{"uthmani":"لَعَلَّهُۥ","indopak":"لَعَلَّهٗ","ur":"شاید کہ وہ","en":"that he might"},{"uthmani":"يَزَّكَّىٰٓ","indopak":"يَزَّكّٰٓىۙ‏","ur":"وہ سدھر جائے/ تزکیہ پائے","en":"purify himself"}],"tr":{"20":"But what would make you perceive, [O Muḥammad], that perhaps he might be purified","97":"تمہیں کیا خبر، شاید وہ سدھر جائے","234":"اور تم کو کیا خبر شاید وہ پاکیزگی حاصل کرتا"}},{"key":"80:4","n":4,"uthmani":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","indopak":"اَوۡ يَذَّكَّرُ فَتَنۡفَعَهُ الذِّكۡرٰىؕ‏","words":[{"uthmani":"أَوْ","indopak":"اَوۡ","ur":"یا","en":"Or"},{"uthmani":"يَذَّكَّرُ","indopak":"يَذَّكَّرُ","ur":"نصیحت پکڑے","en":"be reminded"},{"uthmani":"فَتَنفَعَهُ","indopak":"فَتَنۡفَعَهُ","ur":"تو فائدہ دے اس کو","en":"so would benefit him"},{"uthmani":"ٱلذِّكْرَىٰٓ","indopak":"الذِّكۡرٰىؕ‏","ur":"نصیحت","en":"the reminder"}],"tr":{"20":"Or be reminded and the remembrance would benefit him?","97":"یا نصیحت پر دھیان دے، اور نصیحت کرنا اس کے لیے نافع ہو؟","234":"یا سوچتا تو سمجھانا اسے فائدہ دیتا"}},{"key":"80:5","n":5,"uthmani":"أَمَّا مَنِ ٱسْتَغْنَىٰ","indopak":"اَمَّا مَنِ اسۡتَغۡنٰىۙ‏","words":[{"uthmani":"أَمَّا","indopak":"اَمَّا","ur":"رہا","en":"As for"},{"uthmani":"مَنِ","indopak":"مَنِ","ur":"وہ جو","en":"(him) who"},{"uthmani":"ٱسْتَغْنَىٰ","indopak":"اسۡتَغۡنٰىۙ‏","ur":"بےپروائی کرتا ہے","en":"considers himself free from need"}],"tr":{"20":"As for he who thinks himself without need,","97":"جو شخص بے پروائی برتتا ہے","234":"جو پروا نہیں کرتا"}},{"key":"80:6","n":6,"uthmani":"فَأَنتَ لَهُۥ تَصَدَّىٰ","indopak":"فَاَنۡتَ لَهٗ تَصَدّٰىؕ‏","words":[{"uthmani":"فَأَنتَ","indopak":"فَاَنۡتَ","ur":"تو آپ","en":"So you"},{"uthmani":"لَهُۥ","indopak":"لَهٗ","ur":"اس کی طرف","en":"to him"},{"uthmani":"تَصَدَّىٰ","indopak":"تَصَدّٰىؕ‏","ur":"مائل ہوتے ہیں/ فکر کرتے ہیں","en":"give attention"}],"tr":{"20":"To him you give attention.","97":"اس کی طرف تو تم توجہ کرتے ہو","234":"اس کی طرف تو تم توجہ کرتے ہو"}},{"key":"80:7","n":7,"uthmani":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","indopak":"وَمَا عَلَيۡكَ اَلَّا يَزَّكّٰٓىؕ‏","words":[{"uthmani":"وَمَا","indopak":"وَمَا","ur":"اور نہیں","en":"And not"},{"uthmani":"عَلَيْكَ","indopak":"عَلَيۡكَ","ur":"آپ پر ذمہ داری","en":"upon you"},{"uthmani":"أَلَّا","indopak":"اَلَّا","ur":"کہ نہ","en":"that not"},{"uthmani":"يَزَّكَّىٰ","indopak":"يَزَّكّٰٓىؕ‏","ur":"وہ پاکیزگی اختیار  کرے/  سدھرے","en":"he purifies himself"}],"tr":{"20":"And not upon you [is any blame] if he will not be purified.","97":"حالانکہ اگر وہ نہ سدھرے تو تم پر اس کی کیا ذمہ داری ہے؟","234":"حالانکہ اگر وہ نہ سنورے تو تم پر کچھ (الزام) نہیں"}},{"key":"80:8","n":8,"uthmani":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","indopak":"وَاَمَّا مَنۡ جَآءَكَ يَسۡعٰىۙ‏","words":[{"uthmani":"وَأَمَّا","indopak":"وَاَمَّا","ur":"اور رہا","en":"But as for"},{"uthmani":"مَن","indopak":"مَنۡ","ur":"جو","en":"(he) who"},{"uthmani":"جَآءَكَ","indopak":"جَآءَكَ","ur":"آتا ہے آپ کے پاس","en":"came to you"},{"uthmani":"يَسْعَىٰ","indopak":"يَسۡعٰىۙ‏","ur":"دوڑتا ہوا","en":"striving"}],"tr":{"20":"But as for he who came to you striving [for knowledge]","97":"اور جو خود تمہارے پاس دوڑا آتا ہے","234":"اور جو تمہارے پاس دوڑتا ہوا آیا"}},{"key":"80:9","n":9,"uthmani":"وَهُوَ يَخْشَىٰ","indopak":"وَهُوَ يَخۡشٰىۙ‏","words":[{"uthmani":"وَهُوَ","indopak":"وَهُوَ","ur":"اور وہ","en":"While he"},{"uthmani":"يَخْشَىٰ","indopak":"يَخۡشٰىۙ‏","ur":"ڈرتا بھی ہے","en":"fears"}],"tr":{"20":"While he fears [Allāh],","97":"اور وہ ڈر رہا ہوتا ہے","234":"اور (خدا سے) ڈرتا ہے"}},{"key":"80:10","n":10,"uthmani":"فَأَنتَ عَنْهُ تَلَهَّىٰ","indopak":"فَاَنۡتَ عَنۡهُ تَلَهّٰى​ۚ‏","words":[{"uthmani":"فَأَنتَ","indopak":"فَاَنۡتَ","ur":"تو آپ","en":"But you"},{"uthmani":"عَنْهُ","indopak":"عَنۡهُ","ur":"اس سے","en":"from him"},{"uthmani":"تَلَهَّىٰ","indopak":"تَلَهّٰى​ۚ‏","ur":"بےرخی برتتے ہیں","en":"(are) distracted"}],"tr":{"20":"From him you are distracted.","97":"اس سے تم بے رُخی برتتے ہو۔","234":"اس سے تم بےرخی کرتے ہو"}},{"key":"80:11","n":11,"uthmani":"كَلَّآ إِنَّهَا تَذْكِرَةٌ","indopak":"كَلَّاۤ اِنَّهَا تَذۡكِرَةٌ ۚ‏","words":[{"uthmani":"كَلَّآ","indopak":"كَلَّاۤ","ur":"ہرگز نہیں","en":"Nay"},{"uthmani":"إِنَّهَا","indopak":"اِنَّهَا","ur":"بیشک وہ","en":"Indeed, it"},{"uthmani":"تَذْكِرَةٌۭ","indopak":"تَذۡكِرَةٌ ۚ‏","ur":"ایک نصیحت ہے","en":"(is) a reminder"}],"tr":{"20":"No! Indeed, they [i.e., these verses] are a reminder;","97":"ہر گز نہیں،  یہ تو ایک نصیحت ہے،","234":"دیکھو یہ (قرآن) نصیحت ہے"}},{"key":"80:12","n":12,"uthmani":"فَمَن شَآءَ ذَكَرَهُۥ","indopak":"فَمَنۡ شَآءَ ذَكَرَهٗ​ۘ‏","words":[{"uthmani":"فَمَن","indopak":"فَمَنۡ","ur":"تو جو","en":"So whosoever"},{"uthmani":"شَآءَ","indopak":"شَآءَ","ur":"کوئی چاہے","en":"wills"},{"uthmani":"ذَكَرَهُۥ","indopak":"ذَكَرَهٗ​ۘ‏","ur":"یاد کرے اس کو","en":"may remember it"}],"tr":{"20":"So whoever wills may remember it.","97":"جس کا جی چاہے اِسے قبول کرے","234":"پس جو چاہے اسے یاد رکھے"}},{"key":"80:13","n":13,"uthmani":"فِى صُحُفٍ مُّكَرَّمَةٍ","indopak":"فِىۡ صُحُفٍ مُّكَرَّمَةٍۙ‏","words":[{"uthmani":"فِى","indopak":"فِىۡ","ur":"میں","en":"In"},{"uthmani":"صُحُفٍۢ","indopak":"صُحُفٍ","ur":"صحیفوں","en":"sheets"},{"uthmani":"مُّكَرَّمَةٍۢ","indopak":"مُّكَرَّمَةٍۙ‏","ur":"جو عزت دیئے گئے ہیں/ مکرم ہیں/ محترم ہیں","en":"honored"}],"tr":{"20":"[It is recorded] in honored sheets,","97":"یہ ایسے صحیفوں میں درج ہے جو مکرم ہیں","234":"قابل ادب ورقوں میں (لکھا ہوا)"}},{"key":"80:14","n":14,"uthmani":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ","indopak":"مَّرۡفُوۡعَةٍ مُّطَهَّرَةٍ ۭۙ‏","words":[{"uthmani":"مَّرْفُوعَةٍۢ","indopak":"مَّرۡفُوۡعَةٍ","ur":"بلند ہیں","en":"Exalted"},{"uthmani":"مُّطَهَّرَةٍۭ","indopak":"مُّطَهَّرَةٍ ۭۙ‏","ur":"پاکیزہ ہیں","en":"purified"}],"tr":{"20":"Exalted and purified,","97":"بلند مرتبہ ہیں، پاکیزہ ہیں،","234":"جو بلند مقام پر رکھے ہوئے (اور) پاک ہیں"}},{"key":"80:15","n":15,"uthmani":"بِأَيْدِى سَفَرَةٍ","indopak":"بِاَيۡدِىۡ سَفَرَةٍۙ‏","words":[{"uthmani":"بِأَيْدِى","indopak":"بِاَيۡدِىۡ","ur":"ہاتھوں میں ہیں","en":"In (the) hands"},{"uthmani":"سَفَرَةٍۢ","indopak":"سَفَرَةٍۙ‏","ur":"لکھنے والوں کے","en":"(of) scribes"}],"tr":{"20":"[Carried] by the hands of messenger-angels,","97":"معزّز اور نیک کاتبوں  کے","234":"لکھنے والوں کے ہاتھوں میں"}},{"key":"80:16","n":16,"uthmani":"كِرَامٍۭ بَرَرَةٍ","indopak":"كِرَامٍۢ بَرَرَةٍؕ‏","words":[{"uthmani":"كِرَامٍۭ","indopak":"كِرَامٍۢ","ur":"معزز ہیں","en":"Noble"},{"uthmani":"بَرَرَةٍۢ","indopak":"بَرَرَةٍؕ‏","ur":"جو نیک ہیں","en":"dutiful"}],"tr":{"20":"Noble and dutiful.","97":"ہاتھوں میں رہتے ہیں۔","234":"جو سردار اور نیکو کار ہیں"}},{"key":"80:17","n":17,"uthmani":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","indopak":"قُتِلَ الۡاِنۡسَانُ مَاۤ اَكۡفَرَهٗؕ‏","words":[{"uthmani":"قُتِلَ","indopak":"قُتِلَ","ur":"مارا جائے","en":"Is destroyed"},{"uthmani":"ٱلْإِنسَـٰنُ","indopak":"الۡاِنۡسَانُ","ur":"انسان","en":"[the] man"},{"uthmani":"مَآ","indopak":"مَاۤ","ur":"کیا","en":"how"},{"uthmani":"أَكْفَرَهُۥ","indopak":"اَكۡفَرَهٗؕ‏","ur":"سخت منکر ہے","en":"ungrateful is he"}],"tr":{"20":"Destroyed [i.e., cursed] is man; how disbelieving is he.","97":"لعنت ہو  انسان پر،  کیسا سخت مُنکرِ حق ہے یہ۔","234":"انسان ہلاک ہو جائے کیسا ناشکرا ہے"}},{"key":"80:18","n":18,"uthmani":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","indopak":"مِنۡ اَىِّ شَىۡءٍ خَلَقَهٗؕ‏","words":[{"uthmani":"مِنْ","indopak":"مِنۡ","ur":"سے","en":"From"},{"uthmani":"أَىِّ","indopak":"اَىِّ","ur":"کس","en":"what"},{"uthmani":"شَىْءٍ","indopak":"شَىۡءٍ","ur":"چیز","en":"thing"},{"uthmani":"خَلَقَهُۥ","indopak":"خَلَقَهٗؕ‏","ur":"اس نے پیدا کیا اس کو","en":"He created him"}],"tr":{"20":"From what thing [i.e., substance] did He create him?","97":"کس چیز سے اللہ نے اِسے پیدا کیا ہے؟","234":"اُسے (خدا نے) کس چیز سے بنایا؟"}},{"key":"80:19","n":19,"uthmani":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","indopak":"مِنۡ نُّطۡفَةٍؕ خَلَقَهٗ فَقَدَّرَهٗ ۙ‏","words":[{"uthmani":"مِن","indopak":"مِنۡ","ur":"سے","en":"From"},{"uthmani":"نُّطْفَةٍ","indopak":"نُّطۡفَةٍؕ","ur":"ایک نطفے (سے)","en":"a semen-drop"},{"uthmani":"خَلَقَهُۥ","indopak":"خَلَقَهٗ","ur":"اس نے پیدا کیا اس کو","en":"He created him"},{"uthmani":"فَقَدَّرَهُۥ","indopak":"فَقَدَّرَهٗ ۙ‏","ur":"پھر تقدیر مقرر کی اس کی","en":"then He proportioned him"}],"tr":{"20":"From a sperm-drop He created him and destined for him;","97":"نُطفہ کی ایک بُوند سے۔  اللہ نے اِسے پیدا کیا، پھر اِس کی تقدیر مقرر کی،","234":"نطفے سے بنایا پھر اس کا اندازہ مقرر کیا"}},{"key":"80:20","n":20,"uthmani":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","indopak":"ثُمَّ السَّبِيۡلَ يَسَّرَهٗۙ‏","words":[{"uthmani":"ثُمَّ","indopak":"ثُمَّ","ur":"پھر","en":"Then"},{"uthmani":"ٱلسَّبِيلَ","indopak":"السَّبِيۡلَ","ur":"راستہ","en":"the way"},{"uthmani":"يَسَّرَهُۥ","indopak":"يَسَّرَهٗۙ‏","ur":"اس نے آسان کیا اس کا","en":"He made easy for him"}],"tr":{"20":"Then He eased the way for him;","97":"پھر اِس کے لیے زندگی کی راہ آسان کی،","234":"پھر اس کے لیے رستہ آسان کر دیا"}},{"key":"80:21","n":21,"uthmani":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","indopak":"ثُمَّ اَمَاتَهٗ فَاَقۡبَرَهٗۙ‏","words":[{"uthmani":"ثُمَّ","indopak":"ثُمَّ","ur":"پھر","en":"Then"},{"uthmani":"أَمَاتَهُۥ","indopak":"اَمَاتَهٗ","ur":"موت دی اس کو","en":"He causes him to die"},{"uthmani":"فَأَقْبَرَهُۥ","indopak":"فَاَقۡبَرَهٗۙ‏","ur":"پھر قبر دی اس کو","en":"and provides a grave for him"}],"tr":{"20":"Then He causes his death and provides a grave for him.","97":"پھر اِسے موت دی اور قبر میں پہنچایا۔","234":"پھر اس کو موت دی پھر قبر میں دفن کرایا"}},{"key":"80:22","n":22,"uthmani":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","indopak":"ثُمَّ اِذَا شَآءَ اَنۡشَرَهٗؕ‏","words":[{"uthmani":"ثُمَّ","indopak":"ثُمَّ","ur":"پھر","en":"Then"},{"uthmani":"إِذَا","indopak":"اِذَا","ur":"جب","en":"when"},{"uthmani":"شَآءَ","indopak":"شَآءَ","ur":"وہ چاہے گا","en":"He wills"},{"uthmani":"أَنشَرَهُۥ","indopak":"اَنۡشَرَهٗؕ‏","ur":"اٹھا کھڑا کرے گا اس کو","en":"He will resurrect him"}],"tr":{"20":"Then when He wills, He will resurrect him.","97":"پھر جب چاہے وہ اِسے دوبارہ اُٹھا کھڑا کرے۔","234":"پھر جب چاہے گا اسے اٹھا کھڑا کرے گا"}},{"key":"80:23","n":23,"uthmani":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","indopak":"كَلَّا لَـمَّا يَقۡضِ مَاۤ اَمَرَهٗؕ‏","words":[{"uthmani":"كَلَّا","indopak":"كَلَّا","ur":"ہرگز نہیں","en":"Nay"},{"uthmani":"لَمَّا","indopak":"لَـمَّا","ur":"نہیں","en":"Not"},{"uthmani":"يَقْضِ","indopak":"يَقۡضِ","ur":"پورا کیا","en":"he has accomplished"},{"uthmani":"مَآ","indopak":"مَاۤ","ur":"جو","en":"what"},{"uthmani":"أَمَرَهُۥ","indopak":"اَمَرَهٗؕ‏","ur":"اس نے حکم دیا اس کو","en":"He commanded him"}],"tr":{"20":"No! He [i.e., man] has not yet accomplished what He commanded him.","97":"ہر گز نہیں، اِس نے وہ فرض ادا نہیں کیا جس کا اللہ نے اِسے حکم دیا تھا۔","234":"کچھ شک نہیں کہ خدا نے اسے جو حکم دیا اس نے اس پر عمل نہ کیا"}},{"key":"80:24","n":24,"uthmani":"فَلْ