{"id":81,"verses":[{"key":"81:1","n":1,"uthmani":" إِذَا ٱلشَّمْسُ كُوِّرَتْ","indopak":"اِذَا الشَّمۡسُ كُوِّرَتۡۙ‏","words":[{"uthmani":"إِذَا","indopak":"اِذَا","ur":"جب","en":"When"},{"uthmani":"ٱلشَّمْسُ","indopak":"الشَّمۡسُ","ur":"سورج","en":"the sun"},{"uthmani":"كُوِّرَتْ","indopak":"كُوِّرَتۡۙ‏","ur":"لپیٹ دیا جائے گا","en":"is wrapped up"}],"tr":{"20":"When the sun is wrapped up [in darkness]","97":"جب سورج لپیٹ دیا جائے گا،","234":"جب سورج لپیٹ لیا جائے گا"}},{"key":"81:2","n":2,"uthmani":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","indopak":"وَاِذَا النُّجُوۡمُ انْكَدَرَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلنُّجُومُ","indopak":"النُّجُوۡمُ","ur":"تارے","en":"the stars"},{"uthmani":"ٱنكَدَرَتْ","indopak":"انْكَدَرَتۡۙ‏","ur":"گدلے ہوجائیں گے","en":"fall, losing their luster"}],"tr":{"20":"And when the stars fall, dispersing,","97":"اور جب تارے بکھر جائیں گے،","234":"جب تارے بےنور ہو جائیں گے"}},{"key":"81:3","n":3,"uthmani":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","indopak":"وَاِذَا الۡجِبَالُ سُيِّرَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلْجِبَالُ","indopak":"الۡجِبَالُ","ur":"پہاڑ","en":"the mountains"},{"uthmani":"سُيِّرَتْ","indopak":"سُيِّرَتۡۙ‏","ur":"چلا دیئے جائیں گے","en":"are moved away"}],"tr":{"20":"And when the mountains are removed","97":"اور جب پہاڑ چلائے جائیں گے،","234":"اور جب پہاڑ چلائے جائیں گے"}},{"key":"81:4","n":4,"uthmani":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","indopak":"وَاِذَا الۡعِشَارُ عُطِّلَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلْعِشَارُ","indopak":"الۡعِشَارُ","ur":"دس مہینے کی حاملہ اونٹنیاں","en":"the full-term she-camels"},{"uthmani":"عُطِّلَتْ","indopak":"عُطِّلَتۡۙ‏","ur":"تنہا چھوڑ دی جائیں گی","en":"(are) left untended"}],"tr":{"20":"And when full-term she-camels are neglected","97":"اور جب دس مہینے کی حاملہ اُونٹنیاں اپنے حال پر چھوڑ دی جائیں گی،","234":"اور جب بیانے والی اونٹنیاں بےکار ہو جائیں گی"}},{"key":"81:5","n":5,"uthmani":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","indopak":"وَاِذَا الۡوُحُوۡشُ حُشِرَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلْوُحُوشُ","indopak":"الۡوُحُوۡشُ","ur":"وحشی جانور","en":"the wild beasts"},{"uthmani":"حُشِرَتْ","indopak":"حُشِرَتۡۙ‏","ur":"اکٹھے کردیئے جائیں گے","en":"are gathered"}],"tr":{"20":"And when the wild beasts are gathered","97":"اور جب جنگلی جانور سمیٹ کر اکٹھے کر دیے جائیں گے،","234":"اور جب وحشی جانور جمع اکٹھے ہو جائیں گے"}},{"key":"81:6","n":6,"uthmani":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","indopak":"وَاِذَا الۡبِحَارُ سُجِّرَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلْبِحَارُ","indopak":"الۡبِحَارُ","ur":"سمندر","en":"the seas"},{"uthmani":"سُجِّرَتْ","indopak":"سُجِّرَتۡۙ‏","ur":"بھڑکادیئے جائیں گے","en":"are made to overflow"}],"tr":{"20":"And when the seas are filled with flame","97":"اور جب سمندر بھڑکا دیے جائیں گے،","234":"اور جب دریا آگ ہو جائیں گے"}},{"key":"81:7","n":7,"uthmani":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","indopak":"وَاِذَا النُّفُوۡسُ زُوِّجَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلنُّفُوسُ","indopak":"النُّفُوۡسُ","ur":"جانیں","en":"the souls"},{"uthmani":"زُوِّجَتْ","indopak":"زُوِّجَتۡۙ‏","ur":"جوڑ دی جائیں گے","en":"are paired"}],"tr":{"20":"And when the souls are paired","97":"اور جب  جانیں (جسموں سے) جوڑ دی جائیں گی،","234":"اور جب روحیں (بدنوں سے) ملا دی جائیں گی"}},{"key":"81:8","n":8,"uthmani":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","indopak":"وَاِذَا الۡمَوۡءٗدَةُ سُٮِٕلَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلْمَوْءُۥدَةُ","indopak":"الۡمَوۡءٗدَةُ","ur":"زندہ گاڑی ہوئی لڑکی","en":"the female infant buried alive"},{"uthmani":"سُئِلَتْ","indopak":"سُٮِٕلَتۡۙ‏","ur":"پوچھی جائے گی","en":"is asked"}],"tr":{"20":"And when the girl [who was] buried alive is asked","97":"اور جب زندہ گاڑی ہوئی لڑکی سے پوچھا جائے گا","234":"اور جب لڑکی سے جو زندہ دفنا دی گئی ہو پوچھا جائے گا"}},{"key":"81:9","n":9,"uthmani":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","indopak":"بِاَىِّ ذَنۡۢبٍ قُتِلَتۡ​ۚ‏","words":[{"uthmani":"بِأَىِّ","indopak":"بِاَىِّ","ur":"کس","en":"For what"},{"uthmani":"ذَنۢبٍۢ","indopak":"ذَنۡۢبٍ","ur":"گناہ میں","en":"sin"},{"uthmani":"قُتِلَتْ","indopak":"قُتِلَتۡ​ۚ‏","ur":"ماری گئی","en":"she was killed"}],"tr":{"20":"For what sin she was killed","97":"کہ وہ کس قُصور میں مار ی گئی؟","234":"کہ وہ کس گناہ پرماری گئی"}},{"key":"81:10","n":10,"uthmani":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","indopak":"وَاِذَا الصُّحُفُ نُشِرَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلصُّحُفُ","indopak":"الصُّحُفُ","ur":"اعمال نامے","en":"the pages"},{"uthmani":"نُشِرَتْ","indopak":"نُشِرَتۡۙ‏","ur":"پھیلادیئے جائیں گے","en":"are laid open"}],"tr":{"20":"And when the pages are spread [i.e., made public]","97":"اور جب اعمال نامے کھولے جائیں گے","234":"اور جب (عملوں کے) دفتر کھولے جائیں گے"}},{"key":"81:11","n":11,"uthmani":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","indopak":"وَاِذَا السَّمَآءُ كُشِطَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلسَّمَآءُ","indopak":"السَّمَآءُ","ur":"آسمان","en":"the sky"},{"uthmani":"كُشِطَتْ","indopak":"كُشِطَتۡۙ‏","ur":"اس کی کھال اتار دی جائے گی","en":"is stripped away"}],"tr":{"20":"And when the sky is stripped away","97":"اور جب آسمان کا پردہ ہٹا دیا جائے گا،","234":"اور جب آسمانوں کی کھال کھینچ لی جائے گی"}},{"key":"81:12","n":12,"uthmani":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","indopak":"وَاِذَا الۡجَحِيۡمُ سُعِّرَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلْجَحِيمُ","indopak":"الۡجَحِيۡمُ","ur":"جہنم","en":"the Hellfire"},{"uthmani":"سُعِّرَتْ","indopak":"سُعِّرَتۡۙ‏","ur":"بھڑکا دی جائے گی","en":"is set ablaze"}],"tr":{"20":"And when Hellfire is set ablaze","97":"اور جب جہنم دہکائی جائے گی","234":"اور جب دوزخ (کی آگ) بھڑکائی جائے گی"}},{"key":"81:13","n":13,"uthmani":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","indopak":"وَاِذَا الۡجَـنَّةُ اُزۡلِفَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلْجَنَّةُ","indopak":"الۡجَـنَّةُ","ur":"جنت","en":"Paradise"},{"uthmani":"أُزْلِفَتْ","indopak":"اُزۡلِفَتۡۙ‏","ur":"قریب لے آئی جائے گی","en":"is brought near"}],"tr":{"20":"And when Paradise is brought near,","97":"اور جب جنّت قریب لے آئی جائے گی،","234":"اور بہشت جب قریب لائی جائے گی"}},{"key":"81:14","n":14,"uthmani":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","indopak":"عَلِمَتۡ نَفۡسٌ مَّاۤ اَحۡضَرَتۡؕ‏","words":[{"uthmani":"عَلِمَتْ","indopak":"عَلِمَتۡ","ur":"جان لے گا","en":"Will know"},{"uthmani":"نَفْسٌۭ","indopak":"نَفۡسٌ","ur":"ہر نفس","en":"a soul"},{"uthmani":"مَّآ","indopak":"مَّاۤ","ur":"کیا","en":"what"},{"uthmani":"أَحْضَرَتْ","indopak":"اَحۡضَرَتۡؕ‏","ur":"اس نے حاضر کیا/ کیا لے کر آیا","en":"it has brought"}],"tr":{"20":"A soul will [then] know what it has brought [with it].","97":"اُس وقت ہر شخص کو معلوم ہو جائے گا کہ وہ کیا لے کر آیا ہے","234":"تب ہر شخص معلوم کر لے گا کہ وہ کیا لے کر آیا ہے"}},{"key":"81:15","n":15,"uthmani":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","indopak":"فَلَاۤ اُقۡسِمُ بِالۡخُنَّسِۙ‏","words":[{"uthmani":"فَلَآ","indopak":"فَلَاۤ","ur":"پس نہیں","en":"But nay"},{"uthmani":"أُقْسِمُ","indopak":"اُقۡسِمُ","ur":"میں قسم کھاتا ہوں","en":"I swear"},{"uthmani":"بِٱلْخُنَّسِ","indopak":"بِالۡخُنَّسِۙ‏","ur":"پیچھے ہٹنے والے کی","en":"by the retreating planets"}],"tr":{"20":"So I swear by the retreating stars -","97":"پس نہیں،  میں قسم کھاتا ہوں","234":"ہم کو ان ستاروں کی قسم جو پیچھے ہٹ جاتے ہیں"}},{"key":"81:16","n":16,"uthmani":"ٱلْجَوَارِ ٱلْكُنَّسِ","indopak":"الۡجَوَارِ الۡكُنَّسِۙ‏","words":[{"uthmani":"ٱلْجَوَارِ","indopak":"الۡجَوَارِ","ur":"سیدھے چلنے والے","en":"Those that run"},{"uthmani":"ٱلْكُنَّسِ","indopak":"الۡكُنَّسِۙ‏","ur":"چھپ جانے والے (ستاروں کی)","en":"(and) disappear"}],"tr":{"20":"Those that run [their courses] and disappear [i.e., set]","97":"پلٹنے اور چھپ جانے والے تاروں کی","234":"(اور) جو سیر کرتے اور غائب ہو جاتے ہیں"}},{"key":"81:17","n":17,"uthmani":"وَٱلَّيْلِ إِذَا عَسْعَسَ","indopak":"وَالَّيۡلِ اِذَا عَسۡعَسَۙ‏","words":[{"uthmani":"وَٱلَّيْلِ","indopak":"وَالَّيۡلِ","ur":"اور رات کی","en":"And the night"},{"uthmani":"إِذَا","indopak":"اِذَا","ur":"جب","en":"when"},{"uthmani":"عَسْعَسَ","indopak":"عَسۡعَسَۙ‏","ur":"وہ رخصت ہوتی ہے","en":"it departs"}],"tr":{"20":"And by the night as it closes in","97":"اور رات کی جبکہ وہ رخصت ہوئی","234":"اور رات کی قسم جب ختم ہونے لگتی ہے"}},{"key":"81:18","n":18,"uthmani":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","indopak":"وَالصُّبۡحِ اِذَا تَنَفَّسَۙ‏","words":[{"uthmani":"وَٱلصُّبْحِ","indopak":"وَالصُّبۡحِ","ur":"اور صبح کی","en":"And the dawn"},{"uthmani":"إِذَا","indopak":"اِذَا","ur":"جب","en":"when"},{"uthmani":"تَنَفَّسَ","indopak":"تَنَفَّسَۙ‏","ur":"وہ سانس لیتی ہے","en":"it breathes"}],"tr":{"20":"And by the dawn when it breathes [i.e., stirs]","97":"اور صبح کی جبکہ اس نے سانس لیا،","234":"اور صبح کی قسم جب نمودار ہوتی ہے"}},{"key":"81:19","n":19,"uthmani":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","indopak":"اِنَّهٗ لَقَوۡلُ رَسُوۡلٍ كَرِيۡمٍۙ‏","words":[{"uthmani":"إِنَّهُۥ","indopak":"اِنَّهٗ","ur":"بیشک وہ","en":"Indeed, it"},{"uthmani":"لَقَوْلُ","indopak":"لَقَوۡلُ","ur":"البتہ قول ہے/ کہنا ہے","en":"(is) surely a word"},{"uthmani":"رَسُولٍۢ","indopak":"رَسُوۡلٍ","ur":"ایک پیام بر کا","en":"(of) a Messenger"},{"uthmani":"كَرِيمٍۢ","indopak":"كَرِيۡمٍۙ‏","ur":"معزز کا","en":"noble"}],"tr":{"20":"[That] indeed, it [i.e., the Qur’ān] is a word [conveyed by] a noble messenger [i.e., Gabriel]","97":"یہ فی الواقع ایک بزرگ پیغام بر کا قول ہے","234":"کہ بےشک یہ (قرآن) فرشتہٴ عالی مقام کی زبان کا پیغام ہے"}},{"key":"81:20","n":20,"uthmani":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","indopak":"ذِىۡ قُوَّةٍ عِنۡدَ ذِى الۡعَرۡشِ مَكِيۡنٍۙ‏","words":[{"uthmani":"ذِى","indopak":"ذِىۡ","ur":"والا ہے","en":"Possessor of"},{"uthmani":"قُوَّةٍ","indopak":"قُوَّةٍ","ur":"قوت کا","en":"power"},{"uthmani":"عِندَ","indopak":"عِنۡدَ","ur":"نزدیک","en":"with"},{"uthmani":"ذِى","indopak":"ذِى","ur":"والے کے","en":"(the) Owner of"},{"uthmani":"ٱلْعَرْشِ","indopak":"الۡعَرۡشِ","ur":"عرش (والے کے )","en":"the Throne"},{"uthmani":"مَكِينٍۢ","indopak":"مَكِيۡنٍۙ‏","ur":"بلند مرتبے والا","en":"secure"}],"tr":{"20":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],","97":"جو بڑی توانائی رکھتا ہے،  عرش والے کے ہاں بلند مرتبہ ہے","234":"جو صاحب قوت مالک عرش کے ہاں اونچے درجے والا ہے"}},{"key":"81:21","n":21,"uthmani":"مُّطَاعٍ ثَمَّ أَمِينٍ","indopak":"مُّطَاعٍ ثَمَّ اَمِيۡنٍؕ‏","words":[{"uthmani":"مُّطَاعٍۢ","indopak":"مُّطَاعٍ","ur":"کہا مانا گیا","en":"One to be obeyed"},{"uthmani":"ثَمَّ","indopak":"ثَمَّ","ur":"اس جگہ","en":"and"},{"uthmani":"أَمِينٍۢ","indopak":"اَمِيۡنٍؕ‏","ur":"امانت دار ہے","en":"trustworthy"}],"tr":{"20":"Obeyed there [in the heavens] and trustworthy.","97":"وہاں اُس کا حکم مانا جاتا ہے،  وہ بااعتماد ہے۔","234":"سردار (اور) امانت دار ہے"}},{"key":"81:22","n":22,"uthmani":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","indopak":"وَ مَا صَاحِبُكُمۡ بِمَجۡنُوۡنٍ​ۚ‏","words":[{"uthmani":"وَمَا","indopak":"وَ مَا","ur":"اور نہیں","en":"And not"},{"uthmani":"صَاحِبُكُم","indopak":"صَاحِبُكُمۡ","ur":"ساتھ تمہارا","en":"(is) your companion"},{"uthmani":"بِمَجْنُونٍۢ","indopak":"بِمَجۡنُوۡنٍ​ۚ‏","ur":"کوئی مجنون","en":"mad"}],"tr":{"20":"And your companion [i.e., Prophet Muḥammad (ﷺ) ] is not [at all] mad.","97":"اور (اے اہلِ مکّہ) تمہارا رفیق  مجنون نہیں ہے","234":"اور (مکے والو) تمہارے رفیق (یعنی محمدﷺ) دیوانے نہیں ہیں"}},{"key":"81:23","n":23,"uthmani":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","indopak":"وَلَقَدۡ رَاٰهُ بِالۡاُفُقِ الۡمُبِيۡنِ​ۚ‏","words":[{"uthmani":"وَلَقَدْ","indopak":"وَلَقَدۡ","ur":"اور البتہ تحقیق","en":"And certainly"},{"uthmani":"رَءَاهُ","indopak":"رَاٰهُ","ur":"اس نے دیکھا اس کو","en":"he saw him"},{"uthmani":"بِٱلْأُفُقِ","indopak":"بِالۡاُفُقِ","ur":"آسمان کے کنارے پر","en":"in the horizon"},{"uthmani":"ٱلْمُبِينِ","indopak":"الۡمُبِيۡنِ​ۚ‏","ur":"کھلے","en":"the clear"}],"tr":{"20":"And he has already seen him [i.e., Gabriel] in the clear horizon.","97":"اُس نے اُس پیغام بر کو روشن اُفق پر دیکھا ہے۔","234":"بےشک انہوں نے اس (فرشتے) کو( آسمان کے کھلے یعنی) مشرقی کنارے پر دیکھا ہے"}},{"key":"81:24","n":24,"uthmani":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","indopak":"وَمَا هُوَ عَلَى الۡغَيۡبِ بِضَنِيۡنٍ​ۚ‏","words":[{"uthmani":"وَمَا","indopak":"وَمَا","ur":"اور نہیں","en":"And not"},{"uthmani":"هُوَ","indopak":"هُوَ","ur":"وہ","en":"he (is)"},{"uthmani":"عَلَى","indopak":"عَلَى","ur":"پر","en":"on"},{"uthmani":"ٱلْغَيْبِ","indopak":"الۡغَيۡبِ","ur":"غیب","en":"the unseen"},{"uthmani":"بِضَنِينٍۢ","indopak":"بِضَنِيۡنٍ​ۚ‏","ur":"ہرگز بخیل","en":"a withholder"}],"tr":{"20":"And he [i.e., Muḥammad (ﷺ)] is not a withholder of [knowledge of] the unseen.","97":"اور وہ غَیب (کے اِس علم کو لوگوں تک پہنچانے) کے معاملہ میں بخیل نہیں ہے۔","234":"اور وہ پوشیدہ باتوں (کے ظاہر کرنے) میں بخیل نہیں"}},{"key":"81:25","n":25,"uthmani":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ","indopak":"وَمَا هُوَ بِقَوۡلِ شَيۡطٰنٍ رَّجِيۡمٍۙ‏","words":[{"uthmani":"وَمَا","indopak":"وَمَا","ur":"اور نہیں ہے","en":"And not"},{"uthmani":"هُوَ","indopak":"هُوَ","ur":"وہ","en":"it"},{"uthmani":"بِقَوْلِ","indopak":"بِقَوۡلِ","ur":"قول","en":"(is the) word"},{"uthmani":"شَيْطَـٰنٍۢ","indopak":"شَيۡطٰنٍ","ur":"شیطان","en":"(of) Shaitaan"},{"uthmani":"رَّجِيمٍۢ","indopak":"رَّجِيۡمٍۙ‏","ur":"مردود کا","en":"accursed"}],"tr":{"20":"And it [i.e., the Qur’ān] is not the word of a devil, expelled [from the heavens].","97":"اور یہ کسی شیطان ِ مردُود کا قول نہیں ہے۔","234":"اور یہ شیطان مردود کا کلام نہیں"}},{"key":"81:26","n":26,"uthmani":"فَأَيْنَ تَذْهَبُونَ","indopak":"فَاَيۡنَ تَذۡهَبُوۡنَؕ‏","words":[{"uthmani":"فَأَيْنَ","indopak":"فَاَيۡنَ","ur":"پھر کدھر","en":"So where"},{"uthmani":"تَذْهَبُونَ","indopak":"تَذۡهَبُوۡنَؕ‏","ur":"تم جارہے ہو","en":"are you going"}],"tr":{"20":"So where are you going?","97":"پھر تم لوگ کدھر چلے جا رہے ہو؟","234":"پھر تم کدھر جا رہے ہو"}},{"key":"81:27","n":27,"uthmani":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","indopak":"اِنۡ هُوَ اِلَّا ذِكۡرٌ لِّلۡعٰلَمِيۡنَۙ‏","words":[{"uthmani":"إِنْ","indopak":"اِنۡ","ur":"نہیں","en":"Not"},{"uthmani":"هُوَ","indopak":"هُوَ","ur":"وہ","en":"it"},{"uthmani":"إِلَّا","indopak":"اِلَّا","ur":"مگر","en":"(is) except"},{"uthmani":"ذِكْرٌۭ","indopak":"ذِكۡرٌ","ur":"ایک نصیحت ہے","en":"a reminder"},{"uthmani":"لِّلْعَـٰلَمِينَ","indopak":"لِّلۡعٰلَمِيۡنَۙ‏","ur":"جہان والوں کے لئے","en":"to the worlds"}],"tr":{"20":"It is not except a reminder to the worlds","97":"یہ تو سارے جہان والوں کے لیے ایک نصیحت ہے","234":"یہ تو جہان کے لوگوں کے لیے نصیحت ہے"}},{"key":"81:28","n":28,"uthmani":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","indopak":"لِمَنۡ شَآءَ مِنۡكُمۡ اَنۡ يَّسۡتَقِيۡمَؕ‏","words":[{"uthmani":"لِمَن","indopak":"لِمَنۡ","ur":"واسطے اس کو","en":"For whoever"},{"uthmani":"شَآءَ","indopak":"شَآءَ","ur":"جو چاہے","en":"wills"},{"uthmani":"مِنكُمْ","indopak":"مِنۡكُمۡ","ur":"تم میں سے","en":"among you"},{"uthmani":"أَن","indopak":"اَنۡ","ur":"کہ","en":"to"},{"uthmani":"يَسْتَقِيمَ","indopak":"يَّسۡتَقِيۡمَؕ‏","ur":"راہ راست پر چلے","en":"take a straight way"}],"tr":{"20":"For whoever wills among you to take a right course.","97":"تم میں سے ہر اُس شخص کے لیے جو راہِ راست پر چلنا چاہتا ہو۔","234":"(یعنی) اس کے لیے جو تم میں سے سیدھی چال چلنا چاہے"}},{"key":"81:29","n":29,"uthmani":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ","indopak":"وَمَا تَشَآءُوۡنَ اِلَّاۤ اَنۡ يَّشَآءَ اللّٰهُ رَبُّ الۡعٰلَمِيۡنَ‏","words":[{"uthmani":"وَمَا","indopak":"وَمَا","ur":"اور نہیں","en":"And not"},{"uthmani":"تَشَآءُونَ","indopak":"تَشَآءُوۡنَ","ur":"تم چاہ سکتے","en":"you will"},{"uthmani":"إِلَّآ","indopak":"اِلَّاۤ","ur":"مگر","en":"except"},{"uthmani":"أَن","indopak":"اَنۡ","ur":"یہ کہ","en":"that"},{"uthmani":"يَشَآءَ","indopak":"يَّشَآءَ","ur":"چاہے","en":"wills"},{"uthmani":"ٱللَّهُ","indopak":"اللّٰهُ","ur":"اللہ","en":"Allah"},{"uthmani":"رَبُّ","indopak":"رَبُّ","ur":"جو رب ہے","en":"Lord"},{"uthmani":"ٱلْعَـٰلَمِينَ","indopak":"الۡعٰلَمِيۡنَ‏","ur":"سارے جہان والوں کا","en":"(of) the worlds"}],"tr":{"20":"And you do not will except that Allāh wills - Lord of the worlds.","97":"اور تمہارے چاہنے سے کچھ نہیں ہوتا جب تک اللہ ربّ العالمین نہ چاہے۔","234":"اور تم کچھ بھی نہیں چاہ سکتے مگر وہی جو خدائے رب العالمین چاہے"}}]}