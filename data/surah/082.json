{"id":82,"verses":[{"key":"82:1","n":1,"uthmani":" إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","indopak":"اِذَا السَّمَآءُ انْفَطَرَتۡۙ‏","words":[{"uthmani":"إِذَا","indopak":"اِذَا","ur":"جب","en":"When"},{"uthmani":"ٱلسَّمَآءُ","indopak":"السَّمَآءُ","ur":"آسمان","en":"the sky"},{"uthmani":"ٱنفَطَرَتْ","indopak":"انْفَطَرَتۡۙ‏","ur":"پھٹ جائے گا","en":"(is) cleft asunder"}],"tr":{"20":"When the sky breaks apart","97":"جب آسمان پھٹ جائے گا","234":"جب آسمان پھٹ جائے گا"}},{"key":"82:2","n":2,"uthmani":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","indopak":"وَاِذَا الۡكَوَاكِبُ انْتَثَرَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلْكَوَاكِبُ","indopak":"الۡكَوَاكِبُ","ur":"تارے","en":"the stars"},{"uthmani":"ٱنتَثَرَتْ","indopak":"انْتَثَرَتۡۙ‏","ur":"بکھرجائیں گے","en":"scatter"}],"tr":{"20":"And when the stars fall, scattering,","97":"اور جب تارے بکھر جائیں گے","234":"اور جب تارے جھڑ پڑیں گے"}},{"key":"82:3","n":3,"uthmani":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","indopak":"وَاِذَا الۡبِحَارُ فُجِّرَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلْبِحَارُ","indopak":"الۡبِحَارُ","ur":"سمندر","en":"the seas"},{"uthmani":"فُجِّرَتْ","indopak":"فُجِّرَتۡۙ‏","ur":"پھاڑ دیئے جائیں گے","en":"are made to gush forth"}],"tr":{"20":"And when the seas are erupted","97":"اور جب سمندر پھاڑ دیے جائیں گے،","234":"اور جب دریا بہہ (کر ایک دوسرے سے مل) جائیں گے"}},{"key":"82:4","n":4,"uthmani":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","indopak":"وَاِذَا الۡقُبُوۡرُ بُعۡثِرَتۡۙ‏","words":[{"uthmani":"وَإِذَا","indopak":"وَاِذَا","ur":"اور جب","en":"And when"},{"uthmani":"ٱلْقُبُورُ","indopak":"الۡقُبُوۡرُ","ur":"قبریں","en":"the graves"},{"uthmani":"بُعْثِرَتْ","indopak":"بُعۡثِرَتۡۙ‏","ur":"کھول دی جائیں گی","en":"are overturned"}],"tr":{"20":"And when the [contents of] graves are scattered [i.e., exposed],","97":"اور جب قبریں کھول دی جائیں گی،","234":"اور جب قبریں اکھیڑ دی جائیں گی"}},{"key":"82:5","n":5,"uthmani":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","indopak":"عَلِمَتۡ نَفۡسٌ مَّا قَدَّمَتۡ وَاَخَّرَتۡؕ‏","words":[{"uthmani":"عَلِمَتْ","indopak":"عَلِمَتۡ","ur":"جان لے گا","en":"Will know"},{"uthmani":"نَفْسٌۭ","indopak":"نَفۡسٌ","ur":"ہر شخص","en":"a soul"},{"uthmani":"مَّا","indopak":"مَّا","ur":"جو","en":"what"},{"uthmani":"قَدَّمَتْ","indopak":"قَدَّمَتۡ","ur":"اس نے آگے بھیجا","en":"it has sent forth"},{"uthmani":"وَأَخَّرَتْ","indopak":"وَاَخَّرَتۡؕ‏","ur":"اور جو پیچھے رکھا","en":"and left behind"}],"tr":{"20":"A soul will [then] know what it has put forth and kept back.","97":"اُس وقت ہر شخص کو اُس کا اگلا پچھلا سب کیا دھرا معلوم ہو جائے گا۔","234":"تب ہر شخص معلوم کرلے گا کہ اس نے آگے کیا بھیجا تھا اور پیچھے کیا چھوڑا تھا"}},{"key":"82:6","n":6,"uthmani":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","indopak":"يٰۤاَيُّهَا الۡاِنۡسَانُ مَا غَرَّكَ بِرَبِّكَ الۡكَرِيۡمِۙ‏","words":[{"uthmani":"يَـٰٓأَيُّهَا","indopak":"يٰۤاَيُّهَا","ur":"اے","en":"O"},{"uthmani":"ٱلْإِنسَـٰنُ","indopak":"الۡاِنۡسَانُ","ur":"انسان","en":"man"},{"uthmani":"مَا","indopak":"مَا","ur":"کس چیز نے","en":"What"},{"uthmani":"غَرَّكَ","indopak":"غَرَّكَ","ur":"دھوکے میں ڈالا تجھ کو","en":"has deceived you"},{"uthmani":"بِرَبِّكَ","indopak":"بِرَبِّكَ","ur":"تیرے رب","en":"concerning your Lord"},{"uthmani":"ٱلْكَرِيمِ","indopak":"الۡكَرِيۡمِۙ‏","ur":"کریم کے بارے میں","en":"the Most Noble"}],"tr":{"20":"O mankind, what has deceived you concerning your Lord, the Generous,","97":"اے انسان، کس چیز نے تجھے اپنے اُس رب کریم کی طرف سے دھوکے میں ڈال دیا","234":"اے انسان تجھ کو اپنے پروردگار کرم گستر کے باب میں کس چیز نے دھوکا دیا"}},{"key":"82:7","n":7,"uthmani":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","indopak":"الَّذِىۡ خَلَقَكَ فَسَوّٰٮكَ فَعَدَلَـكَۙ‏","words":[{"uthmani":"ٱلَّذِى","indopak":"الَّذِىۡ","ur":"وہ جس نے","en":"Who"},{"uthmani":"خَلَقَكَ","indopak":"خَلَقَكَ","ur":"پیدا کیا تجھ کو","en":"created you"},{"uthmani":"فَسَوَّىٰكَ","indopak":"فَسَوّٰٮكَ","ur":"پھر درست کیا تجھ کو","en":"then fashioned you"},{"uthmani":"فَعَدَلَكَ","indopak":"فَعَدَلَـكَۙ‏","ur":"پھر برابر کیا تجھ کو","en":"then balanced you"}],"tr":{"20":"Who created you, proportioned you, and balanced you?","97":"جس نے تجھے پیدا کیا، تجھے نک سک سے درست کیا، تجھے متناسب بنایا","234":"(وہی تو ہے) جس نے تجھے بنایا اور (تیرے اعضا کو) ٹھیک کیا اور (تیرے قامت کو) معتدل رکھا"}},{"key":"82:8","n":8,"uthmani":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ","indopak":"فِىۡۤ اَىِّ صُوۡرَةٍ مَّا شَآءَ رَكَّبَكَؕ‏","words":[{"uthmani":"فِىٓ","indopak":"فِىۡۤ","ur":"میں","en":"In"},{"uthmani":"أَىِّ","indopak":"اَىِّ","ur":"جس","en":"whatever"},{"uthmani":"صُورَةٍۢ","indopak":"صُوۡرَةٍ","ur":"شکل   (میں)","en":"form"},{"uthmani":"مَّا","indopak":"مَّا","ur":"جو","en":"what"},{"uthmani":"شَآءَ","indopak":"شَآءَ","ur":"اس نے چاہا","en":"He willed"},{"uthmani":"رَكَّبَكَ","indopak":"رَكَّبَكَؕ‏","ur":"جوڑ دیا تجھ کو","en":"He assembled you"}],"tr":{"20":"In whatever form He willed has He assembled you.","97":"اور جس صورت میں چاہا تجھ کو جوڑ کر تیار کیا؟","234":"اور جس صورت میں چاہا تجھے جوڑ دیا"}},{"key":"82:9","n":9,"uthmani":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","indopak":"كَلَّا بَلۡ تُكَذِّبُوۡنَ بِالدِّيۡنِۙ‏","words":[{"uthmani":"كَلَّا","indopak":"كَلَّا","ur":"ہرگز نہیں","en":"Nay"},{"uthmani":"بَلْ","indopak":"بَلۡ","ur":"بلکہ","en":"But"},{"uthmani":"تُكَذِّبُونَ","indopak":"تُكَذِّبُوۡنَ","ur":"تم جھٹلاتے ہو","en":"you deny"},{"uthmani":"بِٱلدِّينِ","indopak":"بِالدِّيۡنِۙ‏","ur":"جزا وسزا کو","en":"the Judgment"}],"tr":{"20":"No! But you deny the Recompense.","97":"ہر گز نہیں،  بلکہ (اصل بات یہ ہے کہ) تم لوگ جزا و سزا کو جھُٹلاتے ہو،","234":"مگر ہیہات تم لوگ جزا کو جھٹلاتے ہو"}},{"key":"82:10","n":10,"uthmani":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ","indopak":"وَاِنَّ عَلَيۡكُمۡ لَحٰـفِظِيۡنَۙ‏","words":[{"uthmani":"وَإِنَّ","indopak":"وَاِنَّ","ur":"اور بیشک","en":"And indeed"},{"uthmani":"عَلَيْكُمْ","indopak":"عَلَيۡكُمۡ","ur":"تم پر","en":"over you"},{"uthmani":"لَحَـٰفِظِينَ","indopak":"لَحٰـفِظِيۡنَۙ‏","ur":"البتہ حفاظت کرنے والے ہیں/ نگرانی کرنے والے","en":"(are) surely guardians"}],"tr":{"20":"And indeed, [appointed] over you are keepers,","97":"حالانکہ تم پر نگراں مقرر ہیں","234":"حالانکہ تم پر نگہبان مقرر ہیں"}},{"key":"82:11","n":11,"uthmani":"كِرَامًا كَـٰتِبِينَ","indopak":"كِرَامًا كَاتِبِيۡنَۙ‏","words":[{"uthmani":"كِرَامًۭا","indopak":"كِرَامًا","ur":"بزرگ/محترم","en":"Noble"},{"uthmani":"كَـٰتِبِينَ","indopak":"كَاتِبِيۡنَۙ‏","ur":"لکھنے والے ہیں","en":"recording"}],"tr":{"20":"Noble and recording;","97":"ایسے معزز کاتب","234":"عالی قدر( تمہاری باتوں کے) لکھنے والے"}},{"key":"82:12","n":12,"uthmani":"يَعْلَمُونَ مَا تَفْعَلُونَ","indopak":"يَعۡلَمُوۡنَ مَا تَفۡعَلُوۡنَ‏","words":[{"uthmani":"يَعْلَمُونَ","indopak":"يَعۡلَمُوۡنَ","ur":"جانتے ہیں","en":"They know"},{"uthmani":"مَا","indopak":"مَا","ur":"جو کچھ","en":"whatever"},{"uthmani":"تَفْعَلُونَ","indopak":"تَفۡعَلُوۡنَ‏","ur":"تم کرتے ہو","en":"you do"}],"tr":{"20":"They know whatever you do.","97":"جو تمہارے ہر فعل کو جانتے ہیں۔","234":"جو تم کرتے ہو وہ اسے جانتے ہیں"}},{"key":"82:13","n":13,"uthmani":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","indopak":"اِنَّ الۡاَبۡرَارَ لَفِىۡ نَعِيۡمٍۚ‏","words":[{"uthmani":"إِنَّ","indopak":"اِنَّ","ur":"بیشک","en":"Indeed"},{"uthmani":"ٱلْأَبْرَارَ","indopak":"الۡاَبۡرَارَ","ur":"نیک لوگ","en":"the righteous"},{"uthmani":"لَفِى","indopak":"لَفِىۡ","ur":"البتہ میں","en":"(will be) surely in"},{"uthmani":"نَعِيمٍۢ","indopak":"نَعِيۡمٍۚ‏","ur":"نعمتوں میں ہوں گے","en":"bliss"}],"tr":{"20":"Indeed, the righteous will be in pleasure,","97":"یقیناً نیک لوگ مزے میں ہوں گے","234":"بے شک نیکوکار نعمتوں (کی بہشت) میں ہوں گے۔"}},{"key":"82:14","n":14,"uthmani":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ","indopak":"وَاِنَّ الۡفُجَّارَ لَفِىۡ جَحِيۡمٍ ۚۖ‏","words":[{"uthmani":"وَإِنَّ","indopak":"وَاِنَّ","ur":"اور بیشک","en":"And indeed"},{"uthmani":"ٱلْفُجَّارَ","indopak":"الۡفُجَّارَ","ur":"بدکار لوگ","en":"the wicked"},{"uthmani":"لَفِى","indopak":"لَفِىۡ","ur":"البتہ میں","en":"(will be) surely in"},{"uthmani":"جَحِيمٍۢ","indopak":"جَحِيۡمٍ ۚۖ‏","ur":"جہنم میں ہوں گے","en":"Hellfire"}],"tr":{"20":"And indeed, the wicked will be in Hellfire.","97":"اور بے شک بدکار لوگ جہنم میں جائیں گے","234":"اور بدکردار دوزخ میں"}},{"key":"82:15","n":15,"uthmani":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","indopak":"يَّصۡلَوۡنَهَا يَوۡمَ الدِّيۡنِ‏","words":[{"uthmani":"يَصْلَوْنَهَا","indopak":"يَّصۡلَوۡنَهَا","ur":"وہ داخل ہوں گے اس میں","en":"They will burn (in) it"},{"uthmani":"يَوْمَ","indopak":"يَوۡمَ","ur":"دن","en":"(on the) Day"},{"uthmani":"ٱلدِّينِ","indopak":"الدِّيۡنِ‏","ur":"جزا سزا کے (دن)/ بدلے کے (دن)","en":"(of) the Judgment"}],"tr":{"20":"They will [enter to] burn therein on the Day of Recompense,","97":"جزا کے دن وہ اس میں داخل ہوں گے","234":"(یعنی) جزا کے دن اس میں داخل ہوں گے"}},{"key":"82:16","n":16,"uthmani":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","indopak":"وَمَا هُمۡ عَنۡهَا بِغَآٮِٕبِيۡنَؕ‏","words":[{"uthmani":"وَمَا","indopak":"وَمَا","ur":"اور نہیں","en":"And not"},{"uthmani":"هُمْ","indopak":"هُمۡ","ur":"وہ","en":"they"},{"uthmani":"عَنْهَا","indopak":"عَنۡهَا","ur":"اس سے","en":"from it"},{"uthmani":"بِغَآئِبِينَ","indopak":"بِغَآٮِٕبِيۡنَؕ‏","ur":"کچھ غائب ہونے والے","en":"(will be) absent"}],"tr":{"20":"And never therefrom will they be absent.","97":"اور اُس سے ہرگز غائب نہ ہو سکیں گے","234":"اور اس سے چھپ نہیں سکیں گے"}},{"key":"82:17","n":17,"uthmani":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","indopak":"وَمَاۤ اَدۡرٰٮكَ مَا يَوۡمُ الدِّيۡنِۙ‏","words":[{"uthmani":"وَمَآ","indopak":"وَمَاۤ","ur":"اور کیا چیز","en":"And what"},{"uthmani":"أَدْرَىٰكَ","indopak":"اَدۡرٰٮكَ","ur":"بتائے تجھ کو","en":"can make you know"},{"uthmani":"مَا","indopak":"مَا","ur":"کیا ہے ؟","en":"what"},{"uthmani":"يَوْمُ","indopak":"يَوۡمُ","ur":"دن","en":"(is the) Day"},{"uthmani":"ٱلدِّينِ","indopak":"الدِّيۡنِۙ‏","ur":"بدلے کا","en":"(of) the Judgment"}],"tr":{"20":"And what can make you know what is the Day of Recompense?","97":"اور تم کیا جانتے ہو کہ وہ جزا کا دن کیا ہے؟","234":"اور تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟"}},{"key":"82:18","n":18,"uthmani":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","indopak":"ثُمَّ مَاۤ اَدۡرٰٮكَ مَا يَوۡمُ الدِّيۡنِؕ‏","words":[{"uthmani":"ثُمَّ","indopak":"ثُمَّ","ur":"پھر","en":"Then"},{"uthmani":"مَآ","indopak":"مَاۤ","ur":"کیا چیز","en":"what"},{"uthmani":"أَدْرَىٰكَ","indopak":"اَدۡرٰٮكَ","ur":"بتائے تجھ کو","en":"can make you know"},{"uthmani":"مَا","indopak":"مَا","ur":"کہ کیا ہے ؟","en":"what"},{"uthmani":"يَوْمُ","indopak":"يَوۡمُ","ur":"دن","en":"(is the) Day"},{"uthmani":"ٱلدِّينِ","indopak":"الدِّيۡنِؕ‏","ur":"بدلے کا","en":"(of) the Judgment"}],"tr":{"20":"Then, what can make you know what is the Day of Recompense?","97":"ہاں، تمہیں کیا خبر کہ وہ جزا کا دن کیا ہے؟","234":"پھر تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟"}},{"key":"82:19","n":19,"uthmani":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ","indopak":"يَوۡمَ لَا تَمۡلِكُ نَفۡسٌ لِّنَفۡسٍ شَيۡـــًٔا​ ؕ وَالۡاَمۡرُ يَوۡمَٮِٕذٍ لِّلَّهِ‏","words":[{"uthmani":"يَوْمَ","indopak":"يَوۡمَ","ur":"جس دن","en":"(The) Day"},{"uthmani":"لَا","indopak":"لَا","ur":"نہ","en":"not"},{"uthmani":"تَمْلِكُ","indopak":"تَمۡلِكُ","ur":"مالک ہوگا","en":"will have power"},{"uthmani":"نَفْسٌۭ","indopak":"نَفۡسٌ","ur":"کوئی نفس","en":"a soul"},{"uthmani":"لِّنَفْسٍۢ","indopak":"لِّنَفۡسٍ","ur":"کسی نفس کے لئے","en":"for a soul"},{"uthmani":"شَيْـًۭٔا ۖ","indopak":"شَيۡـــًٔا​ ؕ","ur":"کچھ بھی/ کسی چیز کا بھی","en":"anything"},{"uthmani":"وَٱلْأَمْرُ","indopak":"وَالۡاَمۡرُ","ur":"اور تمام معاملہ ہوگا","en":"and the Command"},{"uthmani":"يَوْمَئِذٍۢ","indopak":"يَوۡمَٮِٕذٍ","ur":"اس دن","en":"that Day"},{"uthmani":"لِّلَّهِ","indopak":"لِّلَّهِ‏","ur":"اللہ ہی کے لئے","en":"(will be) with Allah"}],"tr":{"20":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allāh.","97":"یہ وہ دن ہے جب کسی شخص کے لیے کچھ کرنا کسی کے بس میں نہ ہوگا،  فیصلہ اُس دن بالکل اللہ کے اختیار میں ہوگا","234":"جس روز کوئی کسی کا بھلا نہ کر سکے گا اور حکم اس روز خدا ہی کا ہو گا"}}]}