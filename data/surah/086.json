{"id":86,"verses":[{"key":"86:1","n":1,"uthmani":" وَٱلسَّمَآءِ وَٱلطَّارِقِ","indopak":"وَالسَّمَآءِ وَالطَّارِقِۙ‏","words":[{"uthmani":"وَٱلسَّمَآءِ","indopak":"وَالسَّمَآءِ","ur":"قسم ہے آسمان کی","en":"By the sky"},{"uthmani":"وَٱلطَّارِقِ","indopak":"وَالطَّارِقِۙ‏","ur":"اور رات کو آنے والے کی","en":"and the night comer"}],"tr":{"20":"By the sky and the night comer","97":"قسم ہے آسمان کی اور رات کو نمودار ہونے والے کی","234":"آسمان اور رات کے وقت آنے والے کی قسم"}},{"key":"86:2","n":2,"uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","indopak":"وَمَاۤ اَدۡرٰٮكَ مَا الطَّارِقُۙ‏","words":[{"uthmani":"وَمَآ","indopak":"وَمَاۤ","ur":"اور کیا چیز","en":"And what"},{"uthmani":"أَدْرَىٰكَ","indopak":"اَدۡرٰٮكَ","ur":"بتائے تجھ کو","en":"can make you know"},{"uthmani":"مَا","indopak":"مَا","ur":"کیا ہے","en":"what"},{"uthmani":"ٱلطَّارِقُ","indopak":"الطَّارِقُۙ‏","ur":"وہ رات کو آنے والا","en":"the night comer (is)"}],"tr":{"20":"And what can make you know what is the night comer?","97":"اور تم کیا جانو کہ وہ رات کو نمودار ہونے والا کیا ہے؟","234":"اور تم کو کیا معلوم کہ رات کے وقت آنے والا کیا ہے"}},{"key":"86:3","n":3,"uthmani":"ٱلنَّجْمُ ٱلثَّاقِبُ","indopak":"النَّجۡمُ الثَّاقِبُۙ‏","words":[{"uthmani":"ٱلنَّجْمُ","indopak":"النَّجۡمُ","ur":"تارہ","en":"(It is) the star"},{"uthmani":"ٱلثَّاقِبُ","indopak":"الثَّاقِبُۙ‏","ur":"چکمتا ہوا","en":"the piercing"}],"tr":{"20":"It is the piercing star","97":"چمکتا ہوا تارا","234":"وہ تارا ہے چمکنے والا"}},{"key":"86:4","n":4,"uthmani":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","indopak":"اِنۡ كُلُّ نَفۡسٍ لَّمَّا عَلَيۡهَا حَافِظٌؕ‏","words":[{"uthmani":"إِن","indopak":"اِنۡ","ur":"نہیں","en":"Not"},{"uthmani":"كُلُّ","indopak":"كُلُّ","ur":"کوئی","en":"(is) every"},{"uthmani":"نَفْسٍۢ","indopak":"نَفۡسٍ","ur":"شخص","en":"soul"},{"uthmani":"لَّمَّا","indopak":"لَّمَّا","ur":"مگر","en":"but"},{"uthmani":"عَلَيْهَا","indopak":"عَلَيۡهَا","ur":"اس پر","en":"over it"},{"uthmani":"حَافِظٌۭ","indopak":"حَافِظٌؕ‏","ur":"حفاظت کرنے والا ہے/ نگرانی کرنے والا ہے","en":"(is) a protector"}],"tr":{"20":"There is no soul but that it has over it a protector.","97":"کوئی جان ایسی نہیں ہے جس کے اوپر کوئی نگہبان نہ ہو۔","234":"کہ کوئی متنفس نہیں جس پر نگہبان مقرر نہیں"}},{"key":"86:5","n":5,"uthmani":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","indopak":"فَلۡيَنۡظُرِ الۡاِنۡسَانُ مِمَّ خُلِقَؕ‏","words":[{"uthmani":"فَلْيَنظُرِ","indopak":"فَلۡيَنۡظُرِ","ur":"پس چاہیے کہ دیکھے","en":"So let see"},{"uthmani":"ٱلْإِنسَـٰنُ","indopak":"الۡاِنۡسَانُ","ur":"انسان","en":"man"},{"uthmani":"مِمَّ","indopak":"مِمَّ","ur":"کس چیز سے","en":"from what"},{"uthmani":"خُلِقَ","indopak":"خُلِقَؕ‏","ur":"وہ پیدا کیا گیا","en":"he is created"}],"tr":{"20":"So let man observe from what he was created.","97":"پھر ذرا انسان یہی دیکھ لے کہ وہ کِس چیز سے پیدا کیا گیا ہے۔","234":"تو انسان کو دیکھنا چاہئے کہ وہ کاہے سے پیدا ہوا ہے"}},{"key":"86:6","n":6,"uthmani":"خُلِقَ مِن مَّآءٍ دَافِقٍ","indopak":"خُلِقَ مِنۡ مَّآءٍ دَافِقٍۙ‏","words":[{"uthmani":"خُلِقَ","indopak":"خُلِقَ","ur":"پیدا کیا گیا","en":"He is created"},{"uthmani":"مِن","indopak":"مِنۡ","ur":"سے","en":"from"},{"uthmani":"مَّآءٍۢ","indopak":"مَّآءٍ","ur":"پانی (سے)","en":"a water"},{"uthmani":"دَافِقٍۢ","indopak":"دَافِقٍۙ‏","ur":"جو ٹپکنے والا ہے","en":"ejected"}],"tr":{"20":"He was created from a fluid, ejected,","97":"ایک اچھلنے والے پانی سے پیدا کیا گیا ہے","234":"وہ اچھلتے ہوئے پانی سے پیدا ہوا ہے"}},{"key":"86:7","n":7,"uthmani":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","indopak":"يَّخۡرُجُ مِنۡۢ بَيۡنِ الصُّلۡبِ وَالتَّرَآٮِٕبِؕ‏","words":[{"uthmani":"يَخْرُجُ","indopak":"يَّخۡرُجُ","ur":"نکلتا ہے","en":"Coming forth"},{"uthmani":"مِنۢ","indopak":"مِنۡۢ","ur":"سے","en":"from"},{"uthmani":"بَيْنِ","indopak":"بَيۡنِ","ur":"درمیان سے","en":"between"},{"uthmani":"ٱلصُّلْبِ","indopak":"الصُّلۡبِ","ur":"پیٹھ کی ہڈی کے","en":"the backbone"},{"uthmani":"وَٱلتَّرَآئِبِ","indopak":"وَالتَّرَآٮِٕبِؕ‏","ur":"اور سینے کی ہڈیوں ( کے درمیان سے)","en":"and the ribs"}],"tr":{"20":"Emerging from between the backbone and the ribs.","97":"جو پیٹھ اور سینے کی ہڈیوں کے درمیان سے نکلتا ہے۔","234":"جو پیٹھ اور سینے کے بیچ میں سے نکلتا ہے"}},{"key":"86:8","n":8,"uthmani":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","indopak":"اِنَّهٗ عَلٰى رَجۡعِهٖ لَقَادِرٌؕ‏","words":[{"uthmani":"إِنَّهُۥ","indopak":"اِنَّهٗ","ur":"بیشک وہ","en":"Indeed, He"},{"uthmani":"عَلَىٰ","indopak":"عَلٰى","ur":"اوپر","en":"to"},{"uthmani":"رَجْعِهِۦ","indopak":"رَجۡعِهٖ","ur":"اس کے واپس لانے کے","en":"return him"},{"uthmani":"لَقَادِرٌۭ","indopak":"لَقَادِرٌؕ‏","ur":"البتہ قادر ہے","en":"(is) Able"}],"tr":{"20":"Indeed, He [i.e., Allāh], to return him [to life], is Able.","97":"یقیناً وہ (خالق) اُسے دوبارہ پیدا کرنے پر قادر ہے۔","234":"بےشک خدا اس کے اعادے (یعنی پھر پیدا کرنے) پر قادر ہے"}},{"key":"86:9","n":9,"uthmani":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","indopak":"يَوۡمَ تُبۡلَى السَّرَآٮِٕرُۙ‏","words":[{"uthmani":"يَوْمَ","indopak":"يَوۡمَ","ur":"جس دن","en":"(The) Day"},{"uthmani":"تُبْلَى","indopak":"تُبۡلَى","ur":"جانچ پڑتال ہوگی","en":"will be tested"},{"uthmani":"ٱلسَّرَآئِرُ","indopak":"السَّرَآٮِٕرُۙ‏","ur":"پوشیدہ رازوں کی","en":"the secrets"}],"tr":{"20":"The Day when secrets will be put on trial,","97":"جس روز پوشیدہ اسرار کی جانچ پڑتال ہوگی","234":"جس دن دلوں کے بھید جانچے جائیں گے"}},{"key":"86:10","n":10,"uthmani":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","indopak":"فَمَا لَهٗ مِنۡ قُوَّةٍ وَّلَا نَاصِرٍؕ‏","words":[{"uthmani":"فَمَا","indopak":"فَمَا","ur":"تو نہیں ہوگی","en":"Then not"},{"uthmani":"لَهُۥ","indopak":"لَهٗ","ur":"اس کے لئے","en":"(is) for him"},{"uthmani":"مِن","indopak":"مِنۡ","ur":"کوئی","en":"any"},{"uthmani":"قُوَّةٍۢ","indopak":"قُوَّةٍ","ur":"قوت","en":"power"},{"uthmani":"وَلَا","indopak":"وَّلَا","ur":"اور نہ","en":"and not"},{"uthmani":"نَاصِرٍۢ","indopak":"نَاصِرٍؕ‏","ur":"کوئی مددگار","en":"any helper"}],"tr":{"20":"Then he [i.e., man] will have no power or any helper.","97":"اُس وقت انسان کے پاس نہ خود اپنا کوئی زور ہوگا اور نہ کوئی اس کی مدد کرنے والا ہوگا","234":"تو انسان کی کچھ پیش نہ چل سکے گی اور نہ کوئی اس کا مددگار ہو گا"}},{"key":"86:11","n":11,"uthmani":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","indopak":"وَالسَّمَآءِ ذَاتِ الرَّجۡعِۙ‏","words":[{"uthmani":"وَٱلسَّمَآءِ","indopak":"وَالسَّمَآءِ","ur":"قسم ہے آسمان کی","en":"By the sky"},{"uthmani":"ذَاتِ","indopak":"ذَاتِ","ur":"والے کی","en":"which"},{"uthmani":"ٱلرَّجْعِ","indopak":"الرَّجۡعِۙ‏","ur":"پلٹنے (والے کی)","en":"returns"}],"tr":{"20":"By the sky which sends back","97":"قسم ہے بارش برسانے والے آسمان کی","234":"آسمان کی قسم جو مینہ برساتا ہے"}},{"key":"86:12","n":12,"uthmani":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","indopak":"وَالۡاَرۡضِ ذَاتِ الصَّدۡعِۙ‏","words":[{"uthmani":"وَٱلْأَرْضِ","indopak":"وَالۡاَرۡضِ","ur":"اور زمین کی","en":"And the earth"},{"uthmani":"ذَاتِ","indopak":"ذَاتِ","ur":"والی ہے","en":"which"},{"uthmani":"ٱلصَّدْعِ","indopak":"الصَّدۡعِۙ‏","ur":"جو پھٹنے (والی ہے)","en":"cracks open"}],"tr":{"20":"And [by] the earth which splits,","97":"اور (نباتات اگتے وقت) پھٹ جانے والی زمین کی","234":"اور زمین کی قسم جو پھٹ جاتی ہے"}},{"key":"86:13","n":13,"uthmani":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","indopak":"اِنَّهٗ لَقَوۡلٌ فَصۡلٌۙ‏","words":[{"uthmani":"إِنَّهُۥ","indopak":"اِنَّهٗ","ur":"بیشک وہ","en":"Indeed, it"},{"uthmani":"لَقَوْلٌۭ","indopak":"لَقَوۡلٌ","ur":"البتہ ایک بات ہے","en":"(is) surely a Word"},{"uthmani":"فَصْلٌۭ","indopak":"فَصۡلٌۙ‏","ur":"فیصلہ کن","en":"decisive"}],"tr":{"20":"Indeed, it [i.e., the Qur’ān] is a decisive statement,","97":"یہ ایک جچی تلی بات ہے","234":"کہ یہ کلام (حق کو باطل سے) جدا کرنے والا ہے"}},{"key":"86:14","n":14,"uthmani":"وَمَا هُوَ بِٱلْهَزْلِ","indopak":"وَّمَا هُوَ بِالۡهَزۡلِؕ‏","words":[{"uthmani":"وَمَا","indopak":"وَّمَا","ur":"اور نہیں","en":"And not"},{"uthmani":"هُوَ","indopak":"هُوَ","ur":"وہ","en":"it"},{"uthmani":"بِٱلْهَزْلِ","indopak":"بِالۡهَزۡلِؕ‏","ur":"کوئی ہنسی مذاق","en":"(is) for amusement"}],"tr":{"20":"And it is not amusement.","97":"ہنسی مذاق نہیں ہے۔","234":"اور بیہودہ بات نہیں ہے"}},{"key":"86:15","n":15,"uthmani":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","indopak":"اِنَّهُمۡ يَكِيۡدُوۡنَ كَيۡدًا ۙ‏","words":[{"uthmani":"إِنَّهُمْ","indopak":"اِنَّهُمۡ","ur":"بیشک وہ","en":"Indeed, they"},{"uthmani":"يَكِيدُونَ","indopak":"يَكِيۡدُوۡنَ","ur":"چال چل رہے ہیں","en":"are plotting"},{"uthmani":"كَيْدًۭا","indopak":"كَيۡدًا ۙ‏","ur":"ایک چال","en":"a plot"}],"tr":{"20":"Indeed, they are planning a plan,","97":"یہ لوگ کچھ چالیں چل رہے ہیں","234":"یہ لوگ تو اپنی تدبیروں میں لگ رہے ہیں"}},{"key":"86:16","n":16,"uthmani":"وَأَكِيدُ كَيْدًا","indopak":"وَّاَكِيۡدُ كَيۡدًا ۚۖ‏","words":[{"uthmani":"وَأَكِيدُ","indopak":"وَّاَكِيۡدُ","ur":"اور میں تدبیر کر رہا ہوں","en":"But I am planning"},{"uthmani":"كَيْدًۭا","indopak":"كَيۡدًا ۚۖ‏","ur":"ایک تدبیر","en":"a plan"}],"tr":{"20":"But I am planning a plan.","97":"اور میں بھی ایک چال چل رہا ہوں۔","234":"اور ہم اپنی تدبیر کر رہے ہیں"}},{"key":"86:17","n":17,"uthmani":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","indopak":"فَمَهِّلِ الۡكٰفِرِيۡنَ اَمۡهِلۡهُمۡ رُوَيۡدًا‏","words":[{"uthmani":"فَمَهِّلِ","indopak":"فَمَهِّلِ","ur":"پس ڈھیل دے دو","en":"So give respite"},{"uthmani":"ٱلْكَـٰفِرِينَ","indopak":"الۡكٰفِرِيۡنَ","ur":"کافروں کو","en":"(to) the disbelievers"},{"uthmani":"أَمْهِلْهُمْ","indopak":"اَمۡهِلۡهُمۡ","ur":"ڈھیل دو ان کو","en":"Give respite to them "},{"uthmani":"رُوَيْدًۢا","indopak":"رُوَيۡدًا‏","ur":"مہلت تھوڑی سی","en":"little"}],"tr":{"20":"So allow time for the disbelievers. Leave them awhile.","97":"پس چھوڑ دو اے نبیؐ ، اِن کافروں کو اِک ذرا کی ذرا اِن کے حال پر چھوڑ دو۔","234":"تو تم کافروں کو مہلت دو بس چند روز ہی مہلت دو"}}]}