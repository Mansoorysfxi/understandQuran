{"id":87,"verses":[{"key":"87:1","n":1,"uthmani":" سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","indopak":"سَبِّحِ اسۡمَ رَبِّكَ الۡاَعۡلَىۙ‏","words":[{"uthmani":"سَبِّحِ","indopak":"سَبِّحِ","ur":"تسبیح کیجئے","en":"Glorify"},{"uthmani":"ٱسْمَ","indopak":"اسۡمَ","ur":"نام کی","en":"(the) name"},{"uthmani":"رَبِّكَ","indopak":"رَبِّكَ","ur":"اپنے رب کے","en":"(of) your Lord"},{"uthmani":"ٱلْأَعْلَى","indopak":"الۡاَعۡلَىۙ‏","ur":"جو سب سے بلند ہے","en":"the Most High"}],"tr":{"20":"Exalt the name of your Lord, the Most High,","97":"(اے نبیؐ)اپنے ربِّ برتر کے نام کی تسبیح کرو","234":"(اے پیغمبر) اپنے پروردگار جلیل الشان کے نام کی تسبیح کرو"}},{"key":"87:2","n":2,"uthmani":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","indopak":"الَّذِىۡ خَلَقَ فَسَوّٰى ۙ‏","words":[{"uthmani":"ٱلَّذِى","indopak":"الَّذِىۡ","ur":"وہ جس نے","en":"The One Who"},{"uthmani":"خَلَقَ","indopak":"خَلَقَ","ur":"پیدا کیا","en":"created"},{"uthmani":"فَسَوَّىٰ","indopak":"فَسَوّٰى ۙ‏","ur":"پھر درست بنایا","en":"then proportioned"}],"tr":{"20":"Who created and proportioned","97":"جس نے پیدا کیا اور تناسُب قائم کیا،","234":"جس نے (انسان کو) بنایا پھر( اس کے اعضاء کو) درست کیا"}},{"key":"87:3","n":3,"uthmani":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","indopak":"وَالَّذِىۡ قَدَّرَ فَهَدٰى ۙ‏","words":[{"uthmani":"وَٱلَّذِى","indopak":"وَالَّذِىۡ","ur":"اور وہ ذات","en":"And the One Who"},{"uthmani":"قَدَّرَ","indopak":"قَدَّرَ","ur":"جس نے انداز کیا/ تقدیر بنائی","en":"measured"},{"uthmani":"فَهَدَىٰ","indopak":"فَهَدٰى ۙ‏","ur":"پھر ہدایت بخشی","en":"then guided"}],"tr":{"20":"And who destined and [then] guided","97":"جس نے تقدیر بنائی  پھر راہ دکھائی،","234":"اور جس نے( اس کا)اندازہ ٹہرایا (پھر اس کو) رستہ بتایا"}},{"key":"87:4","n":4,"uthmani":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","indopak":"وَالَّذِىۡۤ اَخۡرَجَ الۡمَرۡعٰى ۙ‏","words":[{"uthmani":"وَٱلَّذِىٓ","indopak":"وَالَّذِىۡۤ","ur":"اور وہ ذات","en":"And the One Who"},{"uthmani":"أَخْرَجَ","indopak":"اَخۡرَجَ","ur":"جس نے نکالا","en":"brings forth"},{"uthmani":"ٱلْمَرْعَىٰ","indopak":"الۡمَرۡعٰى ۙ‏","ur":"چارہ","en":"the pasture"}],"tr":{"20":"And who brings out the pasture","97":"جس نے نباتات اُگائیں","234":"اور جس نے چارہ اگایا"}},{"key":"87:5","n":5,"uthmani":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","indopak":"فَجَعَلَهٗ غُثَآءً اَحۡوٰىؕ‏","words":[{"uthmani":"فَجَعَلَهُۥ","indopak":"فَجَعَلَهٗ","ur":"پھر بنادیا اس کو","en":"And then makes it"},{"uthmani":"غُثَآءً","indopak":"غُثَآءً","ur":"خشک گھاس/ کوڑا","en":"stubble"},{"uthmani":"أَحْوَىٰ","indopak":"اَحۡوٰىؕ‏","ur":"سیاہ کیا","en":"dark"}],"tr":{"20":"And [then] makes it black stubble.","97":"پھر اُن کو سیاہ کُوڑا کرکٹ بنا دیا۔","234":"پھر اس کو سیاہ رنگ کا کوڑا کر دیا"}},{"key":"87:6","n":6,"uthmani":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","indopak":"سَنُقۡرِئُكَ فَلَا تَنۡسٰٓىۙ‏","words":[{"uthmani":"سَنُقْرِئُكَ","indopak":"سَنُقۡرِئُكَ","ur":"عنقریب ہم پڑھوا دیں گے تجھ کو","en":"We will make you recite"},{"uthmani":"فَلَا","indopak":"فَلَا","ur":"تو نہ","en":"so not"},{"uthmani":"تَنسَىٰٓ","indopak":"تَنۡسٰٓىۙ‏","ur":"تم بھولو گے","en":"you will forget"}],"tr":{"20":"We will make you recite, [O Muḥammad], and you will not forget,","97":"ہم تمہیں پڑھوا دیں گے، پھر تم نہیں بھولو گے","234":"ہم تمہیں پڑھا دیں گے کہ تم فراموش نہ کرو گے"}},{"key":"87:7","n":7,"uthmani":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","indopak":"اِلَّا مَا شَآءَ اللّٰهُ​ؕ اِنَّهٗ يَعۡلَمُ الۡجَهۡرَ وَمَا يَخۡفٰىؕ‏","words":[{"uthmani":"إِلَّا","indopak":"اِلَّا","ur":"مگر","en":"Except"},{"uthmani":"مَا","indopak":"مَا","ur":"جو","en":"what"},{"uthmani":"شَآءَ","indopak":"شَآءَ","ur":"چاہا","en":"wills"},{"uthmani":"ٱللَّهُ ۚ","indopak":"اللّٰهُ​ؕ","ur":"اللہ نے","en":"Allah"},{"uthmani":"إِنَّهُۥ","indopak":"اِنَّهٗ","ur":"بیشک وہ","en":"Indeed, He"},{"uthmani":"يَعْلَمُ","indopak":"يَعۡلَمُ","ur":"وہ جانتا ہے","en":"knows"},{"uthmani":"ٱلْجَهْرَ","indopak":"الۡجَهۡرَ","ur":"ظاہر کو","en":"the manifest"},{"uthmani":"وَمَا","indopak":"وَمَا","ur":"اور جو","en":"and what"},{"uthmani":"يَخْفَىٰ","indopak":"يَخۡفٰىؕ‏","ur":"پوشیدہ ہے","en":"is hidden"}],"tr":{"20":"Except what Allāh should will. Indeed, He knows what is declared and what is hidden.","97":"سوائے اُس کے جو اللہ چاہے،  وہ ظاہر کو بھی جانتا ہے اور جوکچھ پوشیدہ ہے اُس کو بھی۔","234":"مگر جو خدا چاہے۔ وہ کھلی بات کو بھی جانتا ہے اور چھپی کو بھی"}},{"key":"87:8","n":8,"uthmani":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","indopak":"وَنُيَسِّرُكَ لِلۡيُسۡرٰى ​ۖ​ۚ‏","words":[{"uthmani":"وَنُيَسِّرُكَ","indopak":"وَنُيَسِّرُكَ","ur":"اور ہم آسان کر رہے ہیں تجھ کو/ تیرے لئے","en":"And We will ease you"},{"uthmani":"لِلْيُسْرَىٰ","indopak":"لِلۡيُسۡرٰى ​ۖ​ۚ‏","ur":"واسطے آسانی کے","en":"to the ease"}],"tr":{"20":"And We will ease you toward ease.","97":"اور ہم تمہیں آسان طریقے کی سہولت دیتے ہیں","234":"ہم تم کو آسان طریقے کی توفیق دیں گے"}},{"key":"87:9","n":9,"uthmani":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","indopak":"فَذَكِّرۡ اِنۡ نَّفَعَتِ الذِّكۡرٰىؕ‏","words":[{"uthmani":"فَذَكِّرْ","indopak":"فَذَكِّرۡ","ur":"پس نصیحت کیجئے","en":"So remind"},{"uthmani":"إِن","indopak":"اِنۡ","ur":"اگر","en":"if"},{"uthmani":"نَّفَعَتِ","indopak":"نَّفَعَتِ","ur":"فائدہ دے","en":"benefits"},{"uthmani":"ٱلذِّكْرَىٰ","indopak":"الذِّكۡرٰىؕ‏","ur":"نصیحت کرنا","en":"the reminder"}],"tr":{"20":"So remind, if the reminder should benefit;","97":"لہٰذا تم نصیحت کرو اگر نصیحت نافع ہو۔","234":"سو جہاں تک نصیحت (کے) نافع( ہونے کی امید) ہو نصیحت کرتے رہو"}},{"key":"87:10","n":10,"uthmani":"سَيَذَّكَّرُ مَن يَخْشَىٰ","indopak":"سَيَذَّكَّرُ مَنۡ يَّخۡشٰىۙ‏","words":[{"uthmani":"سَيَذَّكَّرُ","indopak":"سَيَذَّكَّرُ","ur":"عنقریب نصیحت پکڑے گا","en":"He will pay heed "},{"uthmani":"مَن","indopak":"مَنۡ","ur":"وہ جو","en":"(one) who"},{"uthmani":"يَخْشَىٰ","indopak":"يَّخۡشٰىۙ‏","ur":"ڈرتا ہوگا","en":"fears (Allah)"}],"tr":{"20":"He who fears [Allāh] will be reminded.","97":"جو شخص ڈرتا ہے وہ نصیحت قبول کر لے گا،","234":"جو خوف رکھتا ہے وہ تو نصیحت پکڑے گا"}},{"key":"87:11","n":11,"uthmani":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","indopak":"وَيَتَجَنَّبُهَا الۡاَشۡقَىۙ‏","words":[{"uthmani":"وَيَتَجَنَّبُهَا","indopak":"وَيَتَجَنَّبُهَا","ur":"اور گریز کرے گا اس سے","en":"And will avoid it"},{"uthmani":"ٱلْأَشْقَى","indopak":"الۡاَشۡقَىۙ‏","ur":"سب سے زیادہ بدبخت","en":"the wretched one"}],"tr":{"20":"But the wretched one will avoid it","97":"اور اس سے گریز کریگا وہ انتہائی بد بخت","234":"اور (بےخوف) بدبخت پہلو تہی کرے گا"}},{"key":"87:12","n":12,"uthmani":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","indopak":"الَّذِىۡ يَصۡلَى النَّارَ الۡكُبۡرٰى​ۚ‏","words":[{"uthmani":"ٱلَّذِى","indopak":"الَّذِىۡ","ur":"وہ جو","en":"The one who"},{"uthmani":"يَصْلَى","indopak":"يَصۡلَى","ur":"داخل ہوگا","en":"will burn"},{"uthmani":"ٱلنَّارَ","indopak":"النَّارَ","ur":"آگ میں","en":"(in) the Fire"},{"uthmani":"ٱلْكُبْرَىٰ","indopak":"الۡكُبۡرٰى​ۚ‏","ur":"بڑی","en":"[the] great"}],"tr":{"20":"[He] who will [enter and] burn in the greatest Fire,","97":"جو بڑی آگ میں جائے گا","234":"جو (قیامت کو) بڑی (تیز) آگ میں داخل ہو گا"}},{"key":"87:13","n":13,"uthmani":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","indopak":"ثُمَّ لَا يَمُوۡتُ فِيۡهَا وَلَا يَحۡيٰىؕ‏","words":[{"uthmani":"ثُمَّ","indopak":"ثُمَّ","ur":"پھر","en":"Then"},{"uthmani":"لَا","indopak":"لَا","ur":"نہ","en":"not"},{"uthmani":"يَمُوتُ","indopak":"يَمُوۡتُ","ur":"وہ مرے گا","en":"he will die"},{"uthmani":"فِيهَا","indopak":"فِيۡهَا","ur":"اس میں","en":"therein"},{"uthmani":"وَلَا","indopak":"وَلَا","ur":"اور نہ","en":"and not"},{"uthmani":"يَحْيَىٰ","indopak":"يَحۡيٰىؕ‏","ur":"زندہ ہوگا","en":"will live"}],"tr":{"20":"Neither dying therein nor living.","97":"پھر نہ اس میں مرے گا اور نہ جیے گا۔","234":"پھر وہاں نہ مرے گا اور نہ جئے گا"}},{"key":"87:14","n":14,"uthmani":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","indopak":"قَدۡ اَفۡلَحَ مَنۡ تَزَكّٰىۙ‏","words":[{"uthmani":"قَدْ","indopak":"قَدۡ","ur":"یقیناً","en":"Certainly"},{"uthmani":"أَفْلَحَ","indopak":"اَفۡلَحَ","ur":"فلاح پا گیا","en":"has succeeded"},{"uthmani":"مَن","indopak":"مَنۡ","ur":"وہ جس نے","en":"(one) who"},{"uthmani":"تَزَكَّىٰ","indopak":"تَزَكّٰىۙ‏","ur":"پاکیزگی اختیار کی","en":"purifies (himself)"}],"tr":{"20":"He has certainly succeeded who purifies himself","97":"فلاح پا گیا وہ جس نے پاکیزگی اختیار کی","234":"بے شک وہ مراد کو پہنچ گیا جو پاک ہوا"}},{"key":"87:15","n":15,"uthmani":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","indopak":"وَذَكَرَ اسۡمَ رَبِّهٖ فَصَلّٰى​ ؕ‏","words":[{"uthmani":"وَذَكَرَ","indopak":"وَذَكَرَ","ur":"اور ذکر کیا/ یاد کیا","en":"And remembers"},{"uthmani":"ٱسْمَ","indopak":"اسۡمَ","ur":"نام","en":"(the) name"},{"uthmani":"رَبِّهِۦ","indopak":"رَبِّهٖ","ur":"اپنے رب کا","en":"(of) his Lord"},{"uthmani":"فَصَلَّىٰ","indopak":"فَصَلّٰى​ ؕ‏","ur":"پھر اس نے نماز پڑھی","en":"and prays"}],"tr":{"20":"And mentions the name of his Lord and prays.","97":"اور اپنے ربّ کا نام یاد کیا  پھر نماز پڑھی۔","234":"اور اپنے پروردگار کے نام کا ذکر کرتا رہا اور نماز پڑھتا رہا"}},{"key":"87:16","n":16,"uthmani":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","indopak":"بَلۡ تُؤۡثِرُوۡنَ الۡحَيٰوةَ الدُّنۡيَا ۖ‏","words":[{"uthmani":"بَلْ","indopak":"بَلۡ","ur":"بلکہ","en":"Nay"},{"uthmani":"تُؤْثِرُونَ","indopak":"تُؤۡثِرُوۡنَ","ur":"تم ترجیح دیتے ہو","en":"You prefer"},{"uthmani":"ٱلْحَيَوٰةَ","indopak":"الۡحَيٰوةَ","ur":"زندگی کو","en":"the life"},{"uthmani":"ٱلدُّنْيَا","indopak":"الدُّنۡيَا ۖ‏","ur":"دنیا کی","en":"(of) the world"}],"tr":{"20":"But you prefer the worldly life,","97":"مگر تم لوگ دنیا کی زندگی کو ترجیح دیتے ہو،","234":"مگر تم لوگ تو دنیا کی زندگی کو اختیار کرتے ہو"}},{"key":"87:17","n":17,"uthmani":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","indopak":"وَالۡاٰخِرَةُ خَيۡرٌ وَّ اَبۡقٰىؕ‏","words":[{"uthmani":"وَٱلْـَٔاخِرَةُ","indopak":"وَالۡاٰخِرَةُ","ur":"اور آخرت","en":"While the Hereafter"},{"uthmani":"خَيْرٌۭ","indopak":"خَيۡرٌ","ur":"بہتر ہے","en":"(is) better"},{"uthmani":"وَأَبْقَىٰٓ","indopak":"وَّ اَبۡقٰىؕ‏","ur":"اور زیادہ باقی رہنے والی","en":"and everlasting"}],"tr":{"20":"While the Hereafter is better and more enduring.","97":"حالانکہ آخرت بہتر ہے اور باقی رہنے والی ہے۔","234":"حالانکہ آخرت بہت بہتر اور پائندہ تر ہے"}},{"key":"87:18","n":18,"uthmani":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","indopak":"اِنَّ هٰذَا لَفِى الصُّحُفِ الۡاُوۡلٰىۙ‏","words":[{"uthmani":"إِنَّ","indopak":"اِنَّ","ur":"یقیناً","en":"Indeed"},{"uthmani":"هَـٰذَا","indopak":"هٰذَا","ur":"یہ","en":"this"},{"uthmani":"لَفِى","indopak":"لَفِى","ur":"البتہ میں","en":"surely (is) in"},{"uthmani":"ٱلصُّحُفِ","indopak":"الصُّحُفِ","ur":"صحیفوں میں ہے","en":"the Scriptures"},{"uthmani":"ٱلْأُولَىٰ","indopak":"الۡاُوۡلٰىۙ‏","ur":"پہلے","en":"[the] former"}],"tr":{"20":"Indeed, this is in the former scriptures,","97":"یہی بات پہلے آئے ہوئے صحیفوں میں بھی کہی گئی تھی","234":"یہ بات پہلے صحیفوں میں (مرقوم) ہے"}},{"key":"87:19","n":19,"uthmani":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","indopak":"صُحُفِ اِبۡرٰهِيۡمَ وَمُوۡسٰى‏","words":[{"uthmani":"صُحُفِ","indopak":"صُحُفِ","ur":"صحیفوں میں","en":"(The) Scriptures"},{"uthmani":"إِبْرَٰهِيمَ","indopak":"اِبۡرٰهِيۡمَ","ur":"ابراہیم","en":"(of) Ibrahim"},{"uthmani":"وَمُوسَىٰ","indopak":"وَمُوۡسٰى‏","ur":"اور موسیٰ کے","en":"and Musa"}],"tr":{"20":"The scriptures of Abraham and Moses.","97":"ابراہیمؑ  اور موسیٰؑ کے صحیفوں میں۔","234":"(یعنی) ابراہیم اور موسیٰ کے صحیفوں میں"}}]}