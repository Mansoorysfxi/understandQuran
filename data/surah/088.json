{"id":88,"verses":[{"key":"88:1","n":1,"uthmani":" هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ","indopak":"هَلۡ اَتٰٮكَ حَدِيۡثُ الۡغَاشِيَةِؕ‏","words":[{"uthmani":"هَلْ","indopak":"هَلۡ","ur":"کیا","en":"Has"},{"uthmani":"أَتَىٰكَ","indopak":"اَتٰٮكَ","ur":"آئی ہے تیرے پاس","en":"(there) come to you"},{"uthmani":"حَدِيثُ","indopak":"حَدِيۡثُ","ur":"خبر","en":"(the) news"},{"uthmani":"ٱلْغَـٰشِيَةِ","indopak":"الۡغَاشِيَةِؕ‏","ur":"ڈھانپ لینے والی کی/ چھا جانے والی آفت کی","en":"(of) the Overwhelming"}],"tr":{"20":"Has there reached you the report of the Overwhelming [event]?","97":"کیا تمہیں اُس چھا جانے والی آفت کی خبر پہنچی ہے؟","234":"بھلا تم کو ڈھانپ لینے والی (یعنی قیامت کا) حال معلوم ہوا ہے"}},{"key":"88:2","n":2,"uthmani":"وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ","indopak":"وُجُوۡهٌ يَّوۡمَٮِٕذٍ خَاشِعَةٌ ۙ‏","words":[{"uthmani":"وُجُوهٌۭ","indopak":"وُجُوۡهٌ","ur":"کچھ چہرے","en":"Faces"},{"uthmani":"يَوْمَئِذٍ","indopak":"يَّوۡمَٮِٕذٍ","ur":"اس دن","en":"that Day"},{"uthmani":"خَـٰشِعَةٌ","indopak":"خَاشِعَةٌ ۙ‏","ur":"ذلیل ہونے والے ہیں","en":"(will be) humbled"}],"tr":{"20":"[Some] faces, that Day, will be humbled,","97":"کچھ چہرے  اُس روز خوف زدہ ہوں گے","234":"اس روز بہت سے منہ (والے) ذلیل ہوں گے"}},{"key":"88:3","n":3,"uthmani":"عَامِلَةٌ نَّاصِبَةٌ","indopak":"عَامِلَةٌ نَّاصِبَةٌ ۙ‏","words":[{"uthmani":"عَامِلَةٌۭ","indopak":"عَامِلَةٌ","ur":"عمل کرنے والے ہیں","en":"Laboring"},{"uthmani":"نَّاصِبَةٌۭ","indopak":"نَّاصِبَةٌ ۙ‏","ur":"محنت کرنے والے ہیں/ تھکنے والے ہیں","en":"exhausted"}],"tr":{"20":"Working [hard] and exhausted.","97":"سخت مشقت کر رہے ہونگے","234":"سخت محنت کرنے والے تھکے ماندے"}},{"key":"88:4","n":4,"uthmani":"تَصْلَىٰ نَارًا حَامِيَةً","indopak":"تَصۡلٰى نَارًا حَامِيَةً ۙ‏","words":[{"uthmani":"تَصْلَىٰ","indopak":"تَصۡلٰى","ur":"داخل ہوں گے","en":"They will burn"},{"uthmani":"نَارًا","indopak":"نَارًا","ur":"آگ میں","en":"(in) a Fire"},{"uthmani":"حَامِيَةًۭ","indopak":"حَامِيَةً ۙ‏","ur":"بھڑکتی ہوئی/ جلتی ہوئی","en":"intensely hot"}],"tr":{"20":"They will [enter to] burn in an intensely hot Fire.","97":"تھکے جاتے ہونگے، شدید آگ میں جھلس رہے ہونگے","234":"دہکتی آگ میں داخل ہوں گے"}},{"key":"88:5","n":5,"uthmani":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","indopak":"تُسۡقٰى مِنۡ عَيۡنٍ اٰنِيَةٍؕ‏","words":[{"uthmani":"تُسْقَىٰ","indopak":"تُسۡقٰى","ur":"پلائے جائیں گے","en":"They will be given to drink"},{"uthmani":"مِنْ","indopak":"مِنۡ","ur":"سے","en":"from"},{"uthmani":"عَيْنٍ","indopak":"عَيۡنٍ","ur":"ایک چشمے سے","en":"a spring"},{"uthmani":"ءَانِيَةٍۢ","indopak":"اٰنِيَةٍؕ‏","ur":"کھولتے ہوئے پانی کا","en":"boiling"}],"tr":{"20":"They will be given drink from a boiling spring.","97":"کھولتے ہوئے چشمے کا پانی انہیں پینے کو دیا جائے گا","234":"ایک کھولتے ہوئے چشمے کا ان کو پانی پلایا جائے گا"}},{"key":"88:6","n":6,"uthmani":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ","indopak":"لَـيۡسَ لَهُمۡ طَعَامٌ اِلَّا مِنۡ ضَرِيۡعٍۙ‏","words":[{"uthmani":"لَّيْسَ","indopak":"لَـيۡسَ","ur":"نہیں","en":"Not is"},{"uthmani":"لَهُمْ","indopak":"لَهُمۡ","ur":"ان کے لئے","en":"for them"},{"uthmani":"طَعَامٌ","indopak":"طَعَامٌ","ur":"کوئی کھانا","en":"food"},{"uthmani":"إِلَّا","indopak":"اِلَّا","ur":"سوائے","en":"except"},{"uthmani":"مِن","indopak":"مِنۡ","ur":"","en":"from"},{"uthmani":"ضَرِيعٍۢ","indopak":"ضَرِيۡعٍۙ‏","ur":"کانٹوں کے","en":"a bitter thorny plant"}],"tr":{"20":"For them there will be no food except from a poisonous, thorny plant","97":"خاردار سُوکھی گھاس کے سوا کوئی کھانا اُن کے لیے نہ ہوگا،","234":"اور خار دار جھاڑ کے سوا ان کے لیے کوئی کھانا نہیں (ہو گا)"}},{"key":"88:7","n":7,"uthmani":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ","indopak":"لَّا يُسۡمِنُ وَلَا يُغۡنِىۡ مِنۡ جُوۡعٍؕ‏","words":[{"uthmani":"لَّا","indopak":"لَّا","ur":"نہ","en":"Not"},{"uthmani":"يُسْمِنُ","indopak":"يُسۡمِنُ","ur":"موٹا کرے","en":"it nourishes"},{"uthmani":"وَلَا","indopak":"وَلَا","ur":"اور نہ","en":"and not"},{"uthmani":"يُغْنِى","indopak":"يُغۡنِىۡ","ur":"کام آئے","en":"it avails"},{"uthmani":"مِن","indopak":"مِنۡ","ur":"سے","en":"from"},{"uthmani":"جُوعٍۢ","indopak":"جُوۡعٍؕ‏","ur":"بھوک","en":"hunger"}],"tr":{"20":"Which neither nourishes nor avails against hunger.","97":"جو نہ موٹا کرے نہ بھوک مٹائے","234":"جو نہ فربہی لائے اور نہ بھوک میں کچھ کام آئے"}},{"key":"88:8","n":8,"uthmani":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ","indopak":"وُجُوۡهٌ يَّوۡمَٮِٕذٍ نَّاعِمَةٌ ۙ‏","words":[{"uthmani":"وُجُوهٌۭ","indopak":"وُجُوۡهٌ","ur":"کچھ چہرے","en":"Faces"},{"uthmani":"يَوْمَئِذٍۢ","indopak":"يَّوۡمَٮِٕذٍ","ur":"اس دن","en":"that Day"},{"uthmani":"نَّاعِمَةٌۭ","indopak":"نَّاعِمَةٌ ۙ‏","ur":"نعمتوں والے ہوں گے","en":"(will be) joyful"}],"tr":{"20":"[Other] faces, that Day, will show pleasure.","97":"کچھ چہرے اُس روز با رونق ہوں گے","234":"اور بہت سے منہ (والے) اس روز شادماں ہوں گے"}},{"key":"88:9","n":9,"uthmani":"لِّسَعْيِهَا رَاضِيَةٌ","indopak":"لِّسَعۡيِهَا رَاضِيَةٌ ۙ‏","words":[{"uthmani":"لِّسَعْيِهَا","indopak":"لِّسَعۡيِهَا","ur":"اپنی کوششوں پر","en":"With their effort"},{"uthmani":"رَاضِيَةٌۭ","indopak":"رَاضِيَةٌ ۙ‏","ur":"راضی ہوں گے","en":"satisfied"}],"tr":{"20":"With their effort [they are] satisfied","97":"اپنی کار گزاری پر خوش ہوں گے،","234":"اپنے اعمال (کی جزا )سے خوش دل"}},{"key":"88:10","n":10,"uthmani":"فِى جَنَّةٍ عَالِيَةٍ","indopak":"فِىۡ جَنَّةٍ عَالِيَةٍۙ‏","words":[{"uthmani":"فِى","indopak":"فِىۡ","ur":"میں","en":"In"},{"uthmani":"جَنَّةٍ","indopak":"جَنَّةٍ","ur":"جنت میں ہوں گے","en":"a garden"},{"uthmani":"عَالِيَةٍۢ","indopak":"عَالِيَةٍۙ‏","ur":"عالی مقام","en":"elevated"}],"tr":{"20":"In an elevated garden,","97":"عالی مقام جنت میں ہوں گے","234":"بہشت بریں میں"}},{"key":"88:11","n":11,"uthmani":"لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً","indopak":"لَّا تَسۡمَعُ فِيۡهَا لَاغِيَةً ؕ‏","words":[{"uthmani":"لَّا","indopak":"لَّا","ur":"نہ","en":"Not"},{"uthmani":"تَسْمَعُ","indopak":"تَسۡمَعُ","ur":"سنیں گے","en":"they will hear"},{"uthmani":"فِيهَا","indopak":"فِيۡهَا","ur":"اس میں","en":"therein"},{"uthmani":"لَـٰغِيَةًۭ","indopak":"لَاغِيَةً ؕ‏","ur":"کوئی لغو بات/ کوئی بےہودہ بات","en":"vain talk"}],"tr":{"20":"Wherein they will hear no unsuitable speech.","97":"کوئی بےہودہ بات وہاں نہ سُنیں گے،","234":"وہاں کسی طرح کی بکواس نہیں سنیں گے"}},{"key":"88:12","n":12,"uthmani":"فِيهَا عَيْنٌ جَارِيَةٌ","indopak":"فِيۡهَا عَيۡنٌ جَارِيَةٌ​ ۘ‏","words":[{"uthmani":"فِيهَا","indopak":"فِيۡهَا","ur":"اس میں","en":"Therein"},{"uthmani":"عَيْنٌۭ","indopak":"عَيۡنٌ","ur":"چشمے ہوں گے","en":"(will be) a spring"},{"uthmani":"جَارِيَةٌۭ","indopak":"جَارِيَةٌ​ ۘ‏","ur":"بہتے/رواں","en":"flowing"}],"tr":{"20":"Within it is a flowing spring.","97":"اُس میں چشمے رواں ہونگے","234":"اس میں چشمے بہ رہے ہوں گے"}},{"key":"88:13","n":13,"uthmani":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ","indopak":"فِيۡهَا سُرُرٌ مَّرۡفُوۡعَةٌ ۙ‏","words":[{"uthmani":"فِيهَا","indopak":"فِيۡهَا","ur":"اس میں","en":"Therein"},{"uthmani":"سُرُرٌۭ","indopak":"سُرُرٌ","ur":"مسندیں ہوں گی","en":"(will be) thrones"},{"uthmani":"مَّرْفُوعَةٌۭ","indopak":"مَّرۡفُوۡعَةٌ ۙ‏","ur":"بلند","en":"raised high"}],"tr":{"20":"Within it are couches raised high","97":"اُس کے اندر اونچی مسندیں ہوں گی","234":"وہاں تخت ہوں گے اونچے بچھے ہوئے"}},{"key":"88:14","n":14,"uthmani":"وَأَكْوَابٌ مَّوْضُوعَةٌ","indopak":"وَّاَكۡوَابٌ مَّوۡضُوۡعَةٌ ۙ‏","words":[{"uthmani":"وَأَكْوَابٌۭ","indopak":"وَّاَكۡوَابٌ","ur":"اور پیالے","en":"And cups"},{"uthmani":"مَّوْضُوعَةٌۭ","indopak":"مَّوۡضُوۡعَةٌ ۙ‏","ur":"رکھے ہوئے","en":"put in place"}],"tr":{"20":"And cups put in place","97":"ساغر رکھے ہوئے ہوں گے،","234":"اور آبخورے (قرینے سے) رکھے ہوئے"}},{"key":"88:15","n":15,"uthmani":"وَنَمَارِقُ مَصْفُوفَةٌ","indopak":"وَّنَمَارِقُ مَصۡفُوۡفَةٌ ۙ‏","words":[{"uthmani":"وَنَمَارِقُ","indopak":"وَّنَمَارِقُ","ur":"اور تکیے","en":"And cushions"},{"uthmani":"مَصْفُوفَةٌۭ","indopak":"مَصۡفُوۡفَةٌ ۙ‏","ur":"صف در صف","en":"lined up"}],"tr":{"20":"And cushions lined up","97":"گاؤ تکیوں کی قطاریں لگی ہوں گی","234":"اور گاؤ تکیے قطار کی قطار لگے ہوئے"}},{"key":"88:16","n":16,"uthmani":"وَزَرَابِىُّ مَبْثُوثَةٌ","indopak":"وَّزَرَابِىُّ مَبۡثُوۡثَةٌ ؕ‏","words":[{"uthmani":"وَزَرَابِىُّ","indopak":"وَّزَرَابِىُّ","ur":"اور مسندیں/ قالین","en":"And carpets"},{"uthmani":"مَبْثُوثَةٌ","indopak":"مَبۡثُوۡثَةٌ ؕ‏","ur":"بچھا کر رکھی ہوئیں/ پھیلی ہوئیں","en":"spread out"}],"tr":{"20":"And carpets spread around.","97":"اور نفیس فرش بچھے ہوئے ہوں گے","234":"اور نفیس مسندیں بچھی ہوئی"}},{"key":"88:17","n":17,"uthmani":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","indopak":"اَفَلَا يَنۡظُرُوۡنَ اِلَى الۡاِ بِلِ كَيۡفَ خُلِقَتۡ‏","words":[{"uthmani":"أَفَلَا","indopak":"اَفَلَا","ur":"کیا پھر وہ نہیں","en":"Then do not"},{"uthmani":"يَنظُرُونَ","indopak":"يَنۡظُرُوۡنَ","ur":"دیکھتے","en":"they look"},{"uthmani":"إِلَى","indopak":"اِلَى","ur":"طرف","en":"towards"},{"uthmani":"ٱلْإِبِلِ","indopak":"الۡاِ بِلِ","ur":"اونٹ کی","en":"the camels"},{"uthmani":"كَيْفَ","indopak":"كَيۡفَ","ur":"کس طرح","en":"how"},{"uthmani":"خُلِقَتْ","indopak":"خُلِقَتۡ‏","ur":"پیدا کیا گیا ہے","en":"they are created"}],"tr":{"20":"Then do they not look at the camels - how they are created?","97":"(یہ لوگ نہیں مانتے) تو کیا یہ اونٹوں کو نہیں دیکھتے کہ کیسے بنائے گئے؟","234":"یہ لوگ اونٹوں کی طرف نہیں دیکھتے کہ کیسے (عجیب )پیدا کیے گئے ہیں"}},{"key":"88:18","n":18,"uthmani":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","indopak":"وَاِلَى السَّمَآءِ كَيۡفَ رُفِعَتۡ‏","words":[{"uthmani":"وَإِلَى","indopak":"وَاِلَى","ur":"اور طرف","en":"And towards"},{"uthmani":"ٱلسَّمَآءِ","indopak":"السَّمَآءِ","ur":"آسمان (کی طرف)","en":"the sky"},{"uthmani":"كَيْفَ","indopak":"كَيۡفَ","ur":"کس طرح","en":"how"},{"uthmani":"رُفِعَتْ","indopak":"رُفِعَتۡ‏","ur":"اونچا اٹھایا گیا ہے","en":"it is raised"}],"tr":{"20":"And at the sky - how it is raised?","97":"آسمان کو نہیں دیکھتے کہ کیسے اٹھایا گیا؟","234":"اور آسمان کی طرف کہ کیسا بلند کیا گیا ہے"}},{"key":"88:19","n":19,"uthmani":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","indopak":"وَاِلَى الۡجِبَالِ كَيۡفَ نُصِبَتۡ‏","words":[{"uthmani":"وَإِلَى","indopak":"وَاِلَى","ur":"اور  طرف","en":"And towards"},{"uthmani":"ٱلْجِبَالِ","indopak":"الۡجِبَالِ","ur":"پہاڑوں (کی طرف)","en":"the mountains"},{"uthmani":"كَيْفَ","indopak":"كَيۡفَ","ur":"کیسے","en":"how"},{"uthmani":"نُصِبَتْ","indopak":"نُصِبَتۡ‏","ur":"نصب کردیئے گئے ہیں","en":"they are fixed"}],"tr":{"20":"And at the mountains - how they are erected?","97":"پہاڑوں کو نہیں دیکھتے کہ کیسے جمائے گئے؟","234":"اور پہاڑوں کی طرف کہ کس طرح کھڑے کیے گئے ہیں"}},{"key":"88:20","n":20,"uthmani":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","indopak":"وَاِلَى الۡاَرۡضِ كَيۡفَ سُطِحَتۡ‏","words":[{"uthmani":"وَإِلَى","indopak":"وَاِلَى","ur":"اور طرف","en":"And towards"},{"uthmani":"ٱلْأَرْضِ","indopak":"الۡاَرۡضِ","ur":"زمین (کی طرف)","en":"the earth"},{"uthmani":"كَيْفَ","indopak":"كَيۡفَ","ur":"کس طرح","en":"how"},{"uthmani":"سُطِحَتْ","indopak":"سُطِحَتۡ‏","ur":"بچھائی گئی ہے","en":"it is spread out"}],"tr":{"20":"And at the earth - how it is spread out?","97":"اور زمین کو نہیں دیکھتے کہ کیسے بچھائی گئی؟","234":"اور زمین کی طرف کہ کس طرح بچھائی گئی"}},{"key":"88:21","n":21,"uthmani":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ","indopak":"فَذَكِّرۡ ؕ اِنَّمَاۤ اَنۡتَ مُذَكِّرٌ ؕ‏","words":[{"uthmani":"فَذَكِّرْ","indopak":"فَذَكِّرۡؕ","ur":"پس نصیحت کرتے رہو","en":"So remind"},{"uthmani":"إِنَّمَآ","indopak":"اِنَّمَاۤ","ur":"بیشک","en":"only"},{"uthmani":"أَنتَ","indopak":"اَنۡتَ","ur":"آپ","en":"you"},{"uthmani":"مُذَكِّرٌۭ","indopak":"مُذَكِّرٌ ؕ‏","ur":"نصیحت کرنے والے ہیں","en":"(are) a reminder"}],"tr":{"20":"So remind, [O Muḥammad]; you are only a reminder.","97":"اچھا تو (اے نبیؐ) نصیحت کیے جاؤ، تم بس نصیحت ہی کرنے والے ہو","234":"تو تم نصیحت کرتے رہو کہ تم نصیحت کرنے والے ہی ہو"}},{"key":"88:22","n":22,"uthmani":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","indopak":"لَـسۡتَ عَلَيۡهِمۡ بِمُصَۜيۡطِرٍۙ‏","words":[{"uthmani":"لَّسْتَ","indopak":"لَـسۡتَ","ur":"نہیں آپ","en":"You are not"},{"uthmani":"عَلَيْهِم","indopak":"عَلَيۡهِمۡ","ur":"ان پر","en":"over them"},{"uthmani":"بِمُصَيْطِرٍ","indopak":"بِمُصَۜيۡطِرٍۙ‏","ur":"کوئی داروغہ","en":"a controller"}],"tr":{"20":"You are not over them a controller.","97":"کچھ ان پر جبر کرنے والے نہیں ہو۔","234":"تم ان پر داروغہ نہیں ہو"}},{"key":"88:23","n":23,"uthmani":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","indopak":"اِلَّا مَنۡ تَوَلّٰى وَكَفَرَۙ‏","words":[{"uthmani":"إِلَّا","indopak":"اِلَّا","ur":"مگر","en":"But"},{"uthmani":"مَن","indopak":"مَنۡ","ur":"وہ جو","en":"whoever"},{"uthmani":"تَوَلَّىٰ","indopak":"تَوَلّٰى","ur":"منہ موڑ جائے","en":"turns away"},{"uthmani":"وَكَفَرَ","indopak":"وَكَفَرَۙ‏","ur":"اور کفر کرے","en":"and disbelieves"}],"tr":{"20":"However, he who turns away and disbelieves","97":"البتہ جو شخص منہ موڑے گا اور انکار کرے گا","234":"ہاں جس نے منہ پھیرا اور نہ مانا"}},{"key":"88:24","n":24,"uthmani":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","indopak":"فَيُعَذِّبُهُ اللّٰهُ الۡعَذَابَ الۡاَكۡبَرَؕ‏","words":[{"uthmani":"فَيُعَذِّبُهُ","indopak":"فَيُعَذِّبُهُ","ur":"تو عذاب دے گا اس کو","en":"Then will punish him"},{"uthmani":"ٱللَّهُ","indopak":"اللّٰهُ","ur":"اللہ","en":"Allah"},{"uthmani":"ٱلْعَذَابَ","indopak":"الۡعَذَابَ","ur":"عذاب","en":"(with) the punishment"},{"uthmani":"ٱلْأَكْبَرَ","indopak":"الۡاَكۡبَرَؕ‏","ur":"سب سے بڑا","en":"greatest"}],"tr":{"20":"Then Allāh will punish him with the greatest punishment.","97":"تو اللہ اس کو بھاری سزا دے گا","234":"تو خدا اس کو بڑا عذاب دے گا"}},{"key":"88:25","n":25,"uthmani":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","indopak":"اِنَّ اِلَيۡنَاۤ اِيَابَهُمۡۙ‏","words":[{"uthmani":"إِنَّ","indopak":"اِنَّ","ur":"بیشک","en":"Indeed"},{"uthmani":"إِلَيْنَآ","indopak":"اِلَيۡنَاۤ","ur":"ہماری طرف","en":"to Us"},{"uthmani":"إِيَابَهُمْ","indopak":"اِيَابَهُمۡۙ‏","ur":"ان کا لوٹنا ہے","en":"(will be) their return"}],"tr":{"20":"Indeed, to Us is their return.","97":"اِن لوگوں کو پلٹنا ہماری طرف ہی ہے","234":"بےشک ان کو ہمارے پاس لوٹ کر آنا ہے"}},{"key":"88:26","n":26,"uthmani":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","indopak":"ثُمَّ اِنَّ عَلَيۡنَا حِسَابَهُمْ‏","words":[{"uthmani":"ثُمَّ","indopak":