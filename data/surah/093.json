{"id":93,"verses":[{"key":"93:1","n":1,"uthmani":" وَٱلضُّحَىٰ","indopak":"وَالضُّحٰىۙ‏","words":[{"uthmani":"وَٱلضُّحَىٰ","indopak":"وَالضُّحٰىۙ‏","ur":"قسم ہے روز روشن کی","en":"By the morning brightness"}],"tr":{"20":"By the morning brightness","97":"قسم ہے روزِ روشن کی","234":"آفتاب کی روشنی کی قسم"}},{"key":"93:2","n":2,"uthmani":"وَٱلَّيْلِ إِذَا سَجَىٰ","indopak":"وَالَّيۡلِ اِذَا سَجٰىۙ‏","words":[{"uthmani":"وَٱلَّيْلِ","indopak":"وَالَّيۡلِ","ur":"اور رات کی","en":"And the night"},{"uthmani":"إِذَا","indopak":"اِذَا","ur":"جب","en":"when"},{"uthmani":"سَجَىٰ","indopak":"سَجٰىۙ‏","ur":"وہ ڈھانپ لے","en":"it covers with darkness"}],"tr":{"20":"And [by] the night when it covers with darkness,","97":"اور رات کی جبکہ وہ سکون کے ساتھ طاری ہو جائے","234":"اور رات (کی تاریکی) کی جب چھا جائے"}},{"key":"93:3","n":3,"uthmani":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","indopak":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىؕ‏","words":[{"uthmani":"مَا","indopak":"مَا","ur":"نہیں","en":"Not"},{"uthmani":"وَدَّعَكَ","indopak":"وَدَّعَكَ","ur":"چھوڑا تجھ کو","en":"has forsaken you"},{"uthmani":"رَبُّكَ","indopak":"رَبُّكَ","ur":"تیرے رب نے","en":"your Lord"},{"uthmani":"وَمَا","indopak":"وَمَا","ur":"اور نہ","en":"and not"},{"uthmani":"قَلَىٰ","indopak":"قَلٰىؕ‏","ur":"وہ ناراض ہوا","en":"He is displeased"}],"tr":{"20":"Your Lord has not taken leave of you, [O Muḥammad], nor has He detested [you].","97":"(اے نبیؐ) تمہارے ربّ نے تم کو ہر گز نہیں چھوڑا اور نہ وہ ناراض ہوا۔","234":"کہ (اے محمدﷺ) تمہارے پروردگار نے نہ تو تم کو چھوڑا اور نہ( تم سے )ناراض ہوا"}},{"key":"93:4","n":4,"uthmani":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","indopak":"وَلَـلۡاٰخِرَةُ خَيۡرٌ لَّكَ مِنَ الۡاُوۡلٰىؕ‏","words":[{"uthmani":"وَلَلْـَٔاخِرَةُ","indopak":"وَلَـلۡاٰخِرَةُ","ur":"اور البتہ آخرت/ انجام","en":"And surely the Hereafter"},{"uthmani":"خَيْرٌۭ","indopak":"خَيۡرٌ","ur":"بہتر ہے","en":"(is) better"},{"uthmani":"لَّكَ","indopak":"لَّكَ","ur":"تیرے لئے","en":"for you"},{"uthmani":"مِنَ","indopak":"مِنَ","ur":"سے","en":"than"},{"uthmani":"ٱلْأُولَىٰ","indopak":"الۡاُوۡلٰىؕ‏","ur":"آغاز سے/ ابتداء سے","en":"the first"}],"tr":{"20":"And the Hereafter is better for you than the first [life].","97":"اور یقیناً تمہارے لیے بعد کا دور پہلے دور سے بہتر ہے،","234":"اور آخرت تمہارے لیے پہلی (حالت یعنی دنیا) سے کہیں بہتر ہے"}},{"key":"93:5","n":5,"uthmani":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","indopak":"وَلَسَوۡفَ يُعۡطِيۡكَ رَبُّكَ فَتَرۡضٰىؕ‏","words":[{"uthmani":"وَلَسَوْفَ","indopak":"وَلَسَوۡفَ","ur":"اور البتہ عنقریب","en":"And soon"},{"uthmani":"يُعْطِيكَ","indopak":"يُعۡطِيۡكَ","ur":"عطا کرے گا تجھ کو","en":"will give you"},{"uthmani":"رَبُّكَ","indopak":"رَبُّكَ","ur":"تیرا رب","en":"your Lord"},{"uthmani":"فَتَرْضَىٰٓ","indopak":"فَتَرۡضٰىؕ‏","ur":"تو تو راضی ہوجائے گا/ خوش ہوجائے گا","en":"then you will be satisfied"}],"tr":{"20":"And your Lord is going to give you, and you will be satisfied.","97":"اور عنقریب تمہارا ربّ تم کو اتنا دے گا کہ تم خوش ہو جاوٴ گے۔","234":"اور تمہیں پروردگار عنقریب وہ کچھ عطا فرمائے گا کہ تم خوش ہو جاؤ گے"}},{"key":"93:6","n":6,"uthmani":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","indopak":"اَلَمۡ يَجِدۡكَ يَتِيۡمًا فَاٰوٰى‏","words":[{"uthmani":"أَلَمْ","indopak":"اَلَمۡ","ur":"کیا نہیں","en":"Did not"},{"uthmani":"يَجِدْكَ","indopak":"يَجِدۡكَ","ur":"پایا تجھ کو","en":"He find you"},{"uthmani":"يَتِيمًۭا","indopak":"يَتِيۡمًا","ur":"یتیم","en":"an orphan"},{"uthmani":"فَـَٔاوَىٰ","indopak":"فَاٰوٰى‏","ur":"پھر اس نے ٹھکانہ فراہم کیا","en":"and give shelter"}],"tr":{"20":"Did He not find you an orphan and give [you] refuge?","97":"کیا اُس نے تم کو یتیم نہیں پایا اور پھر ٹھِکانا فراہم کیا؟","234":"بھلا اس نے تمہیں یتیم پا کر جگہ نہیں دی؟ (بےشک دی)"}},{"key":"93:7","n":7,"uthmani":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ","indopak":"وَوَجَدَكَ ضَآ لًّا فَهَدٰى‏","words":[{"uthmani":"وَوَجَدَكَ","indopak":"وَوَجَدَكَ","ur":"اور پایا تجھ کو","en":"And He found you"},{"uthmani":"ضَآلًّۭا","indopak":"ضَآ","ur":"راہ بھولا","en":"lost"},{"uthmani":"فَهَدَىٰ","indopak":"لًّا فَهَدٰى‏","ur":"تو اس نے ہدایت بخشی/ رہنمائی کی","en":"so He guided"}],"tr":{"20":"And He found you lost and guided [you],","97":"اور تمہیں ناواقفِ راہ پایا اور پھر ہدایت بخشی۔","234":"اور رستے سے ناواقف دیکھا تو رستہ دکھایا"}},{"key":"93:8","n":8,"uthmani":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ","indopak":"وَوَجَدَكَ عَآٮِٕلًا فَاَغۡنٰىؕ‏","words":[{"uthmani":"وَوَجَدَكَ","indopak":"وَوَجَدَكَ","ur":"اور پایا تجھ کو","en":"And He found you"},{"uthmani":"عَآئِلًۭا","indopak":"عَآٮِٕلًا","ur":"مفلس","en":"in need"},{"uthmani":"فَأَغْنَىٰ","indopak":"فَاَغۡنٰىؕ‏","ur":"تو اس نے غنی کردیا","en":"so He made self-sufficient"}],"tr":{"20":"And He found you poor and made [you] self-sufficient.","97":"اور تمہیں نادار پایا اور پھر مالدار کر دیا۔","234":"اور تنگ دست پایا تو غنی کر دیا"}},{"key":"93:9","n":9,"uthmani":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","indopak":"فَاَمَّا الۡيَتِيۡمَ فَلَا تَقۡهَرۡؕ‏","words":[{"uthmani":"فَأَمَّا","indopak":"فَاَمَّا","ur":"تو رہا","en":"So as for"},{"uthmani":"ٱلْيَتِيمَ","indopak":"الۡيَتِيۡمَ","ur":"یتیم","en":"the orphan"},{"uthmani":"فَلَا","indopak":"فَلَا","ur":"پس نہ","en":"then (do) not"},{"uthmani":"تَقْهَرْ","indopak":"تَقۡهَرۡؕ‏","ur":"سختی کر","en":"oppress"}],"tr":{"20":"So as for the orphan, do not oppress [him].","97":"لہٰذا یتیم پر سختی نہ کرو،","234":"تو تم بھی یتیم پر ستم نہ کرنا"}},{"key":"93:10","n":10,"uthmani":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","indopak":"وَاَمَّا السَّآٮِٕلَ فَلَا تَنۡهَرۡؕ‏","words":[{"uthmani":"وَأَمَّا","indopak":"وَاَمَّا","ur":"اور رہا","en":"And as for"},{"uthmani":"ٱلسَّآئِلَ","indopak":"السَّآٮِٕلَ","ur":"سوالی","en":"one who asks"},{"uthmani":"فَلَا","indopak":"فَلَا","ur":"پس نہ","en":"then (do) not"},{"uthmani":"تَنْهَرْ","indopak":"تَنۡهَرۡؕ‏","ur":"جھڑکو","en":"repel"}],"tr":{"20":"And as for the petitioner, do not repel [him].","97":"اور سائل کو نہ جھِڑکو،","234":"اور مانگنے والے کو جھڑکی نہ دینا"}},{"key":"93:11","n":11,"uthmani":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","indopak":"وَاَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ‏","words":[{"uthmani":"وَأَمَّا","indopak":"وَاَمَّا","ur":"اور رہی","en":"But as for"},{"uthmani":"بِنِعْمَةِ","indopak":"بِنِعۡمَةِ","ur":"نعمت","en":"(the) Favor"},{"uthmani":"رَبِّكَ","indopak":"رَبِّكَ","ur":"اپنے رب کی","en":"(of) your Lord"},{"uthmani":"فَحَدِّثْ","indopak":"فَحَدِّثۡ‏","ur":"پس بیان کرو","en":"narrate"}],"tr":{"20":"But as for the favor of your Lord, report [it].","97":"اور اپنے ربّ کی نعمت کا اظہار کرو۔","234":"اور اپنے پروردگار کی نعمتوں کا بیان کرتے رہنا"}}]}