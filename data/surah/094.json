{"id":94,"verses":[{"key":"94:1","n":1,"uthmani":" أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","indopak":"اَلَمۡ نَشۡرَحۡ لَـكَ صَدۡرَكَۙ‏","words":[{"uthmani":"أَلَمْ","indopak":"اَلَمۡ","ur":"کیا نہیں","en":"Have not"},{"uthmani":"نَشْرَحْ","indopak":"نَشۡرَحۡ","ur":"ہم نے کھول دیا","en":"We expanded"},{"uthmani":"لَكَ","indopak":"لَـكَ","ur":"تیرے لئے","en":"for you"},{"uthmani":"صَدْرَكَ","indopak":"صَدۡرَكَۙ‏","ur":"سینہ تیرا","en":"your breast"}],"tr":{"20":"Did We not expand for you, [O Muḥammad], your breast?","97":"(اے نبیؐ) کیا ہم نے تمہارا سینہ تمہارے لیے کھول نہیں دیا؟","234":"(اے محمدﷺ) کیا ہم نے تمہارا سینہ کھول نہیں دیا؟ (بےشک کھول دیا)"}},{"key":"94:2","n":2,"uthmani":"وَوَضَعْنَا عَنكَ وِزْرَكَ","indopak":"وَوَضَعۡنَا عَنۡكَ وِزۡرَكَۙ‏","words":[{"uthmani":"وَوَضَعْنَا","indopak":"وَوَضَعۡنَا","ur":"اور اٹھالیا ہم نے","en":"And We removed"},{"uthmani":"عَنكَ","indopak":"عَنۡكَ","ur":"تجھ سے","en":"from you"},{"uthmani":"وِزْرَكَ","indopak":"وِزۡرَكَۙ‏","ur":"بوجھ تیرا","en":"your burden"}],"tr":{"20":"And We removed from you your burden","97":"اور تم پر سے وہ بھاری بوجھ اتار دیا","234":"اور تم پر سے بوجھ بھی اتار دیا"}},{"key":"94:3","n":3,"uthmani":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","indopak":"الَّذِىۡۤ اَنۡقَضَ ظَهۡرَكَۙ‏","words":[{"uthmani":"ٱلَّذِىٓ","indopak":"الَّذِىۡۤ","ur":"وہ جس نے","en":"Which"},{"uthmani":"أَنقَضَ","indopak":"اَنۡقَضَ","ur":"توڑ دی تھی","en":"weighed upon"},{"uthmani":"ظَهْرَكَ","indopak":"ظَهۡرَكَۙ‏","ur":"تیری کمر","en":"your back"}],"tr":{"20":"Which had weighed upon your back","97":"جو تمہاری کمر توڑ ڈال رہا تھا۔","234":"جس نے تمہاری پیٹھ توڑ رکھی تھی"}},{"key":"94:4","n":4,"uthmani":"وَرَفَعْنَا لَكَ ذِكْرَكَ","indopak":"وَرَفَعۡنَا لَـكَ ذِكۡرَكَؕ‏","words":[{"uthmani":"وَرَفَعْنَا","indopak":"وَرَفَعۡنَا","ur":"اور بلند کیا ہم نے","en":"And We raised high"},{"uthmani":"لَكَ","indopak":"لَـكَ","ur":"تیرے لئے","en":"for you"},{"uthmani":"ذِكْرَكَ","indopak":"ذِكۡرَكَؕ‏","ur":"تیرا ذکر","en":"your reputation"}],"tr":{"20":"And raised high for you your repute.","97":"اور تمہاری خاطر تمہارے ذِکر کا آوازہ بلند کردیا۔","234":"اور تمہارا ذکر بلند کیا"}},{"key":"94:5","n":5,"uthmani":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","indopak":"فَاِنَّ مَعَ الۡعُسۡرِ يُسۡرًا ۙ‏","words":[{"uthmani":"فَإِنَّ","indopak":"فَاِنَّ","ur":"پس یقیناً","en":"So indeed"},{"uthmani":"مَعَ","indopak":"مَعَ","ur":"ساتھ","en":"with"},{"uthmani":"ٱلْعُسْرِ","indopak":"الۡعُسۡرِ","ur":"تنگی کے","en":"the hardship"},{"uthmani":"يُسْرًا","indopak":"يُسۡرًا ۙ‏","ur":"آسانی ہے","en":"(is) ease"}],"tr":{"20":"For indeed, with hardship [will be] ease [i.e., relief].","97":"پس حقیقت یہ ہے کہ تنگی کے ساتھ فراخی بھی ہے","234":"ہاں ہاں مشکل کے ساتھ آسانی بھی ہے"}},{"key":"94:6","n":6,"uthmani":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","indopak":"اِنَّ مَعَ الۡعُسۡرِ يُسۡرًا ؕ‏","words":[{"uthmani":"إِنَّ","indopak":"اِنَّ","ur":"بیشک","en":"Indeed"},{"uthmani":"مَعَ","indopak":"مَعَ","ur":"ساتھ","en":"with"},{"uthmani":"ٱلْعُسْرِ","indopak":"الۡعُسۡرِ","ur":"تنگی کے","en":"the hardship"},{"uthmani":"يُسْرًۭا","indopak":"يُسۡرًا ؕ‏","ur":"آسانی ہے","en":"(is) ease"}],"tr":{"20":"Indeed, with hardship [will be] ease.","97":"بے شک تنگی کے ساتھ فراخی بھی ہے۔","234":"(اور) بے شک مشکل کے ساتھ آسانی ہے"}},{"key":"94:7","n":7,"uthmani":"فَإِذَا فَرَغْتَ فَٱنصَبْ","indopak":"فَاِذَا فَرَغۡتَ فَانۡصَبۡۙ‏","words":[{"uthmani":"فَإِذَا","indopak":"فَاِذَا","ur":"پس جب","en":"So when"},{"uthmani":"فَرَغْتَ","indopak":"فَرَغۡتَ","ur":"تم فارغ ہوجاؤ","en":"you have finished"},{"uthmani":"فَٱنصَبْ","indopak":"فَانۡصَبۡۙ‏","ur":"تو محنت کرو/ کھڑے ہوجاؤ","en":"then labor hard"}],"tr":{"20":"So when you have finished [your duties], then stand up [for worship].","97":"لہٰذا جب تم فارغ ہو تو عبادت کی مشقت میں لگ جاؤ","234":"تو جب فارغ ہوا کرو تو (عبادت میں) محنت کیا کرو"}},{"key":"94:8","n":8,"uthmani":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","indopak":"وَاِلٰى رَبِّكَ فَارۡغَب‏","words":[{"uthmani":"وَإِلَىٰ","indopak":"وَاِلٰى","ur":"اور  طرف","en":"And to"},{"uthmani":"رَبِّكَ","indopak":"رَبِّكَ","ur":"اپنے رب کی","en":"your Lord"},{"uthmani":"فَٱرْغَب","indopak":"فَارۡغَب‏","ur":"پس راغب ہوجاؤ/ رغبت کرو","en":"turn your attention"}],"tr":{"20":"And to your Lord direct [your] longing.","97":"اور اپنے ربّ ہی کی طرف راغب ہو۔","234":"اور اپنے پروردگار کی طرف متوجہ ہو جایا کرو"}}]}