{"id":95,"verses":[{"key":"95:1","n":1,"uthmani":"وَٱلتِّينِ وَٱلزَّيْتُونِ","indopak":"وَالتِّيۡنِ وَالزَّيۡتُوۡنِۙ‏","words":[{"uthmani":"وَٱلتِّينِ","indopak":"وَالتِّيۡنِ","ur":"قسم ہے تین (انجیر) کی","en":"By the fig"},{"uthmani":"وَٱلزَّيْتُونِ","indopak":"وَالزَّيۡتُوۡنِۙ‏","ur":"اور زیتون کی","en":"and the olive"}],"tr":{"20":"By the fig and the olive","97":"قسم ہے انجیر اور زیتون کی","234":"انجیر کی قسم اور زیتون کی"}},{"key":"95:2","n":2,"uthmani":"وَطُورِ سِينِينَ","indopak":"وَطُوۡرِ سِيۡنِيۡنَۙ‏","words":[{"uthmani":"وَطُورِ","indopak":"وَطُوۡرِ","ur":"اور طور","en":"And (the) Mount"},{"uthmani":"سِينِينَ","indopak":"سِيۡنِيۡنَۙ‏","ur":"سینا کی","en":"Sinai"}],"tr":{"20":"And [by] Mount Sinai","97":"اور طورِ سینا","234":"اور طور سینین کی"}},{"key":"95:3","n":3,"uthmani":"وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","indopak":"وَهٰذَا الۡبَلَدِ الۡاَمِيۡنِۙ‏","words":[{"uthmani":"وَهَـٰذَا","indopak":"وَهٰذَا","ur":"اور قسم ہے اس","en":"And this"},{"uthmani":"ٱلْبَلَدِ","indopak":"الۡبَلَدِ","ur":"شہر کی","en":"[the] city"},{"uthmani":"ٱلْأَمِينِ","indopak":"الۡاَمِيۡنِۙ‏","ur":"جو پر امن ہے","en":"[the] secure"}],"tr":{"20":"And [by] this secure city [i.e., Makkah],","97":"اور اِس پرامن شہر (مکہ) کی","234":"اور اس امن والے شہر کی"}},{"key":"95:4","n":4,"uthmani":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ","indopak":"لَقَدۡ خَلَقۡنَا الۡاِنۡسَانَ فِىۡۤ اَحۡسَنِ تَقۡوِيۡمٍ‏","words":[{"uthmani":"لَقَدْ","indopak":"لَقَدۡ","ur":"البتہ تحقیق","en":"Indeed"},{"uthmani":"خَلَقْنَا","indopak":"خَلَقۡنَا","ur":"پیدا کیا ہم نے","en":"We created"},{"uthmani":"ٱلْإِنسَـٰنَ","indopak":"الۡاِنۡسَانَ","ur":"انسان کو","en":"man"},{"uthmani":"فِىٓ","indopak":"فِىۡۤ","ur":"میں","en":"in"},{"uthmani":"أَحْسَنِ","indopak":"اَحۡسَنِ","ur":"بہترین","en":"(the) best"},{"uthmani":"تَقْوِيمٍۢ","indopak":"تَقۡوِيۡمٍ‏","ur":"ساخت پر","en":"mould"}],"tr":{"20":"We have certainly created man in the best of stature;","97":"ہم نے انسان کو بہترین ساخت پر پیدا کیا،","234":"کہ ہم نے انسان کو بہت اچھی صورت میں پیدا کیا ہے"}},{"key":"95:5","n":5,"uthmani":"ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ","indopak":"ثُمَّ رَدَدۡنٰهُ اَسۡفَلَ سَافِلِيۡنَۙ‏","words":[{"uthmani":"ثُمَّ","indopak":"ثُمَّ","ur":"پھر","en":"Then"},{"uthmani":"رَدَدْنَـٰهُ","indopak":"رَدَدۡنٰهُ","ur":"پھیر دیا ہم نے اس کو","en":"We returned him"},{"uthmani":"أَسْفَلَ","indopak":"اَسۡفَلَ","ur":"سب سے زیادہ نچلا/نیچے","en":"(to the) lowest"},{"uthmani":"سَـٰفِلِينَ","indopak":"سَافِلِيۡنَۙ‏","ur":"نچلوں میں سے/ نیچوں میں سے","en":"(of the) low"}],"tr":{"20":"Then We return him to the lowest of the low,","97":"پھر اُسے اُلٹا پھیر کر ہم نے سب نِیچوں سے نیچ کر دیا،","234":"پھر (رفتہ رفتہ) اس (کی حالت) کو (بدل کر) پست سے پست کر دیا"}},{"key":"95:6","n":6,"uthmani":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","indopak":"اِلَّا الَّذِيۡنَ اٰمَنُوۡا وَعَمِلُوا الصّٰلِحٰتِ فَلَهُمۡ اَجۡرٌ غَيۡرُ مَمۡنُوۡنٍؕ‏","words":[{"uthmani":"إِلَّا","indopak":"اِلَّا","ur":"مگر","en":"Except"},{"uthmani":"ٱلَّذِينَ","indopak":"الَّذِيۡنَ","ur":"وہ لوگ","en":"those who"},{"uthmani":"ءَامَنُوا۟","indopak":"اٰمَنُوۡا","ur":"جو ایمان لائے","en":"believe"},{"uthmani":"وَعَمِلُوا۟","indopak":"وَعَمِلُوا","ur":"اور انہوں نے عمل کئے","en":"and do"},{"uthmani":"ٱلصَّـٰلِحَـٰتِ","indopak":"الصّٰلِحٰتِ","ur":"اچھے","en":"righteous deeds"},{"uthmani":"فَلَهُمْ","indopak":"فَلَهُمۡ","ur":"تو ان کے لئے","en":"then for them"},{"uthmani":"أَجْرٌ","indopak":"اَجۡرٌ","ur":"اجر ہے","en":"(is a) reward"},{"uthmani":"غَيْرُ","indopak":"غَيۡرُ","ur":"نہ","en":"never"},{"uthmani":"مَمْنُونٍۢ","indopak":"مَمۡنُوۡنٍؕ‏","ur":"ختم ہونے والا","en":"ending"}],"tr":{"20":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","97":"سوائے اُن لوگوں  کے جو ایمان لائے اور نیک عمل کرتے رہے  کہ ان کے لیے کبھی ختم نہ ہونے والا اجر ہے۔","234":"مگر جو لوگ ایمان لائے اور نیک عمل کرتے رہے انکے لیے بےانتہا اجر ہے"}},{"key":"95:7","n":7,"uthmani":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","indopak":"فَمَا يُكَذِّبُكَ بَعۡدُ بِالدِّيۡنِ‏","words":[{"uthmani":"فَمَا","indopak":"فَمَا","ur":"تو کون","en":"Then what"},{"uthmani":"يُكَذِّبُكَ","indopak":"يُكَذِّبُكَ","ur":"جھٹلائے گا تجھ کو","en":"causes you to deny"},{"uthmani":"بَعْدُ","indopak":"بَعۡدُ","ur":"بعد","en":"after (this)"},{"uthmani":"بِٱلدِّينِ","indopak":"بِالدِّيۡنِ‏","ur":"جزا سزا کے","en":"the judgment"}],"tr":{"20":"So what yet causes you to deny the Recompense?","97":"پس (اے نبیؐ)اِس کے بعد کون جزا و سزا کے معاملہ میں تم کو جھُٹلا سکتا ہے؟","234":"تو (اے آدم زاد) پھر تو جزا کے دن کو کیوں جھٹلاتا ہے؟"}},{"key":"95:8","n":8,"uthmani":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ","indopak":"اَلَيۡسَ اللّٰهُ بِاَحۡكَمِ الۡحٰكِمِيۡنَ‏","words":[{"uthmani":"أَلَيْسَ","indopak":"اَلَيۡسَ","ur":"کیا نہیں ہے","en":"Is not"},{"uthmani":"ٱللَّهُ","indopak":"اللّٰهُ","ur":"اللہ","en":"Allah"},{"uthmani":"بِأَحْكَمِ","indopak":"بِاَحۡكَمِ","ur":"سب فیصلہ کرنے والوں میں بڑھ کر","en":"(the) Most Just"},{"uthmani":"ٱلْحَـٰكِمِينَ","indopak":"الۡحٰكِمِيۡنَ‏","ur":"فیصلہ کرنے والا","en":"(of) the Judges"}],"tr":{"20":"Is not Allāh the most just of judges?","97":"کیا اللہ سب حاکموں سے بڑا حاکم نہیں ہے؟","234":"کیا خدا سب سے بڑا حاکم نہیں ہے؟"}}]}