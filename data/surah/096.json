{"id":96,"verses":[{"key":"96:1","n":1,"uthmani":" ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","indopak":"اِقۡرَاۡ بِاسۡمِ رَبِّكَ الَّذِىۡ خَلَقَ​ۚ‏","words":[{"uthmani":"ٱقْرَأْ","indopak":"اِقۡرَاۡ","ur":"پڑھو","en":"Read"},{"uthmani":"بِٱسْمِ","indopak":"بِاسۡمِ","ur":"ساتھ نام کے","en":"in (the) name"},{"uthmani":"رَبِّكَ","indopak":"رَبِّكَ","ur":"اپنے رب کے","en":"(of) your Lord"},{"uthmani":"ٱلَّذِى","indopak":"الَّذِىۡ","ur":"وہ جس نے","en":"the One Who"},{"uthmani":"خَلَقَ","indopak":"خَلَقَ​ۚ‏","ur":"پیدا کیا","en":"created "}],"tr":{"20":"Recite in the name of your Lord who created","97":"پڑھو  (اے نبیؐ) اپنے ربّ کے نام کے ساتھ  جس نے پیدا کیا،","234":"(اے محمدﷺ) اپنے پروردگار کا نام لے کر پڑھو جس نے (عالم کو) پیدا کیا"}},{"key":"96:2","n":2,"uthmani":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","indopak":"خَلَقَ الۡاِنۡسَانَ مِنۡ عَلَقٍ​ۚ‏","words":[{"uthmani":"خَلَقَ","indopak":"خَلَقَ","ur":"پیدا کی","en":"He created"},{"uthmani":"ٱلْإِنسَـٰنَ","indopak":"الۡاِنۡسَانَ","ur":"انسان کو","en":"man"},{"uthmani":"مِنْ","indopak":"مِنۡ","ur":"سے","en":"from"},{"uthmani":"عَلَقٍ","indopak":"عَلَقٍ​ۚ‏","ur":"جمے ہوئے خون (سے)","en":"a clinging substance"}],"tr":{"20":"Created man from a clinging substance.","97":"جمے ہوئے خون کے ایک لوتھڑے سے انسان کی تخلیق کی۔","234":"جس نے انسان کو خون کی پھٹکی سے بنایا"}},{"key":"96:3","n":3,"uthmani":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","indopak":"اِقۡرَاۡ وَرَبُّكَ الۡاَكۡرَمُۙ‏","words":[{"uthmani":"ٱقْرَأْ","indopak":"اِقۡرَاۡ","ur":"پڑھو","en":"Read"},{"uthmani":"وَرَبُّكَ","indopak":"وَرَبُّكَ","ur":"اور رب تیرا","en":"and your Lord"},{"uthmani":"ٱلْأَكْرَمُ","indopak":"الۡاَكۡرَمُۙ‏","ur":"بڑا کریم ہے","en":"(is) the Most Generous"}],"tr":{"20":"Recite, and your Lord is the most Generous -","97":"پڑھو، اور تمہارا رب بڑا کریم ہے","234":"پڑھو اور تمہارا پروردگار بڑا کریم ہے"}},{"key":"96:4","n":4,"uthmani":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","indopak":"الَّذِىۡ عَلَّمَ بِالۡقَلَمِۙ‏","words":[{"uthmani":"ٱلَّذِى","indopak":"الَّذِىۡ","ur":"وہ جس نے","en":"The One Who"},{"uthmani":"عَلَّمَ","indopak":"عَلَّمَ","ur":"سکھایا","en":"taught"},{"uthmani":"بِٱلْقَلَمِ","indopak":"بِالۡقَلَمِۙ‏","ur":"ساتھ قلم کے","en":"by the pen"}],"tr":{"20":"Who taught by the pen","97":"جس نے قلم کے ذریعہ سے علم سکھایا،","234":"جس نے قلم کے ذریعے سے علم سکھایا"}},{"key":"96:5","n":5,"uthmani":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","indopak":"عَلَّمَ الۡاِنۡسَانَ مَا لَمۡ يَعۡلَمۡؕ‏","words":[{"uthmani":"عَلَّمَ","indopak":"عَلَّمَ","ur":"سکھایا","en":"Taught"},{"uthmani":"ٱلْإِنسَـٰنَ","indopak":"الۡاِنۡسَانَ","ur":"انسان کو","en":"man"},{"uthmani":"مَا","indopak":"مَا","ur":"وہ جو","en":"what"},{"uthmani":"لَمْ","indopak":"لَمۡ","ur":"نہیں","en":"not"},{"uthmani":"يَعْلَمْ","indopak":"يَعۡلَمۡؕ‏","ur":"وہ جانتا تھا","en":"he knew"}],"tr":{"20":"Taught man that which he knew not.","97":"انسان کو وہ علم دیا جسے وہ نہ جانتا تھا۔","234":"اور انسان کو وہ باتیں سکھائیں جس کا اس کو علم نہ تھا"}},{"key":"96:6","n":6,"uthmani":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","indopak":"كَلَّاۤ اِنَّ الۡاِنۡسَانَ لَيَطۡغٰٓىۙ‏","words":[{"uthmani":"كَلَّآ","indopak":"كَلَّاۤ","ur":"ہرگز نہیں","en":"Nay"},{"uthmani":"إِنَّ","indopak":"اِنَّ","ur":"بیشک","en":"Indeed"},{"uthmani":"ٱلْإِنسَـٰنَ","indopak":"الۡاِنۡسَانَ","ur":"انسان","en":"man"},{"uthmani":"لَيَطْغَىٰٓ","indopak":"لَيَطۡغٰٓىۙ‏","ur":"البتہ سرکشی کرتا ہے","en":"surely transgresses"}],"tr":{"20":"No! [But] indeed, man transgresses","97":"ہرگز نہیں،  انسان سرکشی کرتا ہے","234":"مگر انسان سرکش ہو جاتا ہے"}},{"key":"96:7","n":7,"uthmani":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","indopak":"اَنۡ رَّاٰهُ اسۡتَغۡنٰىؕ‏","words":[{"uthmani":"أَن","indopak":"اَنۡ","ur":"کہ","en":"That"},{"uthmani":"رَّءَاهُ","indopak":"رَّاٰهُ","ur":"دیکھتا ہے خود کو","en":"he sees himself"},{"uthmani":"ٱسْتَغْنَىٰٓ","indopak":"اسۡتَغۡنٰىؕ‏","ur":"بےنیاز","en":"self-sufficient"}],"tr":{"20":"Because he sees himself self-sufficient.","97":"اِس بنا پر کہ وہ اپنے آپ کو بے نیاز دیکھتا ہے","234":"جب کہ اپنے تیئں غنی دیکھتا ہے"}},{"key":"96:8","n":8,"uthmani":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","indopak":"اِنَّ اِلٰى رَبِّكَ الرُّجۡعٰىؕ‏","words":[{"uthmani":"إِنَّ","indopak":"اِنَّ","ur":"بیشک","en":"Indeed"},{"uthmani":"إِلَىٰ","indopak":"اِلٰى","ur":"طرف","en":"to"},{"uthmani":"رَبِّكَ","indopak":"رَبِّكَ","ur":"تیرے رب کی","en":"your Lord"},{"uthmani":"ٱلرُّجْعَىٰٓ","indopak":"الرُّجۡعٰىؕ‏","ur":"پلٹنا ہے","en":"(is) the return"}],"tr":{"20":"Indeed, to your Lord is the return.","97":"(حالانکہ) پلٹنا یقیناً تیرے ربّ ہی کی طرف ہے۔","234":"کچھ شک نہیں کہ (اس کو) تمہارے پروردگار ہی کی طرف لوٹ کر جانا ہے"}},{"key":"96:9","n":9,"uthmani":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","indopak":"اَرَءَيۡتَ الَّذِىۡ يَنۡهٰىؕ‏","words":[{"uthmani":"أَرَءَيْتَ","indopak":"اَرَءَيۡتَ","ur":"کیا تم نے دیکھا","en":"Have you seen"},{"uthmani":"ٱلَّذِى","indopak":"الَّذِىۡ","ur":"اس شخص کو","en":"the one who"},{"uthmani":"يَنْهَىٰ","indopak":"يَنۡهٰىؕ‏","ur":"جو روکتا ہے","en":"forbids"}],"tr":{"20":"Have you seen the one who forbids","97":"تم نے دیکھا اُس شخص کو","234":"بھلا تم نے اس شخص کو دیکھا جو منع کرتا ہے"}},{"key":"96:10","n":10,"uthmani":"عَبْدًا إِذَا صَلَّىٰٓ","indopak":"عَبۡدًا اِذَا صَلّٰىؕ‏","words":[{"uthmani":"عَبْدًا","indopak":"عَبۡدًا","ur":"ایک بندے کو","en":"A slave"},{"uthmani":"إِذَا","indopak":"اِذَا","ur":"جب","en":"when"},{"uthmani":"صَلَّىٰٓ","indopak":"صَلّٰىؕ‏","ur":"وہ نماز پڑھتا ہے","en":"he prays"}],"tr":{"20":"A servant when he prays?","97":"جو ایک بندے کو منع کرتا ہے جبکہ  وہ نماز پڑھتا ہو؟","234":"(یعنی) ایک بندے کو جب وہ نماز پڑھنے لگتا ہے"}},{"key":"96:11","n":11,"uthmani":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","indopak":"اَرَءَيۡتَ اِنۡ كَانَ عَلَى الۡهُدٰٓىۙ‏","words":[{"uthmani":"أَرَءَيْتَ","indopak":"اَرَءَيۡتَ","ur":"کیا دیکھا تم نے","en":"Have you seen"},{"uthmani":"إِن","indopak":"اِنۡ","ur":"اگر","en":"if"},{"uthmani":"كَانَ","indopak":"كَانَ","ur":"ہو وہ","en":"he is"},{"uthmani":"عَلَى","indopak":"عَلَى","ur":"پر","en":"upon"},{"uthmani":"ٱلْهُدَىٰٓ","indopak":"الۡهُدٰٓىۙ‏","ur":"ہدایت (پر)","en":"[the] guidance"}],"tr":{"20":"Have you seen if he is upon guidance","97":"تمہارا کیا خیال ہے اگر (وہ بندہ) راہ راست پر ہو","234":"بھلا دیکھو تو اگر یہ راہِ راست پر ہو"}},{"key":"96:12","n":12,"uthmani":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","indopak":"اَوۡ اَمَرَ بِالتَّقۡوٰىۙ‏","words":[{"uthmani":"أَوْ","indopak":"اَوۡ","ur":"یا","en":"Or"},{"uthmani":"أَمَرَ","indopak":"اَمَرَ","ur":"اس نے حکم دیا","en":"he enjoins"},{"uthmani":"بِٱلتَّقْوَىٰٓ","indopak":"بِالتَّقۡوٰىۙ‏","ur":"تقویٰ کا","en":"[of the] righteousness"}],"tr":{"20":"Or enjoins righteousness?","97":"یا پرہیزگاری کی تلقین کرتا ہو؟","234":"یا پرہیز گاری کا حکم کرے (تو منع کرنا کیسا)"}},{"key":"96:13","n":13,"uthmani":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","indopak":"اَرَءَيۡتَ اِنۡ كَذَّبَ وَتَوَلّٰىؕ‏","words":[{"uthmani":"أَرَءَيْتَ","indopak":"اَرَءَيۡتَ","ur":"کیا غور کیا تم نے","en":"Have you seen"},{"uthmani":"إِن","indopak":"اِنۡ","ur":"اگر","en":"if"},{"uthmani":"كَذَّبَ","indopak":"كَذَّبَ","ur":"اس نے جھٹلایا","en":"he denies"},{"uthmani":"وَتَوَلَّىٰٓ","indopak":"وَتَوَلّٰىؕ‏","ur":"اور منہ موڑا","en":"and turns away"}],"tr":{"20":"Have you seen if he denies and turns away -","97":"تمہارا کیا خیال ہے اگر (یہ منع کرنے والا شخص حق کو) جھٹلاتا اور منہ موڑتا ہو؟","234":"اور دیکھو تو اگر اس نے دین حق کو جھٹلایا اور اس سے منہ موڑا (تو کیا ہوا)"}},{"key":"96:14","n":14,"uthmani":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","indopak":"اَلَمۡ يَعۡلَمۡ بِاَنَّ اللّٰهَ يَرٰىؕ‏","words":[{"uthmani":"أَلَمْ","indopak":"اَلَمۡ","ur":"کیا نہیں","en":"Does not"},{"uthmani":"يَعْلَم","indopak":"يَعۡلَمۡ","ur":"وہ جانتا","en":"he know"},{"uthmani":"بِأَنَّ","indopak":"بِاَنَّ","ur":"کہ بیشک","en":"that"},{"uthmani":"ٱللَّهَ","indopak":"اللّٰهَ","ur":"اللہ تعالیٰ","en":"Allah"},{"uthmani":"يَرَىٰ","indopak":"يَرٰىؕ‏","ur":"دیکھتا ہے","en":"sees"}],"tr":{"20":"Does he not know that Allāh sees?","97":"کیا وہ نہیں جانتا کہ اللہ دیکھ رہا ہے؟","234":"کیااس کو معلوم نہیں کہ خدا دیکھ رہا ہے"}},{"key":"96:15","n":15,"uthmani":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","indopak":"كَلَّا لَٮِٕنۡ لَّمۡ يَنۡتَهِ  ۙ لَنَسۡفَعًۢا بِالنَّاصِيَةِۙ‏","words":[{"uthmani":"كَلَّا","indopak":"كَلَّا","ur":"ہرگز نہیں","en":"Nay"},{"uthmani":"لَئِن","indopak":"لَٮِٕنۡ","ur":"البتہ اگر","en":"If"},{"uthmani":"لَّمْ","indopak":"لَّمۡ","ur":"نہ","en":"not"},{"uthmani":"يَنتَهِ","indopak":"يَنۡتَهِ  ۙ","ur":"وہ باز آیا","en":"he desists"},{"uthmani":"لَنَسْفَعًۢا","indopak":"لَنَسۡفَعًۢا","ur":"البتہ ہم ضرور کھینچیں گے/شدت کے ساتھ گھسیٹیں گے","en":"surely We will drag him"},{"uthmani":"بِٱلنَّاصِيَةِ","indopak":"بِالنَّاصِيَةِۙ‏","ur":"پیشانی کو","en":"by the forelock"}],"tr":{"20":"No! If he does not desist, We will surely drag him by the forelock","97":"ہرگز نہیں،  اگر وہ باز نہ آیا تو ہم اس کی پیشانی کے بال پکڑ کر اُسے کھینچیں گے","234":"دیکھو اگر وہ باز نہ آئے گا تو ہم (اس کی) پیشانی کے بال پکڑ گھسیٹیں گے"}},{"key":"96:16","n":16,"uthmani":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ","indopak":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ​ ۚ‏","words":[{"uthmani":"نَاصِيَةٍۢ","indopak":"نَاصِيَةٍ","ur":"پیشانی","en":"A forelock"},{"uthmani":"كَـٰذِبَةٍ","indopak":"كَاذِبَةٍ","ur":"جھوٹی","en":"lying"},{"uthmani":"خَاطِئَةٍۢ","indopak":"خَاطِئَةٍ​ ۚ‏","ur":"خطا کار کو","en":"sinful"}],"tr":{"20":"A lying, sinning forelock.","97":"اُس پیشانی کو جو جھُوٹی اور سخت خطاکار ہے۔","234":"یعنی اس جھوٹے خطاکار کی پیشانی کے بال"}},{"key":"96:17","n":17,"uthmani":"فَلْيَدْعُ نَادِيَهُۥ","indopak":"فَلۡيَدۡعُ نَادِيَهٗ ۙ‏","words":[{"uthmani":"فَلْيَدْعُ","indopak":"فَلۡيَدۡعُ","ur":"پس چاہیے کہ پکارے/ بلا لے","en":"Then let him call"},{"uthmani":"نَادِيَهُۥ","indopak":"نَادِيَهٗ ۙ‏","ur":"اپنے ہم نواؤں کو/ اپنے حامیوں کو","en":"his associates"}],"tr":{"20":"Then let him call his associates;","97":"وہ بُلالے اپنے حامیوں کی ٹولی کو،","234":"تو وہ اپنے یاروں کی مجلس کو بلالے"}},{"key":"96:18","n":18,"uthmani":"سَنَدْعُ ٱلزَّبَانِيَةَ","indopak":"سَنَدۡعُ الزَّبَانِيَةَ ۙ‏","words":[{"uthmani":"سَنَدْعُ","indopak":"سَنَدۡعُ","ur":"عنقریب ہم پکاریں گے","en":"We will call"},{"uthmani":"ٱلزَّبَانِيَةَ","indopak":"الزَّبَانِيَةَ ۙ‏","ur":"فرشتوں کو","en":"the Angels of Hell"}],"tr":{"20":"We will call the angels of Hell.","97":"ہم بھی عذاب کے فرشتوں کو بُلا لیں گے۔","234":"ہم بھی اپنے موکلانِ دوزخ کو بلا لیں گے"}},{"key":"96:19","n":19,"uthmani":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","indopak":"كَلَّا ؕ لَا تُطِعۡهُ وَاسۡجُدۡ وَاقۡتَرِبْ۩‏","words":[{"uthmani":"كَلَّا","indopak":"كَلَّاؕ","ur":"ہرگز نہیں","en":"Nay"},{"uthmani":"لَا","indopak":"لَا","ur":"نہ","en":"(Do) not"},{"uthmani":"تُطِعْهُ","indopak":"تُطِعۡهُ","ur":"تم اطاعت کرو اس کی","en":"obey him"},{"uthmani":"وَٱسْجُدْ","indopak":"وَاسۡجُدۡ","ur":"اور سجدہ کرو","en":"But prostrate"},{"uthmani":"وَٱقْتَرِب ۩","indopak":"وَاقۡتَرِبْ","ur":"اور قریب ہوجاؤ","en":"and draw near (to Allah)"}],"tr":{"20":"No! Do not obey him. But prostrate and draw near [to Allāh].","97":"ہرگزنہیں، اُس کی بات نہ مانو اور سجدہ کرو اور (اپنے ربّ کا) قرب حاصل کرو۔","234":"دیکھو اس کا کہا نہ ماننا اور قربِ (خدا) حاصل کرتے رہنا"}}]}