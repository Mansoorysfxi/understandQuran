{"id":100,"verses":[{"key":"100:1","n":1,"uthmani":" وَٱلْعَـٰدِيَـٰتِ ضَبْحًا","indopak":"وَالۡعٰدِيٰتِ ضَبۡحًا ۙ‏","words":[{"uthmani":"وَٱلْعَـٰدِيَـٰتِ","indopak":"وَالۡعٰدِيٰتِ","ur":"قسم ہے دوڑنے والیوں کی","en":"By the racers"},{"uthmani":"ضَبْحًۭا","indopak":"ضَبۡحًا ۙ‏","ur":"ہانپ کر","en":"panting"}],"tr":{"20":"By the racers, panting,","97":"قسم ہے اُن (گھوڑوں) کی جو پھُنکارے مارتے ہوئے دَوڑتے ہیں،","234":"ان سرپٹ دوڑنے والے گھوڑوں کی قسم جو ہانپ اٹھتےہیں"}},{"key":"100:2","n":2,"uthmani":"فَٱلْمُورِيَـٰتِ قَدْحًا","indopak":"فَالۡمُوۡرِيٰتِ قَدۡحًا ۙ‏","words":[{"uthmani":"فَٱلْمُورِيَـٰتِ","indopak":"فَالۡمُوۡرِيٰتِ","ur":"پھر قسم ہے آگ نکالنے والیوں کی","en":"And the producers of sparks"},{"uthmani":"قَدْحًۭا","indopak":"قَدۡحًا ۙ‏","ur":"جھاڑ کر","en":"striking"}],"tr":{"20":"And the producers of sparks [when] striking","97":"پھر (اپنی ٹاپوں سے) چِنگاریاں جھاڑتے ہیں،","234":"پھر (پتھروں پر نعل) مار کر آگ نکالتے ہیں"}},{"key":"100:3","n":3,"uthmani":"فَٱلْمُغِيرَٰتِ صُبْحًا","indopak":"فَالۡمُغِيۡرٰتِ صُبۡحًا ۙ‏","words":[{"uthmani":"فَٱلْمُغِيرَٰتِ","indopak":"فَالۡمُغِيۡرٰتِ","ur":"پھر قسم ہے چھاپہ مارنے والیوں کی","en":"And the chargers"},{"uthmani":"صُبْحًۭا","indopak":"صُبۡحًا ۙ‏","ur":"صبح کے وقت","en":"(at) dawn"}],"tr":{"20":"And the chargers at dawn,","97":"پھر صبح سویرے چھاپہ مارتے ہیں،","234":"پھر صبح کو چھاپہ مارتے ہیں"}},{"key":"100:4","n":4,"uthmani":"فَأَثَرْنَ بِهِۦ نَقْعًا","indopak":"فَاَثَرۡنَ بِهٖ نَقۡعًا ۙ‏","words":[{"uthmani":"فَأَثَرْنَ","indopak":"فَاَثَرۡنَ","ur":"پھر قسم ہے اڑانے والیاں","en":"Then raise"},{"uthmani":"بِهِۦ","indopak":"بِهٖ","ur":"ساتھ اس کے","en":"thereby"},{"uthmani":"نَقْعًۭا","indopak":"نَقۡعًا ۙ‏","ur":"غبار کو","en":"dust"}],"tr":{"20":"Stirring up thereby [clouds of] dust,","97":"پھر اس موقع پر گرد و غبار اڑاتے ہیں","234":"پھر اس میں گرد اٹھاتے ہیں"}},{"key":"100:5","n":5,"uthmani":"فَوَسَطْنَ بِهِۦ جَمْعًا","indopak":"فَوَسَطۡنَ بِهٖ جَمۡعًا ۙ‏","words":[{"uthmani":"فَوَسَطْنَ","indopak":"فَوَسَطۡنَ","ur":"پھر گھس جانے والیاں","en":"Then penetrate (in the) center"},{"uthmani":"بِهِۦ","indopak":"بِهٖ","ur":"ساتھ اس کے","en":"thereby"},{"uthmani":"جَمْعًا","indopak":"جَمۡعًا ۙ‏","ur":"جماعت میں/ گروہ میں","en":"collectively"}],"tr":{"20":"Arriving thereby in the center collectively,","97":"پھر اِسی حالت میں کسی مجمع کے اندر جا گھستے ہیں","234":"پھر اس وقت دشمن کی فوج میں جا گھستے ہیں"}},{"key":"100:6","n":6,"uthmani":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ","indopak":"اِنَّ الۡاِنۡسَانَ لِرَبِّهٖ لَـكَنُوۡدٌ ۚ‏","words":[{"uthmani":"إِنَّ","indopak":"اِنَّ","ur":"یقیناً","en":"Indeed"},{"uthmani":"ٱلْإِنسَـٰنَ","indopak":"الۡاِنۡسَانَ","ur":"انسان","en":"mankind"},{"uthmani":"لِرَبِّهِۦ","indopak":"لِرَبِّهٖ","ur":"اپنے رب کے لئے","en":"to his Lord"},{"uthmani":"لَكَنُودٌۭ","indopak":"لَـكَنُوۡدٌ ۚ‏","ur":"البتہ ناشکرا ہے","en":"(is) surely ungrateful"}],"tr":{"20":"Indeed mankind, to his Lord, is ungrateful.","97":"حقیقت یہ ہے کہ انسان اپنے ربّ کا بڑا ناشکرا ہے،","234":"کہ انسان اپنے پروردگار کا احسان ناشناس (اور ناشکرا) ہے"}},{"key":"100:7","n":7,"uthmani":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ","indopak":"وَاِنَّهٗ عَلٰى ذٰلِكَ لَشَهِيۡدٌ ۚ‏","words":[{"uthmani":"وَإِنَّهُۥ","indopak":"وَاِنَّهٗ","ur":"اور بیشک وہ","en":"And indeed, he"},{"uthmani":"عَلَىٰ","indopak":"عَلٰى","ur":"اوپر","en":"on"},{"uthmani":"ذَٰلِكَ","indopak":"ذٰلِكَ","ur":"اس کے","en":"that"},{"uthmani":"لَشَهِيدٌۭ","indopak":"لَشَهِيۡدٌ ۚ‏","ur":"البتہ گواہ ہے","en":"surely (is) a witness"}],"tr":{"20":"And indeed, he is to that a witness.","97":"اور وہ خود اِس پر گواہ ہے،","234":"اور وہ اس سے آگاہ بھی ہے"}},{"key":"100:8","n":8,"uthmani":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","indopak":"وَاِنَّهٗ لِحُبِّ الۡخَيۡرِ لَشَدِيۡدٌ ؕ‏","words":[{"uthmani":"وَإِنَّهُۥ","indopak":"وَاِنَّهٗ","ur":"اور بیشک وہ","en":"And indeed he"},{"uthmani":"لِحُبِّ","indopak":"لِحُبِّ","ur":"محبت میں","en":"in (the) love"},{"uthmani":"ٱلْخَيْرِ","indopak":"الۡخَيۡرِ","ur":"مال کی","en":"(of) wealth"},{"uthmani":"لَشَدِيدٌ","indopak":"لَشَدِيۡدٌ ؕ‏","ur":"البتہ سخت ہے","en":"(is) surely intense"}],"tr":{"20":"And indeed he is, in love of wealth, intense.","97":"اور وہ مال و دولت کی محبت میں بُری طرح مُبتلا ہے۔","234":"وہ تو مال سے سخت محبت کرنے والا ہے"}},{"key":"100:9","n":9,"uthmani":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","indopak":"اَفَلَا يَعۡلَمُ اِذَا بُعۡثِرَ مَا فِى الۡقُبُوۡرِۙ‏","words":[{"uthmani":"۞ أَفَلَا","indopak":"۞ اَفَلَا","ur":"کیا بھلا نہیں","en":"But does not"},{"uthmani":"يَعْلَمُ","indopak":"يَعۡلَمُ","ur":"وہ جانتا","en":"he know"},{"uthmani":"إِذَا","indopak":"اِذَا","ur":"جب","en":"when"},{"uthmani":"بُعْثِرَ","indopak":"بُعۡثِرَ","ur":"نکالا جائے گا","en":"will be scattered"},{"uthmani":"مَا","indopak":"مَا","ur":"جو","en":"what"},{"uthmani":"فِى","indopak":"فِى","ur":"میں","en":"(is) in"},{"uthmani":"ٱلْقُبُورِ","indopak":"الۡقُبُوۡرِۙ‏","ur":"قبروں میں ہے","en":"the graves"}],"tr":{"20":"But does he not know that when the contents of the graves are scattered","97":"تو کیا وہ اُس وقت کو نہیں جانتا جب قبروں میں جو کچھ (مدفون) ہے اُسے نکال لیا جائے گا،","234":"کیا وہ اس وقت کو نہیں جانتا کہ جو( مردے) قبروں میں ہیں وہ باہر نکال لیے جائیں گے"}},{"key":"100:10","n":10,"uthmani":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","indopak":"وَحُصِّلَ مَا فِى الصُّدُوۡرِۙ‏","words":[{"uthmani":"وَحُصِّلَ","indopak":"وَحُصِّلَ","ur":"اور حاصل کرلیا جائے گا","en":"And is made apparent"},{"uthmani":"مَا","indopak":"مَا","ur":"جو","en":"what"},{"uthmani":"فِى","indopak":"فِى","ur":"میں","en":"(is) in"},{"uthmani":"ٱلصُّدُورِ","indopak":"الصُّدُوۡرِۙ‏","ur":"سینوں میں ہے","en":"the breasts"}],"tr":{"20":"And that within the breasts is obtained,","97":"اور سینوں میں جو کچھ (مخفی) ہے اُسے بر آمد کر کے اس کی جانچ پڑتال کی جائے گی؟","234":"اور جو (بھید) دلوں میں ہیں وہ ظاہر کر دیئے جائیں گے"}},{"key":"100:11","n":11,"uthmani":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ","indopak":"اِنَّ رَبَّهُمۡ بِهِمۡ يَوۡمَٮِٕذٍ لَّخَبِيۡرٌ‏","words":[{"uthmani":"إِنَّ","indopak":"اِنَّ","ur":"بیشک","en":"Indeed"},{"uthmani":"رَبَّهُم","indopak":"رَبَّهُمۡ","ur":"رب ان کا","en":"their Lord"},{"uthmani":"بِهِمْ","indopak":"بِهِمۡ","ur":"ساتھ ان کے","en":"about them"},{"uthmani":"يَوْمَئِذٍۢ","indopak":"يَوۡمَٮِٕذٍ","ur":"اس دن","en":"that Day"},{"uthmani":"لَّخَبِيرٌۢ","indopak":"لَّخَبِيۡرٌ‏","ur":"البتہ باخبر ہے","en":"(is) surely All-Aware"}],"tr":{"20":"Indeed, their Lord with them, that Day, is [fully] Aware.","97":"یقیناً اُن کا ربّ اُس روز اُن سے خوب باخبر ہوگا۔","234":"بےشک ان کا پروردگار اس روز ان سے خوب واقف ہوگا"}}]}