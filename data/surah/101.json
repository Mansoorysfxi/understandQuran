{"id":101,"verses":[{"key":"101:1","n":1,"uthmani":" ٱلْقَارِعَةُ","indopak":"اَلۡقَارِعَةُ ۙ‏","words":[{"uthmani":"ٱلْقَارِعَةُ","indopak":"اَلۡقَارِعَةُ ۙ‏","ur":"عظیم حادثہ/ کھڑ کھڑانے والی","en":"The Striking Calamity"}],"tr":{"20":"The Striking Calamity -","97":"عظیم حادثہ!","234":"کھڑ کھڑانے والی"}},{"key":"101:2","n":2,"uthmani":"مَا ٱلْقَارِعَةُ","indopak":"مَا الۡقَارِعَةُ​ ۚ‏","words":[{"uthmani":"مَا","indopak":"مَا","ur":"کیا ہے","en":"What"},{"uthmani":"ٱلْقَارِعَةُ","indopak":"الۡقَارِعَةُ​ ۚ‏","ur":"وہ عظیم حادثہ/ کیا ہے وہ کھڑ کھڑانے والی","en":"(is) the Striking Calamity"}],"tr":{"20":"What is the Striking Calamity?","97":"کیا ہے وہ عظیم حادثہ؟","234":"کھڑ کھڑانے والی کیا ہے؟"}},{"key":"101:3","n":3,"uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","indopak":"وَمَاۤ اَدۡرٰٮكَ مَا الۡقَارِعَةُ ؕ‏","words":[{"uthmani":"وَمَآ","indopak":"وَمَاۤ","ur":"اور کیا چیز","en":"And what"},{"uthmani":"أَدْرَىٰكَ","indopak":"اَدۡرٰٮكَ","ur":"بتائے تجھ کو","en":"will make you know"},{"uthmani":"مَا","indopak":"مَا","ur":"کہ وہ کیا ہے","en":"what"},{"uthmani":"ٱلْقَارِعَةُ","indopak":"الۡقَارِعَةُ ؕ‏","ur":"کھڑ کھڑانے والی / وہ عظیم حادثہ کیا ہے","en":"(is) the Striking Calamity"}],"tr":{"20":"And what can make you know what is the Striking Calamity?","97":"تم کیا جانو کہ وہ عظیم حادثہ کیا ہے؟","234":"اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟"}},{"key":"101:4","n":4,"uthmani":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","indopak":"يَوۡمَ يَكُوۡنُ النَّاسُ كَالۡفَرَاشِ الۡمَبۡثُوۡثِۙ‏","words":[{"uthmani":"يَوْمَ","indopak":"يَوۡمَ","ur":"جس دن","en":"(The) Day"},{"uthmani":"يَكُونُ","indopak":"يَكُوۡنُ","ur":"ہوں گے","en":"will be"},{"uthmani":"ٱلنَّاسُ","indopak":"النَّاسُ","ur":"لوگ","en":"the mankind"},{"uthmani":"كَٱلْفَرَاشِ","indopak":"كَالۡفَرَاشِ","ur":"ٹڈیوں کی طرح","en":"like moths"},{"uthmani":"ٱلْمَبْثُوثِ","indopak":"الۡمَبۡثُوۡثِۙ‏","ur":"بکھرے ہوئے","en":"scattered"}],"tr":{"20":"It is the Day when people will be like moths, dispersed,","97":"وہ دن جب لوگ بکھرے ہوئے پروانوں کی طرح","234":"(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے"}},{"key":"101:5","n":5,"uthmani":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","indopak":"وَتَكُوۡنُ الۡجِبَالُ كَالۡعِهۡنِ الۡمَنۡفُوۡشِؕ‏","words":[{"uthmani":"وَتَكُونُ","indopak":"وَتَكُوۡنُ","ur":"اور ہوں گے","en":"And will be"},{"uthmani":"ٱلْجِبَالُ","indopak":"الۡجِبَالُ","ur":"پہاڑ","en":"the mountains"},{"uthmani":"كَٱلْعِهْنِ","indopak":"كَالۡعِهۡنِ","ur":"رنگین روئی کی طرح","en":"like wool"},{"uthmani":"ٱلْمَنفُوشِ","indopak":"الۡمَنۡفُوۡشِؕ‏","ur":"جو دھنی ہوئی ہو","en":"fluffed up"}],"tr":{"20":"And the mountains will be like wool, fluffed up.","97":"اور پہاڑ رنگ برنگ کے دُھنکے ہوئے اُون کی طرح ہوں گے۔","234":"اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون"}},{"key":"101:6","n":6,"uthmani":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","indopak":"فَاَمَّا مَنۡ ثَقُلَتۡ مَوَازِيۡنُهٗ ۙ‏","words":[{"uthmani":"فَأَمَّا","indopak":"فَاَمَّا","ur":"تو رہا","en":"Then as for"},{"uthmani":"مَن","indopak":"مَنۡ","ur":"وہ جس کے","en":"(him) whose"},{"uthmani":"ثَقُلَتْ","indopak":"ثَقُلَتۡ","ur":"بھاری ہوئے","en":"(are) heavy"},{"uthmani":"مَوَٰزِينُهُۥ","indopak":"مَوَازِيۡنُهٗ ۙ‏","ur":"پلڑے اس کے","en":"his scales"}],"tr":{"20":"Then as for one whose scales are heavy [with good deeds],","97":"پھر  جس کے پلڑے بھاری ہوں گے","234":"تو جس کے (اعمال کے) وزن بھاری نکلیں گے"}},{"key":"101:7","n":7,"uthmani":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","indopak":"فَهُوَ فِىۡ عِيۡشَةٍ رَّاضِيَةٍ ؕ‏","words":[{"uthmani":"فَهُوَ","indopak":"فَهُوَ","ur":"تو وہ","en":"Then he"},{"uthmani":"فِى","indopak":"فِىۡ","ur":"میں","en":"(will be) in"},{"uthmani":"عِيشَةٍۢ","indopak":"عِيۡشَةٍ","ur":"زندگی میں ہوگا","en":"a life"},{"uthmani":"رَّاضِيَةٍۢ","indopak":"رَّاضِيَةٍ ؕ‏","ur":"پسندیدہ","en":"pleasant"}],"tr":{"20":"He will be in a pleasant life.","97":"وہ دل پسند عیش میں ہوگا","234":"وہ دل پسند عیش میں ہو گا"}},{"key":"101:8","n":8,"uthmani":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","indopak":"وَاَمَّا مَنۡ خَفَّتۡ مَوَازِيۡنُهٗ ۙ‏","words":[{"uthmani":"وَأَمَّا","indopak":"وَاَمَّا","ur":"اور رہا","en":"But as for"},{"uthmani":"مَنْ","indopak":"مَنۡ","ur":"وہ جس کے","en":"(him) whose"},{"uthmani":"خَفَّتْ","indopak":"خَفَّتۡ","ur":"ہلکے ہوئے","en":"(are) light"},{"uthmani":"مَوَٰزِينُهُۥ","indopak":"مَوَازِيۡنُهٗ ۙ‏","ur":"پلڑے اس کے/ اوزان اس کے/ وزن اس کے","en":"his scales"}],"tr":{"20":"But as for one whose scales are light,","97":"اور جس کے پلڑے ہلکے ہوں گے","234":"اور جس کے وزن ہلکے نکلیں گے"}},{"key":"101:9","n":9,"uthmani":"فَأُمُّهُۥ هَاوِيَةٌ","indopak":"فَاُمُّهٗ هَاوِيَةٌ ؕ‏","words":[{"uthmani":"فَأُمُّهُۥ","indopak":"فَاُمُّهٗ","ur":"تو اس کی ماں","en":"His abode"},{"uthmani":"هَاوِيَةٌۭ","indopak":"هَاوِيَةٌ ؕ‏","ur":"ہاویہ ہوگی (جہنم)","en":"(will be the) Pit"}],"tr":{"20":"His refuge will be an abyss.","97":"اس کی جائے قرار گہری کھائی ہوگی۔","234":"اس کا مرجع ہاویہ ہے"}},{"key":"101:10","n":10,"uthmani":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","indopak":"وَمَاۤ اَدۡرٰٮكَ مَا هِيَهۡ ؕ‏","words":[{"uthmani":"وَمَآ","indopak":"وَمَاۤ","ur":"اور کیا چیز","en":"And what"},{"uthmani":"أَدْرَىٰكَ","indopak":"اَدۡرٰٮكَ","ur":"بتائے تجھ کو","en":"will make you know"},{"uthmani":"مَا","indopak":"مَا","ur":"کیا","en":"what"},{"uthmani":"هِيَهْ","indopak":"هِيَهۡ ؕ‏","ur":"وہ  ہے","en":"it is"}],"tr":{"20":"And what can make you know what that is?","97":"اور تمہیں کیا خبر کہ وہ کیا چیز ہے؟","234":"اور تم کیا سمجھے کہ ہاویہ کیا چیز ہے؟"}},{"key":"101:11","n":11,"uthmani":"نَارٌ حَامِيَةٌۢ","indopak":"نَارٌ حَامِيَةٌ‏","words":[{"uthmani":"نَارٌ","indopak":"نَارٌ","ur":"آگ ہے","en":"A Fire"},{"uthmani":"حَامِيَةٌۢ","indopak":"حَامِيَةٌ‏","ur":"بھڑکتی ہوئی/دہکتی ہوئی","en":"intensely hot"}],"tr":{"20":"It is a Fire, intensely hot.","97":"بھڑکتی ہوئی آگ۔","234":"دہکتی ہوئی آگ ہے"}}]}