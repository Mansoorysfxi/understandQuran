{"id":104,"verses":[{"key":"104:1","n":1,"uthmani":" وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","indopak":"وَيۡلٌ لِّـكُلِّ هُمَزَةٍ لُّمَزَةِ ۙ‏","words":[{"uthmani":"وَيْلٌۭ","indopak":"وَيۡلٌ","ur":"ہلاکت ہے","en":"Woe"},{"uthmani":"لِّكُلِّ","indopak":"لِّـكُلِّ","ur":"واسطے ہر اس شخص کے","en":"to every"},{"uthmani":"هُمَزَةٍۢ","indopak":"هُمَزَةٍ","ur":"جو منہ پر عیب لگاتا ہے","en":"slanderer"},{"uthmani":"لُّمَزَةٍ","indopak":"لُّمَزَةِ ۙ‏","ur":"پیٹھ پیچھے برائیاں کرتا ہے","en":"backbiter"}],"tr":{"20":"Woe to every scorner and mocker","97":"تباہی ہے ہر اُس شخص کے لیے جو (مُنہ در مُنہ) لوگوں پر طعن اور (پیٹھ پیچھے) بُرائیاں کرنے کا خوگر ہے۔","234":"ہر طعن آمیز اشارتیں کرنے والے چغل خور کی خرابی ہے"}},{"key":"104:2","n":2,"uthmani":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","indopak":"اۨلَّذِىۡ جَمَعَ مَالًا وَّعَدَّدَهٗ ۙ‏","words":[{"uthmani":"ٱلَّذِى","indopak":"اۨلَّذِىۡ","ur":"وہ جس نے","en":"The one who"},{"uthmani":"جَمَعَ","indopak":"جَمَعَ","ur":"جمع کیا","en":"collects"},{"uthmani":"مَالًۭا","indopak":"مَالًا","ur":"مال","en":"wealth"},{"uthmani":"وَعَدَّدَهُۥ","indopak":"وَّعَدَّدَهٗ ۙ‏","ur":"اور گن گن کر رکھا اس کو","en":"and counts it"}],"tr":{"20":"Who collects wealth and [continuously] counts it.","97":"جس نے مال جمع کیا اور اُسے گِن گِن کر رکھا۔","234":"جو مال جمع کرتا اور اس کو گن گن کر رکھتا ہے"}},{"key":"104:3","n":3,"uthmani":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","indopak":"يَحۡسَبُ اَنَّ مَالَهٗۤ اَخۡلَدَهٗ​ ۚ‏","words":[{"uthmani":"يَحْسَبُ","indopak":"يَحۡسَبُ","ur":"وہ سمجھتا ہے","en":"Thinking"},{"uthmani":"أَنَّ","indopak":"اَنَّ","ur":"کہ بیشک","en":"that"},{"uthmani":"مَالَهُۥٓ","indopak":"مَالَهٗۤ","ur":"اس کا مال","en":"his wealth"},{"uthmani":"أَخْلَدَهُۥ","indopak":"اَخۡلَدَهٗ​ ۚ‏","ur":"ہمیشہ اس کے پاس رہے گا","en":"will make him immortal"}],"tr":{"20":"He thinks that his wealth will make him immortal.","97":"وہ سمجھتا ہے کہ اُس کا مال ہمیشہ اُس کے پاس رہے گا۔","234":"(اور) خیال کرتا ہے کہ اس کا مال اس کی ہمیشہ کی زندگی کا موجب ہو گا"}},{"key":"104:4","n":4,"uthmani":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","indopak":"كَلَّا​ لَيُنۡۢبَذَنَّ فِى الۡحُطَمَةِ  ۖ‏","words":[{"uthmani":"كَلَّا ۖ","indopak":"كَلَّا​","ur":"ہرگز نہیں","en":"Nay"},{"uthmani":"لَيُنۢبَذَنَّ","indopak":"لَيُنۡۢبَذَنَّ","ur":"البتہ ضرور ڈالا جائے گا","en":"Surely he will be thrown"},{"uthmani":"فِى","indopak":"فِى","ur":"میں","en":"in"},{"uthmani":"ٱلْحُطَمَةِ","indopak":"الۡحُطَمَةِ  ۖ‏","ur":"حطمہ (میں)","en":"the Crusher"}],"tr":{"20":"No! He will surely be thrown into the Crusher.","97":"ہرگز نہیں، وہ شخص تو چَکنا چُور کر دینے والی  جگہ میں پھینک دیا جائے گا۔","234":"ہر گز نہیں وہ ضرور حطمہ میں ڈالا جائے گا"}},{"key":"104:5","n":5,"uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","indopak":"وَمَاۤ اَدۡرٰٮكَ مَا الۡحُطَمَةُ ؕ‏","words":[{"uthmani":"وَمَآ","indopak":"وَمَاۤ","ur":"اور کیا چیز","en":"And what"},{"uthmani":"أَدْرَىٰكَ","indopak":"اَدۡرٰٮكَ","ur":"بتائے تجھ کو","en":"will make you know"},{"uthmani":"مَا","indopak":"مَا","ur":"کیا ہے","en":"what"},{"uthmani":"ٱلْحُطَمَةُ","indopak":"الۡحُطَمَةُ ؕ‏","ur":"حطمہ","en":"the Crusher (is)"}],"tr":{"20":"And what can make you know what is the Crusher?","97":"اور تم کیا جانو کہ کیا ہے وہ چکنا چور کر دینے والی جگہ؟","234":"اور تم کیا سمجھے حطمہ کیا ہے؟"}},{"key":"104:6","n":6,"uthmani":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","indopak":"نَارُ اللّٰهِ الۡمُوۡقَدَةُ ۙ‏","words":[{"uthmani":"نَارُ","indopak":"نَارُ","ur":"آگ","en":"A Fire"},{"uthmani":"ٱللَّهِ","indopak":"اللّٰهِ","ur":"اللہ کی","en":"Allah"},{"uthmani":"ٱلْمُوقَدَةُ","indopak":"الۡمُوۡقَدَةُ ۙ‏","ur":"سلگائی ہوئی","en":"kindled"}],"tr":{"20":"It is the fire of Allāh, [eternally] fueled,","97":"اللہ کی آگ،  خُوب بھڑکائی ہوئی","234":"وہ خدا کی بھڑکائی ہوئی آگ ہے"}},{"key":"104:7","n":7,"uthmani":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","indopak":"الَّتِىۡ تَطَّلِعُ عَلَى الۡاَفۡـــِٕدَةِ ؕ‏","words":[{"uthmani":"ٱلَّتِى","indopak":"الَّتِىۡ","ur":"وہ جو","en":"Which"},{"uthmani":"تَطَّلِعُ","indopak":"تَطَّلِعُ","ur":"چڑھ آتی ہے","en":"mounts up"},{"uthmani":"عَلَى","indopak":"عَلَى","ur":"پر","en":"to"},{"uthmani":"ٱلْأَفْـِٔدَةِ","indopak":"الۡاَفۡـــِٕدَةِ ؕ‏","ur":"دلوں (پر)","en":"the hearts"}],"tr":{"20":"Which mounts directed at the hearts.","97":"جو دلوں تک پہنچے گی۔","234":"جو دلوں پر جا لپٹے گی"}},{"key":"104:8","n":8,"uthmani":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","indopak":"اِنَّهَا عَلَيۡهِمۡ مُّؤۡصَدَةٌ ۙ‏","words":[{"uthmani":"إِنَّهَا","indopak":"اِنَّهَا","ur":"بیشک وہ","en":"Indeed, it"},{"uthmani":"عَلَيْهِم","indopak":"عَلَيۡهِمۡ","ur":"ان پر","en":"(will be) upon them"},{"uthmani":"مُّؤْصَدَةٌۭ","indopak":"مُّؤۡصَدَةٌ ۙ‏","ur":"بند کی ہوئی ہے","en":"closed over"}],"tr":{"20":"Indeed, it [i.e., Hellfire] will be closed down upon them","97":"وہ اُن پر ڈھانک کر بند کر دی جائے گی","234":"(اور) وہ اس میں بند کر دیئے جائیں گے"}},{"key":"104:9","n":9,"uthmani":"فِى عَمَدٍ مُّمَدَّدَةٍۭ","indopak":"فِىۡ عَمَدٍ مُّمَدَّدَةٍ‏","words":[{"uthmani":"فِى","indopak":"فِىۡ","ur":"میں","en":"In"},{"uthmani":"عَمَدٍۢ","indopak":"عَمَدٍ","ur":"ستونوں (میں)","en":"columns"},{"uthmani":"مُّمَدَّدَةٍۭ","indopak":"مُّمَدَّدَةٍ‏","ur":"لمبے لمبے","en":"extended"}],"tr":{"20":"In extended columns.","97":"(اِس حالت میں کہ وہ) اُونچے اُونچے ستونوں میں (گھِرے ہوئے ہوں گے)۔","234":"(یعنی آگ کے) لمبے لمبے ستونوں میں"}}]}