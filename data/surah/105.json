{"id":105,"verses":[{"key":"105:1","n":1,"uthmani":" أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ","indopak":"اَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِاَصۡحٰبِ الۡفِيۡلِؕ‏","words":[{"uthmani":"أَلَمْ","indopak":"اَلَمۡ","ur":"کیا نہیں","en":"Have not"},{"uthmani":"تَرَ","indopak":"تَرَ","ur":"تم نے دیکھا","en":"you seen"},{"uthmani":"كَيْفَ","indopak":"كَيۡفَ","ur":"کس طرح","en":"how"},{"uthmani":"فَعَلَ","indopak":"فَعَلَ","ur":"کیا","en":"dealt"},{"uthmani":"رَبُّكَ","indopak":"رَبُّكَ","ur":"تیرے رب نے","en":"your Lord"},{"uthmani":"بِأَصْحَـٰبِ","indopak":"بِاَصۡحٰبِ","ur":"والوں کے ساتھ","en":"with (the) Companions"},{"uthmani":"ٱلْفِيلِ","indopak":"الۡفِيۡلِؕ‏","ur":"ہاتھی (والوں کےساتھ)","en":"(of the) Elephant"}],"tr":{"20":"Have you not considered, [O Muḥammad], how your Lord dealt with the companions of the elephant?","97":"تم نے دیکھا نہیں  کہ تمہارے ربّ نے ہاتھی والوں کے ساتھ کیا کیا؟","234":"کیا تم نے نہیں دیکھا کہ تمہارے پروردگار نے ہاتھی والوں کے ساتھ کیا کیا"}},{"key":"105:2","n":2,"uthmani":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ","indopak":"اَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِىۡ تَضۡلِيۡلٍۙ‏","words":[{"uthmani":"أَلَمْ","indopak":"اَلَمۡ","ur":"کیا نہیں","en":"Did not"},{"uthmani":"يَجْعَلْ","indopak":"يَجۡعَلۡ","ur":"کردیا","en":"He make"},{"uthmani":"كَيْدَهُمْ","indopak":"كَيۡدَهُمۡ","ur":"ان کی چال کو","en":"their plan"},{"uthmani":"فِى","indopak":"فِىۡ","ur":"میں","en":"go"},{"uthmani":"تَضْلِيلٍۢ","indopak":"تَضۡلِيۡلٍۙ‏","ur":"گمراہی میں (اکارت)","en":"astray"}],"tr":{"20":"Did He not make their plan into misguidance?","97":"کیا اُس نے اُن کی تدبیر  کو اَکارَت نہیں کر دیا؟","234":"کیا ان کا داؤں غلط نہیں کیا؟ (گیا)"}},{"key":"105:3","n":3,"uthmani":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","indopak":"وَّاَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا اَبَابِيۡلَۙ‏","words":[{"uthmani":"وَأَرْسَلَ","indopak":"وَّاَرۡسَلَ","ur":"اور بھیجے","en":"And He sent"},{"uthmani":"عَلَيْهِمْ","indopak":"عَلَيۡهِمۡ","ur":"ان پر","en":"against them"},{"uthmani":"طَيْرًا","indopak":"طَيۡرًا","ur":"پرندے","en":"birds"},{"uthmani":"أَبَابِيلَ","indopak":"اَبَابِيۡلَۙ‏","ur":"جھنڈ کے جھنڈ","en":"(in) flocks"}],"tr":{"20":"And He sent against them birds in flocks,","97":"اور اُن پر پرندوں کے جھُنڈ کے جھُنڈ بھیج دیے","234":"اور ان پر جھلڑ کے جھلڑ جانور بھیجے"}},{"key":"105:4","n":4,"uthmani":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ","indopak":"تَرۡمِيۡهِمۡ بِحِجَارَةٍ مِّنۡ سِجِّيۡلٍۙ‏","words":[{"uthmani":"تَرْمِيهِم","indopak":"تَرۡمِيۡهِمۡ","ur":"پھینکتے تھے ان پر","en":"Striking them"},{"uthmani":"بِحِجَارَةٍۢ","indopak":"بِحِجَارَةٍ","ur":"پتھر","en":"with stones"},{"uthmani":"مِّن","indopak":"مِّنۡ","ur":"کے","en":"of"},{"uthmani":"سِجِّيلٍۢ","indopak":"سِجِّيۡلٍۙ‏","ur":"کنکر کی قسم کے","en":"baked clay"}],"tr":{"20":"Striking them with stones of hard clay,","97":"جو اُن پر پکّی ہوئی مَٹّی کے پتھر پھینک رہے تھے،","234":"جو ان پر کھنگر کی پتھریاں پھینکتے تھے"}},{"key":"105:5","n":5,"uthmani":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ","indopak":"فَجَعَلَهُمۡ كَعَصۡفٍ مَّاۡكُوۡلٍ‏","words":[{"uthmani":"فَجَعَلَهُمْ","indopak":"فَجَعَلَهُمۡ","ur":"تو کردیا ان کو","en":"Then He made them"},{"uthmani":"كَعَصْفٍۢ","indopak":"كَعَصۡفٍ","ur":"بھوسے کی طرح","en":"like straw"},{"uthmani":"مَّأْكُولٍۭ","indopak":"مَّاۡكُوۡلٍ‏","ur":"جو کھایا ہوا ہو","en":"eaten up"}],"tr":{"20":"And He made them like eaten straw.","97":"پھر اُن کا یہ حال کر دیا  جیسے جانوروں کا کھایا ہوا بھوسا۔","234":"تو ان کو ایسا کر دیا جیسے کھایا ہوا بھس"}}]}