{"id":107,"verses":[{"key":"107:1","n":1,"uthmani":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","indopak":"اَرَءَيۡتَ الَّذِىۡ يُكَذِّبُ بِالدِّيۡنِؕ‏","words":[{"uthmani":"أَرَءَيْتَ","indopak":"اَرَءَيۡتَ","ur":"کیا دیکھا تم نے","en":"Have you seen"},{"uthmani":"ٱلَّذِى","indopak":"الَّذِىۡ","ur":"اس شخص کو","en":"the one who"},{"uthmani":"يُكَذِّبُ","indopak":"يُكَذِّبُ","ur":"جو جھٹلاتا ہے","en":"denies"},{"uthmani":"بِٱلدِّينِ","indopak":"بِالدِّيۡنِؕ‏","ur":"جزا و سزا کو","en":"the Judgment"}],"tr":{"20":"Have you seen the one who denies the Recompense?","97":"تم نے دیکھا  اُس شخص کو جو آخرت کی جزا و سزا  کو جھُٹلاتا ہے؟","234":"بھلا تم نے اس شخص کو دیکھا جو (روزِ) جزا کو جھٹلاتا ہے؟"}},{"key":"107:2","n":2,"uthmani":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","indopak":"فَذٰلِكَ الَّذِىۡ يَدُعُّ الۡيَتِيۡمَۙ‏","words":[{"uthmani":"فَذَٰلِكَ","indopak":"فَذٰلِكَ","ur":"پس یہ وہ","en":"Then that"},{"uthmani":"ٱلَّذِى","indopak":"الَّذِىۡ","ur":"شخص ہے","en":"(is) the one who"},{"uthmani":"يَدُعُّ","indopak":"يَدُعُّ","ur":"جو دھکے دیتا ہے","en":"repulses"},{"uthmani":"ٱلْيَتِيمَ","indopak":"الۡيَتِيۡمَۙ‏","ur":"یتیم کو","en":"the orphan"}],"tr":{"20":"For that is the one who drives away the orphan","97":"وہی تو ہے  جو یتیم کو دھکّے دیتا ہے،","234":"یہ وہی (بدبخت) ہے، جو یتیم کو دھکے دیتا ہے"}},{"key":"107:3","n":3,"uthmani":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","indopak":"وَ لَا يَحُضُّ عَلٰى طَعَامِ الۡمِسۡكِيۡنِؕ‏","words":[{"uthmani":"وَلَا","indopak":"وَ","ur":"اور نہیں","en":"And (does) not"},{"uthmani":"يَحُضُّ","indopak":"لَا","ur":"رغبت دلاتا","en":"feel the urge"},{"uthmani":"عَلَىٰ","indopak":"يَحُضُّ","ur":"پر","en":"to"},{"uthmani":"طَعَامِ","indopak":"عَلٰى","ur":"کھانے پر/کھانا دینے پر","en":"feed"},{"uthmani":"ٱلْمِسْكِينِ","indopak":"طَعَامِ الۡمِسۡكِيۡنِؕ‏","ur":"مسکین کے","en":"the poor"}],"tr":{"20":"And does not encourage the feeding of the poor.","97":"اور مسکین کا کھانا  دینے پر نہیں اُکساتا۔","234":"اور فقیر کو کھانا کھلانے کے لیے( لوگوں کو) ترغیب نہیں دیتا"}},{"key":"107:4","n":4,"uthmani":"فَوَيْلٌ لِّلْمُصَلِّينَ","indopak":"فَوَيۡلٌ لِّلۡمُصَلِّيۡنَۙ‏","words":[{"uthmani":"فَوَيْلٌۭ","indopak":"فَوَيۡلٌ","ur":"پس ہلاکت ہے","en":"So woe"},{"uthmani":"لِّلْمُصَلِّينَ","indopak":"لِّلۡمُصَلِّيۡنَۙ‏","ur":"نمازیوں کے لئے","en":"to those who pray"}],"tr":{"20":"So woe to those who pray","97":"پھر تباہی ہے اُن نماز پڑھنے والوں کے لیے","234":"تو ایسے نمازیوں کی خرابی ہے"}},{"key":"107:5","n":5,"uthmani":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","indopak":"الَّذِيۡنَ هُمۡ عَنۡ صَلَاتِهِمۡ سَاهُوۡنَۙ‏","words":[{"uthmani":"ٱلَّذِينَ","indopak":"الَّذِيۡنَ","ur":"وہ لوگ","en":"Those who"},{"uthmani":"هُمْ","indopak":"هُمۡ","ur":"وہ","en":"[they]"},{"uthmani":"عَن","indopak":"عَنۡ","ur":"سے","en":"about"},{"uthmani":"صَلَاتِهِمْ","indopak":"صَلَاتِهِمۡ","ur":"اپنی نمازوں (سے)","en":"their prayers"},{"uthmani":"سَاهُونَ","indopak":"سَاهُوۡنَۙ‏","ur":"بےخبر ہیں","en":"(are) neglectful"}],"tr":{"20":"[But] who are heedless of their prayer -","97":"جو اپنی نماز سے غفلت برتتے ہیں،","234":"جو نماز کی طرف سے غافل رہتے ہیں"}},{"key":"107:6","n":6,"uthmani":"ٱلَّذِينَ هُمْ يُرَآءُونَ","indopak":"الَّذِيۡنَ هُمۡ يُرَآءُوۡنَۙ‏","words":[{"uthmani":"ٱلَّذِينَ","indopak":"الَّذِيۡنَ","ur":"وہ لوگ","en":"Those who"},{"uthmani":"هُمْ","indopak":"هُمۡ","ur":"وہ","en":"[they]"},{"uthmani":"يُرَآءُونَ","indopak":"يُرَآءُوۡنَۙ‏","ur":"دکھاوا کرتے ہیں","en":"make show"}],"tr":{"20":"Those who make show [of their deeds]","97":"جو ریا کاری کرتے ہیں","234":"جو ریا کاری کرتے ہیں"}},{"key":"107:7","n":7,"uthmani":"وَيَمْنَعُونَ ٱلْمَاعُونَ","indopak":"وَيَمۡنَعُوۡنَ الۡمَاعُوۡنَ‏","words":[{"uthmani":"وَيَمْنَعُونَ","indopak":"وَيَمۡنَعُوۡنَ","ur":"اور روکتے ہیں","en":"And they deny"},{"uthmani":"ٱلْمَاعُونَ","indopak":"الۡمَاعُوۡنَ‏","ur":"برتنے کی چھوٹی سی چیز کو بھی","en":"[the] small kindnesses"}],"tr":{"20":"And withhold [simple] assistance.","97":"اور معمولی ضرورت کی چیزیں  (لوگوں کو)دینے سے گریز کرتے ہیں","234":"اور برتنے کی چیزیں عاریتہً نہیں دیتے"}}]}