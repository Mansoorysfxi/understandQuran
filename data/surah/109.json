{"id":109,"verses":[{"key":"109:1","n":1,"uthmani":" قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","indopak":"قُلۡ يٰۤاَيُّهَا الۡكٰفِرُوۡنَۙ‏","words":[{"uthmani":"قُلْ","indopak":"قُلۡ","ur":"کہہ دیجئے","en":"Say"},{"uthmani":"يَـٰٓأَيُّهَا","indopak":"يٰۤاَيُّهَا","ur":"اے","en":"O"},{"uthmani":"ٱلْكَـٰفِرُونَ","indopak":"الۡكٰفِرُوۡنَۙ‏","ur":"کافرو","en":"disbelievers"}],"tr":{"20":"Say, \"O disbelievers,","97":"کہہ دو کہ اے کافرو،","234":"(اے پیغمبر ان منکران اسلام سے) کہہ دو کہ اے کافرو!"}},{"key":"109:2","n":2,"uthmani":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","indopak":"لَاۤ اَعۡبُدُ مَا تَعۡبُدُوۡنَۙ‏","words":[{"uthmani":"لَآ","indopak":"لَاۤ","ur":"نہیں","en":"Not"},{"uthmani":"أَعْبُدُ","indopak":"اَعۡبُدُ","ur":"میں عبادت کرتا","en":"I worship"},{"uthmani":"مَا","indopak":"مَا","ur":"جس کی","en":"what"},{"uthmani":"تَعْبُدُونَ","indopak":"تَعۡبُدُوۡنَۙ‏","ur":"تم عبادت کرتے ہو","en":"you worship"}],"tr":{"20":"I do not worship what you worship.","97":"میں اُن کی عبادت نہیں کرتا جن کی عبادت تم کرتے ہو،","234":"جن (بتوں) کو تم پوچتے ہو ان کو میں نہیں پوجتا"}},{"key":"109:3","n":3,"uthmani":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","indopak":"وَلَاۤ اَنۡـتُمۡ عٰبِدُوۡنَ مَاۤ اَعۡبُدُ​ ۚ‏","words":[{"uthmani":"وَلَآ","indopak":"وَلَاۤ","ur":"اور نہ","en":"And not"},{"uthmani":"أَنتُمْ","indopak":"اَنۡـتُمۡ","ur":"تم","en":"you"},{"uthmani":"عَـٰبِدُونَ","indopak":"عٰبِدُوۡنَ","ur":"عبادت کرنے والے ہو","en":"(are) worshippers"},{"uthmani":"مَآ","indopak":"مَاۤ","ur":"جس کی","en":"(of) what"},{"uthmani":"أَعْبُدُ","indopak":"اَعۡبُدُ​ ۚ‏","ur":"میں عبادت کرتا ہوں","en":"I worship"}],"tr":{"20":"Nor are you worshippers of what I worship.","97":"اور نہ تم اُس کی عبادت کرنے والے ہو جس کی عبادت میں کرتا ہوں۔","234":"اور جس (خدا) کی میں عبادت کرتا ہوں اس کی تم عبادت نہیں کرتے"}},{"key":"109:4","n":4,"uthmani":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ","indopak":"وَلَاۤ اَنَا عَابِدٌ مَّا عَبَدۡتُّمۡۙ‏","words":[{"uthmani":"وَلَآ","indopak":"وَلَاۤ","ur":"اور نہ","en":"And not"},{"uthmani":"أَنَا۠","indopak":"اَنَا","ur":"میں","en":"I am"},{"uthmani":"عَابِدٌۭ","indopak":"عَابِدٌ","ur":"عبادت کرنے والا ہوں","en":"a worshipper"},{"uthmani":"مَّا","indopak":"مَّا","ur":"جس کی","en":"(of) what"},{"uthmani":"عَبَدتُّمْ","indopak":"عَبَدۡتُّمۡۙ‏","ur":"تم نے عبادت کی","en":"you worship"}],"tr":{"20":"Nor will I be a worshipper of what you worship.","97":"اور نہ میں اُن کی عبادت کرنے والا ہوں جن کی عبادت تم نے کی ہے","234":"اور( میں پھر کہتا ہوں کہ) جن کی تم پرستش کرتے ہوں ان کی میں پرستش کرنے والا نہیں ہوں"}},{"key":"109:5","n":5,"uthmani":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","indopak":"وَ لَاۤ اَنۡـتُمۡ عٰبِدُوۡنَ مَاۤ اَعۡبُدُ ؕ‏","words":[{"uthmani":"وَلَآ","indopak":"وَ","ur":"اور نہ","en":"And not"},{"uthmani":"أَنتُمْ","indopak":"لَاۤ","ur":"تم","en":"you"},{"uthmani":"عَـٰبِدُونَ","indopak":"اَنۡـتُمۡ","ur":"عبادت کرنے والے ہو","en":"(are) worshippers"},{"uthmani":"مَآ","indopak":"عٰبِدُوۡنَ","ur":"جس کی","en":"(of) what"},{"uthmani":"أَعْبُدُ","indopak":"مَاۤ اَعۡبُدُ ؕ‏","ur":"میں عبادت کرتا ہوں","en":"I worship"}],"tr":{"20":"Nor will you be worshippers of what I worship.","97":"اور نہ تم اُس کی عبادت کرنے والے ہو جس کی عبادت میں کرتا ہوں۔","234":"اور نہ تم اس کی بندگی کرنے والے (معلوم ہوتے) ہو جس کی میں بندگی کرتا ہوں"}},{"key":"109:6","n":6,"uthmani":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","indopak":"لَـكُمۡ دِيۡنُكُمۡ وَلِىَ دِيۡنِ‏","words":[{"uthmani":"لَكُمْ","indopak":"لَـكُمۡ","ur":"تمہارے لئے","en":"For you"},{"uthmani":"دِينُكُمْ","indopak":"دِيۡنُكُمۡ","ur":"تمہارا دین ہے","en":"(is) your religion"},{"uthmani":"وَلِىَ","indopak":"وَلِىَ","ur":"اور میرے لئے","en":"and for me"},{"uthmani":"دِينِ","indopak":"دِيۡنِ‏","ur":"میرا دین ہے","en":"(is) my religion"}],"tr":{"20":"For you is your religion, and for me is my religion.\"","97":"تمہارے لیے تمہارا دین ہے اور میرے لیے میرا دین۔","234":"تم اپنے دین پر میں اپنے دین پر"}}]}