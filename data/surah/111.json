{"id":111,"verses":[{"key":"111:1","n":1,"uthmani":" تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ","indopak":"تَبَّتۡ يَدَاۤ اَبِىۡ لَهَبٍ وَّتَبَّؕ‏","words":[{"uthmani":"تَبَّتْ","indopak":"تَبَّتۡ","ur":"ٹوٹ گئے","en":"Perish"},{"uthmani":"يَدَآ","indopak":"يَدَاۤ","ur":"دونوں ہاتھ","en":"(the) hands"},{"uthmani":"أَبِى","indopak":"اَبِىۡ","ur":"ابو","en":"(of) Abu"},{"uthmani":"لَهَبٍۢ","indopak":"لَهَبٍ","ur":"لہب کے","en":"Lahab"},{"uthmani":"وَتَبَّ","indopak":"وَّتَبَّؕ‏","ur":"اور وہ ہلاک ہوا","en":"and perish he"}],"tr":{"20":"May the hands of Abū Lahab be ruined, and ruined is he.","97":"ٹوٹ گئے ابو لہب کے ہاتھ اور نامراد ہوگیا وہ۔","234":"ابولہب کے ہاتھ ٹوٹیں اور وہ ہلاک ہو"}},{"key":"111:2","n":2,"uthmani":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","indopak":"مَاۤ اَغۡنٰى عَنۡهُ مَالُهٗ وَمَا كَسَبَؕ‏","words":[{"uthmani":"مَآ","indopak":"مَاۤ","ur":"نہ","en":"Not"},{"uthmani":"أَغْنَىٰ","indopak":"اَغۡنٰى","ur":"کام آیا","en":"(will) avail"},{"uthmani":"عَنْهُ","indopak":"عَنۡهُ","ur":"اس کو","en":"him"},{"uthmani":"مَالُهُۥ","indopak":"مَالُهٗ","ur":"اس کا مال","en":"his wealth"},{"uthmani":"وَمَا","indopak":"وَمَا","ur":"اور جو","en":"and what"},{"uthmani":"كَسَبَ","indopak":"كَسَبَؕ‏","ur":"اس نے کمایا","en":"he earned"}],"tr":{"20":"His wealth will not avail him or that which he gained.","97":"اُس کا مال اور جو کچھ اس نے کمایا وہ اُس کے کسی کام نہ آیا۔","234":"نہ تو اس کا مال ہی اس کے کچھ کام آیا اور نہ وہ جو اس نے کمایا"}},{"key":"111:3","n":3,"uthmani":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ","indopak":"سَيَصۡلٰى نَارًا ذَاتَ لَهَبٍ ۖۚ‏","words":[{"uthmani":"سَيَصْلَىٰ","indopak":"سَيَصۡلٰى","ur":"عنقریب وہ داخل ہوگا","en":"He will be burnt"},{"uthmani":"نَارًۭا","indopak":"نَارًا","ur":"آگ میں","en":"(in) a Fire"},{"uthmani":"ذَاتَ","indopak":"ذَاتَ","ur":"والی","en":"of"},{"uthmani":"لَهَبٍۢ","indopak":"لَهَبٍ ۖۚ‏","ur":"شعلے (والی)","en":"Blazing Flames"}],"tr":{"20":"He will [enter to] burn in a Fire of [blazing] flame","97":"ضرور وہ شعلہ زن آگ میں ڈالا جائے گا","234":"وہ جلد بھڑکتی ہوئی آگ میں داخل ہو گا"}},{"key":"111:4","n":4,"uthmani":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","indopak":"وَّامۡرَاَ تُهٗ ؕ حَمَّالَةَ الۡحَطَبِ​ۚ‏","words":[{"uthmani":"وَٱمْرَأَتُهُۥ","indopak":"وَّامۡرَاَ تُهٗ ؕ","ur":"اور اس کی بیوی","en":"And his wife"},{"uthmani":"حَمَّالَةَ","indopak":"حَمَّالَةَ","ur":"اٹھانے والی","en":"(the) carrier"},{"uthmani":"ٱلْحَطَبِ","indopak":"الۡحَطَبِ​ۚ‏","ur":"لکڑی کے گٹھے کو","en":"(of) firewood"}],"tr":{"20":"And his wife [as well] - the carrier of firewood.","97":"اور (اُس کے ساتھ) اُس کی جورُو بھی،  لگائی بُجھائی کرنے والی،","234":"اور اس کی جورو بھی جو ایندھن سر پر اٹھائے پھرتی ہے"}},{"key":"111:5","n":5,"uthmani":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ","indopak":"فِىۡ جِيۡدِهَا حَبۡلٌ مِّنۡ مَّسَدٍ‏","words":[{"uthmani":"فِى","indopak":"فِىۡ","ur":"میں","en":"In"},{"uthmani":"جِيدِهَا","indopak":"جِيۡدِهَا","ur":"اس کی گردن میں ہوگی","en":"her neck"},{"uthmani":"حَبْلٌۭ","indopak":"حَبۡلٌ","ur":"رسی","en":"(will be) a rope"},{"uthmani":"مِّن","indopak":"مِّنۡ","ur":"کی","en":"of"},{"uthmani":"مَّسَدٍۭ","indopak":"مَّسَدٍ‏","ur":"مونجھ کی","en":"palm-fiber"}],"tr":{"20":"Around her neck is a rope of [twisted] fiber.","97":"اُس کی گردن میں مونجھ کی رسّی ہو گی۔","234":"اس کے گلے میں مونج کی رسّی ہو گی"}}]}