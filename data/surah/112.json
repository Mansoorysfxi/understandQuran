{"id":112,"verses":[{"key":"112:1","n":1,"uthmani":" قُلْ هُوَ ٱللَّهُ أَحَدٌ","indopak":"قُلۡ هُوَ اللّٰهُ اَحَدٌ​ ۚ‏","words":[{"uthmani":"قُلْ","indopak":"قُلۡ","ur":"کہہ دیجئے","en":"Say"},{"uthmani":"هُوَ","indopak":"هُوَ","ur":"وہ","en":"He"},{"uthmani":"ٱللَّهُ","indopak":"اللّٰهُ","ur":"اللہ","en":"(is) Allah"},{"uthmani":"أَحَدٌ","indopak":"اَحَدٌ​ ۚ‏","ur":"ایک ہے","en":"the One"}],"tr":{"20":"Say, \"He is Allāh, [who is] One,","97":"کہو،  وہ اللہ ہے،  یَکتا۔","234":"کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے"}},{"key":"112:2","n":2,"uthmani":"ٱللَّهُ ٱلصَّمَدُ","indopak":"اَللّٰهُ الصَّمَدُ​ ۚ‏","words":[{"uthmani":"ٱللَّهُ","indopak":"اَللّٰهُ","ur":"اللہ","en":"Allah"},{"uthmani":"ٱلصَّمَدُ","indopak":"الصَّمَدُ​ ۚ‏","ur":"بےنیاز ہے","en":"the Eternal, the Absolute"}],"tr":{"20":"Allāh, the Eternal Refuge.","97":"اللہ سب سے بے نیاز ہے اور سب اس کے محتاج ہیں۔","234":"معبود برحق جو بےنیاز ہے"}},{"key":"112:3","n":3,"uthmani":"لَمْ يَلِدْ وَلَمْ يُولَدْ","indopak":"لَمۡ يَلِدۡ   ۙ وَلَمۡ يُوۡلَدۡ ۙ‏","words":[{"uthmani":"لَمْ","indopak":"لَمۡ","ur":"نہ","en":"Not"},{"uthmani":"يَلِدْ","indopak":"يَلِدۡ   ۙ","ur":"اس نے جنا","en":"He begets"},{"uthmani":"وَلَمْ","indopak":"وَلَمۡ","ur":"اور نہ","en":"and not"},{"uthmani":"يُولَدْ","indopak":"يُوۡلَدۡ ۙ‏","ur":"وہ جنا گیا","en":"He is begotten"}],"tr":{"20":"He neither begets nor is born,","97":"نہ اس کی کوئی اولاد ہے اور نہ وہ کسی کی اولاد۔","234":"نہ کسی کا باپ ہے اور نہ کسی کا بیٹا"}},{"key":"112:4","n":4,"uthmani":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","indopak":"وَلَمۡ يَكُنۡ لَّهٗ كُفُوًا اَحَدٌ‏","words":[{"uthmani":"وَلَمْ","indopak":"وَلَمۡ","ur":"اور نہیں","en":"And not"},{"uthmani":"يَكُن","indopak":"يَكُنۡ","ur":"ہے","en":"is"},{"uthmani":"لَّهُۥ","indopak":"لَّهٗ","ur":"اس کے لئے","en":"for Him"},{"uthmani":"كُفُوًا","indopak":"كُفُوًا","ur":"برابر کا","en":"equivalent"},{"uthmani":"أَحَدٌۢ","indopak":"اَحَدٌ‏","ur":"کوئی ایک بھی","en":"any [one]"}],"tr":{"20":"Nor is there to Him any equivalent.\"","97":"اور کوئی اُس کا ہمسر نہیں ہے۔","234":"اور کوئی اس کا ہمسر نہیں"}}]}