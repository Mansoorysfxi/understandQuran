{"id":114,"verses":[{"key":"114:1","n":1,"uthmani":" قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","indopak":"قُلۡ اَعُوۡذُ بِرَبِّ النَّاسِۙ‏","words":[{"uthmani":"قُلْ","indopak":"قُلۡ","ur":"کہہ دیجئے","en":"Say"},{"uthmani":"أَعُوذُ","indopak":"اَعُوۡذُ","ur":"میں پناہ چاہتا ہوں","en":"I seek refuge"},{"uthmani":"بِرَبِّ","indopak":"بِرَبِّ","ur":"رب کی","en":"in (the) Lord"},{"uthmani":"ٱلنَّاسِ","indopak":"النَّاسِۙ‏","ur":"انسانوں کے","en":"(of) mankind"}],"tr":{"20":"Say, \"I seek refuge in the Lord of mankind,","97":"کہو، میں پناہ مانگتا ہوں انسانوں کے رب","234":"کہو کہ میں لوگوں کے پروردگار کی پناہ مانگتا ہوں"}},{"key":"114:2","n":2,"uthmani":"مَلِكِ ٱلنَّاسِ","indopak":"مَلِكِ النَّاسِۙ‏","words":[{"uthmani":"مَلِكِ","indopak":"مَلِكِ","ur":"بادشاہ","en":"(The) King"},{"uthmani":"ٱلنَّاسِ","indopak":"النَّاسِۙ‏","ur":"انسانوں کے","en":"(of) mankind"}],"tr":{"20":"The Sovereign of mankind,","97":"انسانوں کے بادشاہ","234":"(یعنی) لوگوں کے حقیقی بادشاہ کی"}},{"key":"114:3","n":3,"uthmani":"إِلَـٰهِ ٱلنَّاسِ","indopak":"اِلٰهِ النَّاسِۙ‏","words":[{"uthmani":"إِلَـٰهِ","indopak":"اِلٰهِ","ur":"الٰہ کی/معبود کی","en":"(The) God"},{"uthmani":"ٱلنَّاسِ","indopak":"النَّاسِۙ‏","ur":"انسانوں کے","en":"(of) mankind"}],"tr":{"20":"The God of mankind,","97":"انسانوں کے حقیقی معبُود کی","234":"لوگوں کے معبود برحق کی"}},{"key":"114:4","n":4,"uthmani":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","indopak":"مِنۡ شَرِّ الۡوَسۡوَاسِ  ۙ الۡخَـنَّاسِ ۙ‏","words":[{"uthmani":"مِن","indopak":"مِنۡ","ur":"سے","en":"From"},{"uthmani":"شَرِّ","indopak":"شَرِّ","ur":"شر","en":"(the) evil"},{"uthmani":"ٱلْوَسْوَاسِ","indopak":"الۡوَسۡوَاسِ  ۙ","ur":"وسوسہ ڈالنے والے","en":"(of) the whisperer"},{"uthmani":"ٱلْخَنَّاسِ","indopak":"الۡخَـنَّاسِ ۙ‏","ur":"بار بار پلٹ کر آنے والے کے","en":"the one who withdraws"}],"tr":{"20":"From the evil of the retreating whisperer -","97":"اُس وسوسہ ڈالنے والے کے شر سے جو بار بار پلٹ کر آتا ہے،","234":"(شیطان) وسوسہ انداز کی برائی سے جو (خدا کا نام سن کر) پیچھے ہٹ جاتا ہے"}},{"key":"114:5","n":5,"uthmani":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","indopak":"الَّذِىۡ يُوَسۡوِسُ فِىۡ صُدُوۡرِ النَّاسِۙ‏","words":[{"uthmani":"ٱلَّذِى","indopak":"الَّذِىۡ","ur":"وہ جو","en":"The one who"},{"uthmani":"يُوَسْوِسُ","indopak":"يُوَسۡوِسُ","ur":"وسوسہ ڈالتا ہے","en":"whispers"},{"uthmani":"فِى","indopak":"فِىۡ","ur":"میں","en":"in"},{"uthmani":"صُدُورِ","indopak":"صُدُوۡرِ","ur":"سینوں","en":"(the) breasts"},{"uthmani":"ٱلنَّاسِ","indopak":"النَّاسِۙ‏","ur":"انسانوں کے","en":"(of) mankind"}],"tr":{"20":"Who whispers [evil] into the breasts of mankind -","97":"جو لوگوں کے دلوں میں وسوسے ڈالتا ہے","234":"جو لوگوں کے دلوں میں وسوسے ڈالتا ہے"}},{"key":"114:6","n":6,"uthmani":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","indopak":"مِنَ الۡجِنَّةِ وَالنَّاسِ‏","words":[{"uthmani":"مِنَ","indopak":"مِنَ","ur":"سے","en":"From"},{"uthmani":"ٱلْجِنَّةِ","indopak":"الۡجِنَّةِ","ur":"جنوں میں","en":"the jinn"},{"uthmani":"وَٱلنَّاسِ","indopak":"وَالنَّاسِ‏","ur":"اور انسانوں میں","en":"and men"}],"tr":{"20":"From among the jinn and mankind\".","97":"خواہ وہ جِنّوں میں سے ہو یا انسانوں میں سے۔","234":"وہ جنّات میں سے (ہو) یا انسانوں میں سے"}}]}